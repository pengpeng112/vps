   1: #!/bin/sh
   2: # self-heal.sh v3 - safe version (2026-10-30, Codex audited + field tested)
   3: # Runs from cron every minute. Only restarts dead services, never reboots.
   4: # v3 changes (field test on R4):
   5: #   - port-based detection instead of ps grep (ps unreliable on this BusyBox)
   6: #   - mihomo: check port 9090 API responding
   7: #   - agent: check port 18443 management responding (tunnel alive = agent alive)
   8: # v2 changes (Codex review):
   9: #   - removed auto-reboot (midnight cron is the fallback)
  10: #   - removed tunnel restart (preserves rssh rescue channel)
  11: #   - mkdir-based atomic lock
  12: #   - 300s cooldown per service (prevents crash-restart loops)
  13: #   - suppress during maintenance window (touch /tmp/selfheal.pause)
  14: 
  15: # Maintenance suppression
  16: [ -f /tmp/selfheal.pause ] && exit 0
  17: 
  18: # Atomic lock via mkdir
  19: LOCK=/tmp/selfheal.lock.d
  20: mkdir "$LOCK" 2>/dev/null || {
  21:     _now=$(date +%s)
  22:     _created=$(cat "$LOCK/ts" 2>/dev/null || echo 0)
  23:     _diff=$((_now - _created))
  24:     [ "$_diff" -lt 180 ] && exit 0
  25:     rm -rf "$LOCK"
  26:     mkdir "$LOCK" 2>/dev/null || exit 0
  27: }
  28: echo "$(date +%s)" > "$LOCK/ts"
  29: trap 'rm -rf "$LOCK"' EXIT
  30: 
  31: # 1) mihomo dead? Check API port 9090 responding (not ps grep)
  32: if ! curl -s -m 3 -o /dev/null -w '' http://127.0.0.1:9090/version 2>/dev/null; then
  33:     _cd=/tmp/selfheal.mihomo.cd
  34:     _now=$(date +%s)
  35:     _last=$(cat $_cd 2>/dev/null || echo 0)
  36:     if [ $(($_now - _last)) -ge 300 ]; then
  37:         echo $_now > $_cd
  38:         logger -t self-heal "mihomo API not responding, restarting"
  39:         /etc/init.d/mihomo restart 2>/dev/null
  40:     fi
  41: fi
  42: 
  43: # 2) agent dead? Dual check: process alive + port responding
  44: #    Codex fix: port alone is unreliable (tunnel up but agent dead = port responds)
  45: _agent_dead=0
  46: if [ -z "$(pidof routermgmt-agent 2>/dev/null)" ]; then
  47:     _agent_dead=1
  48:     _reason="process dead"
  49: elif ! curl -sk -m 3 -o /dev/null https://127.0.0.1:18443/api/v1/health 2>/dev/null; then
  50:     _agent_dead=1
  51:     _reason="mgmt port not responding"
  52: fi
  53: if [ "$_agent_dead" = "1" ]; then
  54:     _cd=/tmp/selfheal.agent.cd
  55:     _now=$(date +%s)
  56:     _last=$(cat $_cd 2>/dev/null || echo 0)
  57:     if [ $(($_now - _last)) -ge 300 ]; then
  58:         echo $_now > $_cd
  59:         logger -t self-heal "agent ${_reason}, restarting"
  60:         /etc/init.d/routermgmt restart 2>/dev/null
  61:     fi
  62: fi
  63: 
  64: # NOTE: No tunnel restart (preserves rssh rescue channel).
  65: # No auto-reboot (midnight 00:00 cron is the fallback).
  66: 
  67: exit 0
   1: #!/bin/sh
   2: # All-endpoint recovery; never signals reverse SSH (rssh/rssh2), WAN, or sshd.
   3: # Discovery starts this before its failure return. Duplicate calls are rate-limited.
   4: STATE=${RM_WD_STATE_DIR:-/tmp}
   5: LOG=${RM_WD_LOG:-/etc/routermgmt/logs/tunnelwd.log}
   6: LOCK="$STATE/tunnelwd.lock"
   7: CNT="$STATE/tunnelwd.fails"
   8: SAMPLE="$STATE/tunnelwd.sample"
   9: REPAIR="$STATE/tunnelwd.repair"
  10: mkdir -p "$STATE" "$(dirname "$LOG")"
  11: if ! mkdir "$LOCK" 2>/dev/null; then
  12:     _pid=$(cat "$LOCK/pid" 2>/dev/null)
  13:     case "$_pid" in ''|*[!0-9]*) exit 0 ;; esac
  14:     kill -0 "$_pid" 2>/dev/null && exit 0
  15:     rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || exit 0
  16:     mkdir "$LOCK" 2>/dev/null || exit 0
  17: fi
  18: echo $$ > "$LOCK/pid"
  19: trap 'rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null' EXIT
  20: trap 'exit 0' HUP INT TERM
  21: number() { case "$1" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }
  22: NOW=$(date +%s)
  23: LAST=$(number "$(cat "$SAMPLE" 2>/dev/null)")
  24: [ "$NOW" -ge "$LAST" ] && [ $((NOW - LAST)) -lt 60 ] && exit 0
  25: echo "$NOW" > "$SAMPLE"
  26: for PORT in 18443 18444 18445 18446 18447; do
  27:     if curl -fsk -m 4 -o /dev/null "https://127.0.0.1:$PORT/api/v1/health" 2>/dev/null; then
  28:         rm -f "$CNT"
  29:         exit 0
  30:     fi
  31: done
  32: N=$(number "$(cat "$CNT" 2>/dev/null)")
  33: N=$((N + 1)); echo "$N" > "$CNT"
  34: echo "$(date '+%F %T') all management health checks failed sample=$N" >> "$LOG"
  35: if [ "$(wc -l < "$LOG")" -gt 500 ]; then
  36:     tail -n 400 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  37: fi
  38: [ "$N" -ge 3 ] || exit 0
  39: LAST=$(number "$(cat "$REPAIR" 2>/dev/null)")
  40: [ "$NOW" -ge "$LAST" ] && [ $((NOW - LAST)) -lt 600 ] && exit 0
  41: echo "$NOW" > "$REPAIR"
  42: # Signal only -L instances. Unsupported ubus leaves connections untouched;
  43: # never fall back to restarting the entire service.
  44: for INSTANCE in mgmt mgmt2 mgmt3 mgmt4 mgmt5; do
  45:     ubus call service signal "{\"name\":\"mgmt-tunnel\",\"instance\":\"$INSTANCE\",\"signal\":15}" >/dev/null 2>&1 || true
  46: done
  47: logger -t tunnel-wd "rechecked all failed management legs; reverse SSH preserved"
  48: echo "$(date '+%F %T') signaled management instances only; rssh/rssh2 untouched" >> "$LOG"
  49: exit 0
