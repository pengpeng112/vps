 173: // renderVLESS vless-reality 节点参数校验与出站段渲染。
 174: func renderVLESS(n *NodeRender, proxies *[]string) error {
 175: 	if !crypto.ValidUUID(n.UUID) {
 176: 		return fmt.Errorf("节点 %s uuid 参数不合法", n.Name)
 177: 	}
 178: 	if !crypto.ValidPBK(n.PBK) {
 179: 		return fmt.Errorf("节点 %s pbk 参数不合法", n.Name)
 180: 	}
 181: 	if !crypto.ValidSID(n.SID) {
 182: 		return fmt.Errorf("节点 %s sid 参数不合法", n.Name)
 183: 	}
 184: 	sni := n.SNI
 185: 	if sni == "" {
 186: 		sni = "www.microsoft.com"
 187: 	}
 188: 	flow := n.Flow
 189: 	if flow == "" {
 190: 		flow = "xtls-rprx-vision"
 191: 	}
 192: 	fp := n.FP
 193: 	if fp == "" {
 194: 		fp = "chrome"
 195: 	}
 196: 	*proxies = append(*proxies, fmt.Sprintf(`  - name: "%s"
 197:     type: vless
 198:     server: %s
 199:     port: %d
 200:     uuid: %s
 201:     network: tcp
 202:     udp: true
 203:     tls: true
 204:     flow: %s
 205:     servername: %s
 206:     client-fingerprint: %s
 207:     reality-opts:
 208:       public-key: %s
 209:       short-id: %s`, n.Name, n.Host, n.Port, n.UUID, flow, sni, fp, n.PBK, n.SID))
 210: 	return nil
 211: }
 212: 
 213: var reSecretLine = regexp.MustCompile(`^(\s+(?:uuid|password|public-key|short-id): )(\S+)$`)
 214: 
 215: // MaskYAML 将渲染结果中的凭据行掩码（uuid/pbk 前后 4 位，sid/password 前后 2 位）。
 216: // 仅用于管理端预览/详情展示；原始 YAML 只允许设备经 HMAC/token 下载。
 217: func MaskYAML(yamlBytes []byte) string {
 218: 	lines := strings.Split(string(yamlBytes), "\n")
 219: 	for i, line := range lines {
 220: 		m := reSecretLine.FindStringSubmatch(line)
 221: 		if m == nil {
 222: 			continue
 223: 		}
 224: 		key := strings.TrimSpace(strings.SplitN(m[1], ":", 2)[0])
 225: 		lines[i] = m[1] + crypto.MaskNodeParam(key, m[2])
 226: 	}
 227: 	return strings.Join(lines, "\n")
 228: }
