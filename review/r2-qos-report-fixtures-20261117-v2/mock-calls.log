tc qdisc del dev wan root
curl --noproxy * -sS -m 10 -X PUT -H Content-Type: application/json --data {"name":"NODE-PICK"} -o /dev/null -w %{http_code} http://127.0.0.1:9090/proxies/US-MEDIA
tc qdisc del dev wan root
tc qdisc add dev wan root handle 1: htb default 30
tc class add dev wan parent 1: classid 1:10 htb rate 60kbit ceil 60kbit
tc filter add dev wan parent 1: protocol ip u32 match ip dst 154.36.139.155/32 flowid 1:10
tc filter add dev wan parent 1: protocol ip u32 match ip dst 74.82.193.113/32 flowid 1:10
curl --noproxy * -sS -m 10 -X PUT -H Content-Type: application/json --data {"name":"BULK-LAX-GIA-01"} -o /dev/null -w %{http_code} http://127.0.0.1:9090/proxies/US-MEDIA
