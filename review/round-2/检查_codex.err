   1: #!/bin/sh
   2: # onboot-hooks — SN-R 舰队开机幂等钩子（2026-10-08 定稿，R1/R2/R4 事故沉淀）
   3: # 职责：厂商开机重写 crontab 后自动恢复四条关键任务 + 强制 QUIC 拦截规则顺序。
   4: # 背景：
   5: #   - 厂商固件每次开机重写 crontab（netprobe/discovery 曾整批丢失，R4 实测）
   6: #   - mihomo 的 QUIC DROP 若排在自管 REJECT 之前，浏览器 QUIC 被静默吞包
   7: #     导致"视频打不开"（2026-10-04 R2 事故：DROP 166 包、REJECT 0）
   8: # 部署：/etc/routermgmt/onboot-hooks.sh + rc.local 在 exit 0 前调用本脚本。
   9: ( sleep 20
  10:   CT=/etc/crontabs/root
  11:   mkdir -p /etc/crontabs; touch "$CT"
  12:   for E in \
  13:     '*/5 * * * * /etc/routermgmt/netprobe.sh #routermgmt-netprobe' \
  14:     '* * * * * /etc/routermgmt/mgmt-port-discovery.sh #mgmt-port' \
  15:     '*/5 * * * * /etc/routermgmt/connlog.sh #routermgmt-connlog' \
  16:     '0 0 * * * /sbin/reboot #routermgmt-reboot'; do
  17:     TAG=$(echo "$E" | sed 's/.*#\([^ ]*\).*$/#\1/')
  18:     grep -q "$TAG" "$CT" 2>/dev/null || echo "$E" >> "$CT"
  19:   done
  20:   /etc/init.d/cron restart
  21:   # QUIC 拦截：REJECT 必须先于任何 DROP（浏览器被拒后立即回落 TCP，不傻等）
  22:   iptables -D FORWARD -i br-lan -p udp -m udp --dport 443 -j REJECT --reject-with icmp-port-unreachable 2>/dev/null
  23:   iptables -I FORWARD 1 -i br-lan -p udp -m udp --dport 443 -j REJECT --reject-with icmp-port-unreachable
  24: ) > /dev/null 2>&1 &
  25: exit 0
