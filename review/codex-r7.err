	if req.Priority != nil {
		updates["priority"] = *req.Priority
	}
	if req.Enabled != nil {
		updates["enabled"] = *req.Enabled
	}
	if name != n.Name || host != n.Host || port != n.Port {
		if err := validateNodeBase(name, host, port); err != nil {
			fail422(c, err.Error())
			return
		}
	}
	if req.Params != nil {
		cur := s.decryptNodeParams(&n)
		merged := nodeParams{UUID: cur.UUID, PBK: cur.PBK, SNI: cur.SNI, SID: cur.SID, Flow: cur.Flow, FP: cur.FP, Password: cur.Password}
		// 掩码值写回一律拒绝；空串 = 保留原值
		for field, v := range map[string]string{
			"uuid": req.Params.UUID, "pbk": req.Params.PBK, "sid": req.Params.SID,
			"sni": req.Params.SNI, "flow": req.Params.Flow, "fp": req.Params.FP,
			"password": req.Params.Password,
		} {
			if stringsContains(v, "...") || v == "****" {
				fail422(c, fmt.Sprintf("参数 %s 是掩码值，禁止写回；如需修改请提供完整新值", field))
				return
			}
		}
		if req.Params.UUID != "" {
			merged.UUID = req.Params.UUID
		}
		if req.Params.PBK != "" {
			merged.PBK = req.Params.PBK
		}
		if req.Params.SID != "" {
			merged.SID = req.Params.SID
		}
		if req.Params.SNI != "" {
			merged.SNI = req.Params.SNI
		}
		if req.Params.Flow != "" {
			merged.Flow = req.Params.Flow
		}
		if req.Params.FP != "" {
			merged.FP = req.Params.FP
		}
		if req.Params.Password != "" {
			merged.Password = req.Params.Password
		}
		if err := merged.validateForProto(n.Proto); err != nil {
			fail422(c, err.Error())
			return
		}
		raw, _ := json.Marshal(merged)
		enc, err := crypto.Encrypt(s.MasterKey, raw, fmt.Sprintf("nodes:%d:proto_params", n.ID))
		if err != nil {
			fail500(c, "加密失败")
			return
		}
		updates["proto_params_enc"] = enc
	}
	if len(updates) == 0 {
		c.JSON(http.StatusOK, s.nodeToDTO(&n))
		return
	}
	if err := s.DB.Model(&n).Updates(updates).Error; err != nil {
		fail409(c, "更新失败（节点名冲突？）")
		return
	}
	s.audit(c, "admin", a.Username, "node_update", fmt.Sprintf("node:%d", n.ID), gin.H{"fields": keysOf(updates)})
	var fresh models.Node
	s.DB.First(&fresh, n.ID)
	c.JSON(http.StatusOK, s.nodeToDTO(&fresh))
}

func stringsContains(s, sub string) bool {
	return len(s) >= len(sub) && (s == sub || len(sub) == 0 || indexOfStr(s, sub) >= 0)
}

func indexOfStr(s, sub string) int {
	for i := 0; i+len(sub) <= len(s); i++ {
		if s[i:i+len(sub)] == sub {
			return i
		}
	}
	return -1
}

func keysOf(m map[string]any) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	return out
}

// handleNodeDelete 被绑定或被设备当前节点引用时返回 409（§9）。
func (s *Server) handleNodeDelete(c *gin.Context) {
	a := adminFrom(c)
	id := c.Param("id")
	err := s.DB.Transaction(func(tx *gorm.DB) error {
		var n models.Node
		if err := tx.Where("id=?", id).First(&n).Error; err != nil {
			return errNotFound
		}
		var bound int64
		tx.Model(&models.NodeAssignment{}).Where("node_id=?", id).Count(&bound)
		if bound > 0 {
			return errNodeInUse
		}
		var active int64
		tx.Raw(`SELECT COUNT(*) FROM devices WHERE current_node_id=?`, id).Scan(&active)
		if active > 0 {
			return errNodeInUse
		}
		if err := tx.Delete(&n).Error; err != nil {
			return err
		}
		return auditTx(tx, "admin", a.Username, "node_delete", fmt.Sprintf("node:%s", id), gin.H{"name": n.Name})
	})
	if err != nil {
		switch err {
		case errNotFound:
			fail404(c, "节点不存在")
		case errNodeInUse:
			fail409(c, "节点被设备绑定或正在使用，先解绑再删除")
		default:
			fail500(c, "删除失败")
		}
		return
	}
	c.JSON(http.StatusOK, gin.H{"ok": true})
}

var errNodeInUse = fmt.Errorf("node in use")

// handleNodeProbe TCP 探测（超时 3s）；探测类型明确为 TCP 可达，不代表 Reality 鉴权可用（§19.3）。
func (s *Server) handleNodeProbe(c *gin.Context) {
	var n models.Node
	if err := s.DB.Where("id=?", c.Param("id")).First(&n).Error; err != nil {
		fail404(c, "节点不存在")
		return
	}
	addr := net.JoinHostPort(n.Host, fmt.Sprintf("%d", n.Port))
	start := time.Now()
	conn, err := net.DialTimeout("tcp", addr, 3*time.Second)
	latency := time.Since(start).Milliseconds()
	status := "up"
	if err != nil {
		status = "down"
		latency = -1
	} else {
		conn.Close()
	}
	now := time.Now().UTC()
	var latPtr *int64
	if status == "up" {
		latPtr = &latency
	}
	s.DB.Model(&n).Updates(map[string]any{"health_status": status, "last_check_at": now, "last_latency_ms": latPtr})
	c.JSON(http.StatusOK, gin.H{
		"id": n.ID, "name": n.Name, "probe_type": "tcp_connect",
		"health_status": status, "latency_ms": latPtr, "checked_at": now,
		"note": "TCP 可达不代表 Reality 鉴权或代理出口可用",
	})
}

// ---- 绑定 ----

type assignmentResult struct {
	DeviceID string `json:"device_id"`
	OK       bool   `json:"ok"`
	Error    string `json:"error,omitempty"`
	TaskID   string `json:"task_id,omitempty"`
	Version  int64  `json:"version,omitempty"`
}

// handleAssignmentsBatch 批量绑定：默认只更新期望绑定；apply=true 才发布配置并生成任务，
// 响应逐台列明结果，不假装全成功（§19.3）。
func (s *Server) handleAssignmentsBatch(c *gin.Context) {
	a := adminFrom(c)
	var req struct {
		DeviceIDs []string `json:"device_ids" binding:"required"`
		NodeID    int64    `json:"node_id" binding:"required"`
		IsPrimary bool     `json:"is_primary"`
		Apply     bool     `json:"apply"`
	}
	if err := c.ShouldBindJSON(&req); err != nil {
		fail422(c, "device_ids 与 node_id 必填")
		return
	}
	var node models.Node
	if err := s.DB.Where("id=?", req.NodeID).First(&node).Error; err != nil {
		fail404(c, "节点不存在")
		return
	}
	if !node.Enabled {
		fail409(c, "节点已停用，不能绑定")
		return
	}
	results := make([]assignmentResult, 0, len(req.DeviceIDs))
	for _, deviceID := range req.DeviceIDs {
		r := assignmentResult{DeviceID: deviceID, OK: true}
		err := s.DB.Transaction(func(tx *gorm.DB) error {
			var dev models.Device
			if err := tx.Where("id=?", deviceID).First(&dev).Error; err != nil {
				r.Error, r.OK = "设备不存在", false
				return nil
			}
			if dev.LifecycleStatus != models.LifecycleApproved {
				r.Error, r.OK = "设备不是 approved 状态", false
				return nil
			}
type deviceDTO struct {
	ID                    string     `json:"id"`
	Name                  string     `json:"name"`
	GroupID               *int64     `json:"group_id"`
	GroupName             string     `json:"group_name,omitempty"`
	WGIp                  string     `json:"wg_ip"`
	HWModel               string     `json:"hw_model"`
	FirmwareVer           string     `json:"firmware_ver"`
	MacAddr               string     `json:"mac_addr"`
	LocationNote          string     `json:"location_note"`
	LifecycleStatus       string     `json:"lifecycle_status"`
	Online                bool       `json:"online"`
	LastHeartbeatAt       *time.Time `json:"last_heartbeat_at"`
	CurrentNodeID         *int64     `json:"current_node_id"`
	CurrentNodeName       string     `json:"current_node_name,omitempty"`
	CurrentExitIP         string     `json:"current_exit_ip"`
	DesiredConfigVersion  int64      `json:"desired_config_version"`
	CurrentConfigVersion  int64      `json:"current_config_version"`
	HighestAcceptedVersion int64     `json:"highest_accepted_version"`
	VpsLimitKbps          int        `json:"vps_limit_kbps"`
	RebootCron            string     `json:"reboot_cron"`
	LicenseEnabled        bool       `json:"license_enabled"`
	LicenseExpiresAt      *time.Time `json:"license_expires_at"`
	ServiceActive         bool       `json:"service_active"`
	ProxyMode             string     `json:"proxy_mode"`
	AccessMode            string     `json:"access_mode"`
	AccessList            string     `json:"access_list"`
	FirstOnlineAt         *time.Time `json:"first_online_at"`
	LicenseStartedAt      *time.Time `json:"license_started_at"`
	LicenseDaysLeft       *int       `json:"license_days_left"`
	RemoteSSHAlive        *bool      `json:"remote_ssh_alive"`
	LastRemoteSSHCheckAt  *time.Time `json:"last_remote_ssh_check_at"`
	CreatedAt             time.Time  `json:"created_at"`
}

// 不返回 enc / 凭据字段（§9）
func (s *Server) deviceToDTO(dev *models.Device, nodeName, groupName string) deviceDTO {
	return deviceDTO{
		ID: dev.ID, Name: dev.Name, GroupID: dev.GroupID, GroupName: groupName,
		WGIp: dev.WGIp, HWModel: dev.HWModel, FirmwareVer: dev.FirmwareVer,
		MacAddr: dev.MacAddr, LocationNote: dev.LocationNote, LifecycleStatus: dev.LifecycleStatus,
		Online: s.isOnline(dev), LastHeartbeatAt: dev.LastHeartbeatAt,
		CurrentNodeID: dev.CurrentNodeID, CurrentNodeName: nodeName,
		CurrentExitIP: dev.CurrentExitIP,
		DesiredConfigVersion: dev.DesiredConfigVersion, CurrentConfigVersion: dev.CurrentConfigVersion,
		HighestAcceptedVersion: dev.HighestAcceptedVersion,
		VpsLimitKbps: dev.VpsLimitKbps, RebootCron: dev.RebootCron,
		LicenseEnabled: dev.LicenseEnabled, LicenseExpiresAt: dev.LicenseExpiresAt,
		ServiceActive: deviceServiceActive(dev, time.Now().UTC()),
		ProxyMode: orDefault(dev.ProxyMode, "rule"), AccessMode: orDefault(dev.AccessMode, "all"),
		AccessList: dev.AccessList,
		FirstOnlineAt: dev.FirstOnlineAt, LicenseStartedAt: dev.LicenseStartedAt,
		LicenseDaysLeft: licenseDaysLeft(dev, time.Now().UTC()),
		RemoteSSHAlive: dev.RemoteSSHAlive, LastRemoteSSHCheckAt: dev.LastRemoteSSHCheckAt,
		CreatedAt: dev.CreatedAt,
	}
}

func (s *Server) handleDeviceList(c *gin.Context) {
	page, size, offset := pageArgs(c)
	q := s.DB.Model(&models.Device{})
	if v := c.Query("group_id"); v != "" {
		q = q.Where("group_id = ?", v)
	}
	if v := c.Query("status"); v != "" {
		cutoff := time.Now().UTC().Add(-s.Cfg.HeartbeatTimeout)
		switch v {
		case "online":
			q = q.Where("lifecycle_status='approved' AND last_heartbeat_at > ?", cutoff)
		case "offline":
			q = q.Where("lifecycle_status='approved' AND (last_heartbeat_at IS NULL OR last_heartbeat_at <= ?)", cutoff)
		case "pending":
			q = q.Where("lifecycle_status='pending'")
		case "revoked":
			q = q.Where("lifecycle_status='revoked'")
		}
	}
	var total int64
	q.Count(&total)
	var devices []models.Device
	if err := q.Order("created_at DESC").Offset(offset).Limit(size).Find(&devices).Error; err != nil {
		fail500(c, "查询失败")
		return
	}
	groups := map[int64]string{}
	var gs []models.DeviceGroup
	s.DB.Find(&gs)
	for _, g := range gs {
		groups[g.ID] = g.Name
	}
	nodes := map[int64]string{}
	var ns []models.Node
	s.DB.Find(&ns)
	for _, n := range ns {
		nodes[n.ID] = n.Name
	return false
}

var (
	errNotFoundTask  = errors.New("task not found")
	errLeaseMismatch = errors.New("lease mismatch")
	errNotReportable = errors.New("not reportable")
)

// applyTaskSideEffects 结果副作用：版本推进 / 回滚计数 / 告警（同事务）。
func (s *Server) applyTaskSideEffects(tx *gorm.DB, t *models.Task, status string, detail map[string]any) {
	isConfigTask := t.Type == "switch_node" || t.Type == "reload_proxy"
	now := time.Now().UTC()
	// 先读当前 streak（更新前），保证「连续 2 次」判定不受同事务更新影响
	var devBefore models.Device
	tx.Where("id=?", t.DeviceID).First(&devBefore)
	updates := map[string]any{"updated_at": now}
	newStreak := devBefore.RollbackStreak
	switch {
	case status == models.TaskOK && isConfigTask && t.ConfigVersion != nil:
		updates["current_config_version"] = *t.ConfigVersion
		if *t.ConfigVersion > 0 {
			updates["highest_accepted_version"] = gorm.Expr("GREATEST(highest_accepted_version, ?)", *t.ConfigVersion)
		}
		updates["rollback_streak"] = 0
		newStreak = 0
	case status == models.TaskRolledBack && isConfigTask:
		updates["rollback_streak"] = gorm.Expr("rollback_streak + 1")
		newStreak = devBefore.RollbackStreak + 1
	}
	tx.Model(&models.Device{}).Where("id=?", t.DeviceID).Updates(updates)

	if status == models.TaskRolledBack && isConfigTask && newStreak >= 2 {
		s.alerts.Raise(tx, "consecutive_rollback", &t.DeviceID, "critical",
			fmt.Sprintf("设备 %s 连续 %d 次配置回滚，请检查节点或配置", t.DeviceID, newStreak),
			fmt.Sprintf("consecutive_rollback:%s", t.DeviceID))
	}
	if rollbackFailed, _ := detail["rollback_failed"].(bool); rollbackFailed {
		s.alerts.Raise(tx, "rollback_failed", &t.DeviceID, "critical",
			fmt.Sprintf("设备 %s 任务 %s 回滚失败，需要人工介入", t.DeviceID, t.ID),
			fmt.Sprintf("rollback_failed:%s:%s", t.DeviceID, t.ID))
	}
	// 任务带出的出口 IP 变化，关联任务 ID（§7.3）
	if exitIP, _ := detail["exit_ip"].(string); exitIP != "" {
		var dev models.Device
		if err := tx.Where("id=?", t.DeviceID).First(&dev).Error; err == nil {
			if dev.CurrentExitIP != "" && dev.CurrentExitIP != exitIP {
				s.alerts.Raise(tx, "exit_ip_changed", &dev.ID, "info",
					fmt.Sprintf("设备 %s 出口 IP 变化 %s -> %s（任务 %s）", dev.ID, dev.CurrentExitIP, exitIP, t.ID),
					fmt.Sprintf("exit_ip_changed:%s:%s", dev.ID, t.ID))
