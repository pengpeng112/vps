var errRevisionChanged = fmt.Errorf("revision changed")

// lineDiff 绠€鍗曡绾?diff锛堟帺鐮佸唴瀹癸紝鍙樻洿琛岃冻澶燂級銆?func lineDiff(oldS, newS string) []gin.H {
	oldL := strings.Split(oldS, "\n")
	newL := strings.Split(newS, "\n")
	oldSet := map[string]int{}
	for _, l := range oldL {
		oldSet[l]++
	}
	newSet := map[string]int{}
	for _, l := range newL {
		newSet[l]++
	}
	var out []gin.H
	for _, l := range oldL {
		if newSet[l] == 0 {
			out = append(out, gin.H{"op": "-", "line": l})
		} else if newSet[l] > 0 {
			newSet[l]--
		}
	}
	for _, l := range newL {
		if oldSet[l] == 0 {
			out = append(out, gin.H{"op": "+", "line": l})
		} else if oldSet[l] > 0 {
			oldSet[l]--
		}
	}
	return out
}

