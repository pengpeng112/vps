var reWSHost = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9.-]{0,253}$`)

func ValidWSPath(p string) bool { return reWSPath.MatchString(p) }
func ValidWSHost(h string) bool { return reWSHost.MatchString(h) }
