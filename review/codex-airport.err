    TLS:
      ports: [443, 8443]

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - localhost
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "time.*.com"
    - "ntp.*.com"
    - "stun.*.*"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  fallback:
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
    domain:
      - "+.google.com"
      - "+.googleapis.com"
      - "+.gstatic.com"
      - "+.youtube.com"
      - "+.github.com"
      - "+.telegram.org"
  proxy-server-nameserver:
    - 223.5.5.5
    - 8.8.8.8
  nameserver-policy:
    "geosite:cn,private":
      - https://doh.pub/dns-query
      - https://dns.alidns.com/dns-query

proxies:
#{{NODE_PROXIES}}

proxy-groups:
  - name: "PROXY"
    type: select
    proxies:
      - AUTO
#{{GROUP_PROXY_MEMBERS}}
      - DIRECT
  # AUTO and nested NODE-PICK use the same overseas HTTPS health target.
  # Domestic Apple reachability cannot prove overseas service availability.
  - name: "AUTO"
    type: fallback
    url: https://www.gstatic.com/generate_204
    interval: 120
    timeout: 4000
    expected-status: 204
    lazy: false
    proxies:
      - NODE-PICK
      - DIRECT
  # NODE-PICK = 节点主备（2026-09-27 M03：url-test 改为有序 fallback）：
  # fallback 按成员顺序取第一个健康节点。成员顺序由绑定渲染（primary 在前），
  # 不在模板里硬编码——现网实况（2026-10-02）：R2/R3/R4 交互主用东京
  # BWG-VLESS，视频与大文件走 US-MEDIA（LAX）。旧注释「主用腾讯、备用 DO」已过时。
  # 简单 fallback 无外部质量控制器的防抖/评分能力，边界与限制见 docs/plans
  # 网络计划 §6.1。
  # 2026-10-26 lazy:false + interval 120（BWG 被墙事故复盘）：mihomo fallback 组默认
  # lazy=true——组无流量即暂停探测，节点存活状态停在旧标记，被墙后 17 小时不切换
  # （R4 实证）。lazy:false 强制常测，节点失效 ≤2 分钟内自动落到下一健康成员。
  - name: "NODE-PICK"
    type: fallback
    url: https://www.gstatic.com/generate_204
    interval: 120
    lazy: false
    proxies:
#{{GROUP_AUTO_MEMBERS}}
  - name: "CN-MEDIA"
    type: select
    proxies:
      - DIRECT
  - name: "DOWNLOAD"
    type: select
    proxies:
      - DIRECT
      - PROXY
  # Explicit members: available LAX nodes first, then NODE-PICK.
  # include-all excludes groups and previously produced COMPATIBLE without LAX.
  - name: "US-MEDIA"
    type: fallback
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: false
    timeout: 4000
    expected-status: 204
    proxies:
#{{MEDIA_MEMBERS}}

rules:
#{{NODE_DIRECT_RULES}}
  # 2026-10-29 政企业务系统强制直连（昌乐实测：阿里云高防域名 GeoIP 误判海外→走代理→站点拒访）
  - DOMAIN-SUFFIX,istarshine.com,DIRECT
  - GEOIP,private,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR6,fc00::/7,DIRECT,no-resolve
  - IP-CIDR6,fe80::/10,DIRECT,no-resolve
  - GEOSITE,private,DIRECT

  # 国内视频/短视频/直播 —— 禁止走节点
  - GEOSITE,bilibili,CN-MEDIA
  - GEOSITE,iqiyi,CN-MEDIA
  - GEOSITE,youku,CN-MEDIA
  - GEOSITE,bytedance,CN-MEDIA
  - DOMAIN-SUFFIX,bilivideo.com,CN-MEDIA
