   """))

   P2 = api("POST", f"/devices/{DEV}/configs/preview", {})
   assert P2["revision"]==P["revision"] and P2["sha256"]==P["sha256"]
   assert active_tasks(DEV)==[]
   window()
   PUBLISH_START = int(G("date +%s\n").strip())

