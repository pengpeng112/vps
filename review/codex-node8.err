grep -nE '^[[:space:]]*#?[[:space:]]*VPS4_(HOST|PORT)=' /etc/routermgmt/tunnel.conf 2>/dev/null || echo TCONF_FAIL
md5sum /etc/routermgmt/tunnel.conf /etc/mihomo/config.yaml /etc/routermgmt/self-heal.sh 2>/dev/null
echo "@@processes"
echo "mihomo=$(pidof mihomo | wc -w)"
echo "agent=$(ps w | grep -c '[r]outermgmt-agent')"
echo "@@guards"
[ -e /tmp/selfheal.pause ] && echo PAUSE_PRESENT || echo PAUSE_ABSENT
find /etc/routermgmt/state/txn -name uncommitted -print 2>/dev/null | wc -l
echo "@@mgmt"
curl -sk -m 6 -o /dev/null -w 'mgmt18443=%{http_code}\n' https://127.0.0.1:18443/api/v1/health 2>/dev/null
echo "@@do_conns"
netstat -tn 2>/dev/null | grep -c '159.223.36.119' || echo 0
echo "@@end"
"""

out_all = []
out_all.append(f"===== midnight check {datetime.now().isoformat()} =====")

gz = paramiko.SSHClient()
gz.set_missing_host_key_policy(paramiko.AutoAddPolicy())
gz.connect("134.175.151.213", port=28722, username="ubuntu", password=PW,
           timeout=20, look_for_keys=False, allow_agent=False)

_, o_hb, _ = gz.exec_command(
    "sudo -u postgres psql routermgmt -t -A -F'|' -c \"SELECT name,"
    "round(extract(epoch from (now()-last_heartbeat_at))),remote_ssh_alive "
    "FROM devices WHERE name='SN-R7-AX3000';\" 2>&1",
    timeout=30,
)
hb = o_hb.read().decode().strip()
out_all.append(f"@@gz-heartbeat(R7 age_s|alive): {hb}")

try:
    _, o_ls, _ = gz.exec_command("ss -ltn | grep ':13229' | head -1", timeout=15)
    out_all.append(f"@@gz-13229-listen: {o_ls.read().decode().strip() or 'NOT_LISTENING'}")
except Exception as exc:
    out_all.append(f"@@gz-13229-listen: ERROR {exc}")

try:
    chan = gz.get_transport().open_channel("direct-tcpip", ("127.0.0.1", 13229), ("127.0.0.1", 0))
    r7 = paramiko.SSHClient()
    r7.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    r7.connect("127.0.0.1", port=13229, username="root", password=PW, sock=chan,
               timeout=20, look_for_keys=False, allow_agent=False)
    stdin, stdout, stderr = r7.exec_command("sh -s", timeout=90)
    stdin.channel.sendall(SCRIPT.encode())
    stdin.channel.shutdown_write()
    dev_out = stdout.read().decode("utf-8", "replace")
    out_all.append(dev_out)
    r7.close()
except Exception as exc:
    out_all.append(f"@@device-connect: FAIL {exc}")

gz.close()

report = "\n".join(out_all)

verdict = "MIDNIGHT_UNKNOWN"
if "API_FAIL" not in report and "EGRESS_FAIL" not in report and "TCONF_FAIL" not in report:
    if "PROXY" in report and "\nAUTO" in report.replace("@@proxy\n", ""):
        lines = report.splitlines()
        try:
            proxy_now = lines[lines.index("@@proxy") + 1].strip()
            auto_now = lines[lines.index("@@proxy") + 2].strip()
            egress = lines[lines.index("@@egress") + 1].strip()
            boot = [l for l in lines if l.startswith("boot_id=")][0]
            if proxy_now == "AUTO" and auto_now == "NODE-PICK" and egress == "154.36.139.155":
                verdict = f"MIDNIGHT_PASS {boot} PROXY={proxy_now} AUTO={auto_now} egress={egress}"
            else:
                verdict = f"MIDNIGHT_FAIL PROXY={proxy_now} AUTO={auto_now} egress={egress}"
        except (ValueError, IndexError):
            verdict = "MIDNIGHT_PARSE_FAIL"
else:
    verdict = "MIDNIGHT_FAIL (api/egress/tconf check failed)"

out_all.append(f"VERDICT: {verdict}")
out_all.append("NOTE: automation is READ-ONLY; no hotfix per Codex ruling (机会留给人工/下轮).")

report = "\n".join(out_all)
print(report)

log = Path(r"F:\vps\logs\r7-midnight-check-20261102.txt")
#!/bin/sh
# fleet-inspect v1 —— 标准巡检片段（来源：Codex 复核 2026-11-01，review/codex-fix-verify-20261101.md）
# 用法：经排灾口将本文件推入设备后 `sh /tmp/fleet-inspect.sh`；采集失败=UNKNOWN，单次失败不判设备故障。
# 原则：不输出凭据；CR 用 od 字节计数（避开 ash ANSI-C 陷阱）；mihomo -t 必须用运行中进程的实际 -d/-f。
#!/bin/sh
set -u
S=/etc/routermgmt/state

date -u
cat /proc/sys/kernel/random/boot_id
for t in "$S"/txn/*/uncommitted; do
    [ ! -f "$t" ] || {
        echo "UNKNOWN: apply in progress"; exit 2;
    }
done
[ ! -e /tmp/selfheal.pause ] ||
    echo "PENDING: selfheal.pause exists"
cat "$S/accepted_version" 2>/dev/null ||
    echo "UNKNOWN: accepted_version"
md5sum /etc/routermgmt/self-heal.sh
grep -E 'self-heal[.]sh|routermgmt-reboot' /etc/crontabs/root

# 分别检查磁盘参数、procd 内存参数；不输出整个实例的 env。
for svc in routermgmt mgmt-tunnel; do
    printf '\nSERVICE=%s\n' "$svc"
    grep -n '^[[:space:]]*procd_set_param[[:space:]]*respawn' \
        "/etc/init.d/$svc"
    j=$(ubus call service list "{\"name\":\"$svc\"}" 2>/dev/null) || {
        echo "UNKNOWN: ubus unavailable"; continue;
    }
    for k in running pid respawn; do
        printf '%s:\n' "$k"
        v=$(jsonfilter -s "$j" \
            -e "@['$svc'].instances[*].$k" 2>/dev/null)
        [ -n "$v" ] && printf '%s\n' "$v" ||
            echo "UNKNOWN: field absent"
    done
done

# 使用运行中核心的实际 -d/-f，避免 geodata 目录误判。
pids=$(pidof mihomo 2>/dev/null || pidof clash 2>/dev/null || true)
set -- $pids
[ "$#" -eq 1 ] || {
    echo "UNKNOWN: core count is not one"; exit 2;
}
p=$1
args=$(tr '\000' '\n' < "/proc/$p/cmdline")
D=$(printf '%s\n' "$args" | awk '$0=="-d"{getline; print; exit}')
F=$(printf '%s\n' "$args" | awk '$0=="-f"{getline; print; exit}')
case "$D" in
    /*) ;;
    *) echo "UNKNOWN: verify core home"; exit 2 ;;
esac
[ -n "$F" ] || F="$D/config.yaml"
case "$F" in
    /*) ;;
    *) echo "UNKNOWN: relative config path"; exit 2 ;;
esac
[ -r "$F" ] && [ -s "$F" ] || {
    echo "UNKNOWN: config unreadable"; exit 2;
}
printf 'core_pid=%s home=%s config=%s\n' "$p" "$D" "$F"
before=$(sha256sum "$F" | awk '{print $1}')
printf 'disk_sha256=%s\n' "$before"

# 字节计数，完全避开 ash 的 ANSI-C quoting 差异。
od -An -v -tu1 "$F" |
    awk '{for(i=1;i<=NF;i++)if($i==13)n++}
         END{print "CR_bytes=" n+0}'

# 只输出成员名，不输出配置中的凭据。
awk '
/^  - name: "NODE-PICK"/ {p=1;next}
p && /^  - name:/ {exit}
p && /^      - / {print "disk_member=" substr($0,9)}
' "$F"

if { [ -s "$D/Country.mmdb" ] || [ -s "$D/geoip.metadb" ]; } &&
   { [ -s "$D/GeoSite.dat" ] || [ -s "$D/geosite.dat" ]; } &&
   command -v timeout >/dev/null 2>&1; then
    timeout 25 "/proc/$p/exe" -t -d "$D" -f "$F" >/dev/null 2>&1
    printf 'validate_rc=%s (0=PASS; other=investigate)\n' "$?"
else
    echo "UNKNOWN: verify geodata/timeout before validation"
fi

for g in PROXY AUTO NODE-PICK US-MEDIA; do
    printf '\nGROUP=%s\n' "$g"
    j=$(curl --noproxy '*' -fsS -m 5 \
        "http://127.0.0.1:9090/proxies/$g") || {
        echo "UNKNOWN: API request failed"; continue;
    }
    jsonfilter -s "$j" -e '$.name' -e '$.type' \
        -e '$.now' -e '$.fixed' -e '$.all[*]'
done

h=$(curl --noproxy '*' -ksS -m 8 -o /dev/null \
    -w '%{http_code}' https://127.0.0.1:18443/api/v1/health)
printf 'mgmt_rc=%s http=%s\n' "$?" "$h"

for i in 1 2 3; do
    t=$(curl --noproxy '' -fsS -m 10 \
        -x http://127.0.0.1:7890 \
        https://www.cloudflare.com/cdn-cgi/trace)
    rc=$?
    ip=$(printf '%s\n' "$t" | awk -F= '$1=="ip"{print $2;exit}')
    printf 'egress_sample=%s rc=%s ip=%s\n' \
        "$i" "$rc" "${ip:-UNKNOWN}"
    sleep 2
done
h=$(curl --noproxy '' -sS -m 10 -x http://127.0.0.1:7890 \
    -o /dev/null -w '%{http_code}' \
    https://www.gstatic.com/generate_204)
printf 'overseas_rc=%s http=%s (expected 204)\n' "$?" "$h"
nslookup www.baidu.com 127.0.0.1 >/dev/null 2>&1
printf 'local_dns_rc=%s\n' "$?"

after=$(sha256sum "$F" | awk '{print $1}')
[ "$before" = "$after" ] ||
    echo "UNKNOWN: config changed during audit"

exec
"C:\\Users\\Administrator\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe" -Command "Get-Content -LiteralPath 'mgmt/backend/internal/httpserver/configs.go' -Encoding UTF8 | Select-Object -Skip 710 -First 50; Get-Content -LiteralPath 'mgmt/backend/internal/models/models.go' -Encoding UTF8 | Select-Object -Skip 125 -First 48; Get-Content -LiteralPath 'mgmt/agent/handlers/switch_node.sh' -Encoding UTF8 | Select-Object -Skip 195 -First 170; Get-Content -LiteralPath 'mgmt/agent/self-heal.sh' -Encoding UTF8 -TotalCount 90; Get-Content -LiteralPath 'mgmt/backend/internal/clash/template.go' -Encoding UTF8 | Select-Object -Skip 150 -First 44" in F:\vps
 succeeded in 1892ms:
}

// ---- 管理端任务/配置查询 ----

func (s *Server) handleTaskList(c *gin.Context) {
	page, size, offset := pageArgs(c)
	q := s.DB.Model(&models.Task{})
	if v := c.Query("device_id"); v != "" {
		q = q.Where("device_id=?", v)
	}
	if v := c.Query("status"); v != "" {
		q = q.Where("status=?", v)
	}
	var total int64
	q.Count(&total)
	var ts []models.Task
	q.Order("created_at DESC").Offset(offset).Limit(size).Find(&ts)
	items := make([]gin.H, 0, len(ts))
	for i := range ts {
		t := &ts[i]
		items = append(items, gin.H{
			"id": t.ID, "device_id": t.DeviceID, "type": t.Type,
			"params": jsonRaw(t.ParamsJSON), "status": t.Status,
			"result":         jsonRaw(t.ResultJSON),
			"config_version": t.ConfigVersion, "created_by": t.CreatedBy,
			"created_at": t.CreatedAt, "claimed_at": t.ClaimedAt, "executed_at": t.ExecutedAt, "deadline": t.Deadline,
		})
	}
	c.JSON(http.StatusOK, pageResp(items, total, page, size))
}

// handleDeviceConfigMasked 管理端只看掩码 YAML；原始配置仅设备可下（§9）。
func (s *Server) handleDeviceConfigMasked(c *gin.Context) {
	var dev models.Device
	if err := s.DB.Where("id=?", c.Param("id")).First(&dev).Error; err != nil {
		fail404(c, "设备不存在")
		return
	}
	if dev.DesiredConfigVersion == 0 {
		c.JSON(http.StatusOK, gin.H{"version": 0, "yaml": "", "message": "尚未发布配置"})
		return
	}
	var cfg models.Config
	if err := s.DB.Where("device_id=? AND version=?", dev.ID, dev.DesiredConfigVersion).First(&cfg).Error; err != nil {
		fail404(c, "配置不存在")
		return
	}
	raw, err := crypto.Decrypt(s.MasterKey, cfg.ContentEnc, fmt.Sprintf("configs:%d:content", cfg.ID))
	if err != nil {
		fail500(c, "解密失败")
	TaskOK         = "ok"
	TaskFailed     = "failed"
	TaskRolledBack = "rolled_back"
	TaskExpired    = "expired"
	TaskCancelled  = "cancelled"
	TaskUnknown    = "unknown"
)

type Task struct {
	ID            string `gorm:"primaryKey;size:32"`
	DeviceID      string `gorm:"size:32;index:idx_tasks_device_status_created"`
	Type          string `gorm:"size:32"`
	ParamsJSON    string `gorm:"column:params_json"`
	Status        string `gorm:"size:16;index:idx_tasks_device_status_created"`
	ResultJSON    string `gorm:"column:result_json"`
	ConfigID      *int64 `gorm:"column:config_id"`
	ConfigVersion *int64 `gorm:"column:config_version"`
	ConfigSHA256  string `gorm:"column:config_sha256;size:64"`
	LeaseID       string `gorm:"column:lease_id;size:64"`
	LeaseExpiresAt *time.Time `gorm:"column:lease_expires_at"`
	IdempotencyKey string `gorm:"column:idempotency_key;size:128"`
	CreatedBy     string `gorm:"column:created_by;size:128"`
	CreatedAt     time.Time `gorm:"index:idx_tasks_device_status_created"`
	ClaimedAt     *time.Time `gorm:"column:claimed_at"`
	ExecutedAt    *time.Time `gorm:"column:executed_at"`
	Deadline      time.Time
}

func (Task) TableName() string { return "tasks" }

type Metric struct {
	ID           int64 `gorm:"primaryKey"`
	DeviceID     string `gorm:"size:32;index:idx_metrics_device_ts;uniqueIndex:idx_metrics_device_sample"`
	TS           time.Time `gorm:"column:ts;index:idx_metrics_device_ts"`
	CPU          *float64 `gorm:"column:cpu"`
	MemUsedMB    *int64   `gorm:"column:mem_used_mb"`
	MemTotalMB   *int64   `gorm:"column:mem_total_mb"`
	TempC        *float64 `gorm:"column:temp_c"`
	DiskFreeMB   *int64   `gorm:"column:disk_free_mb"`
	UptimeS      *int64   `gorm:"column:uptime_s"`
	WanIP        string   `gorm:"column:wan_ip;size:64"`
	ExitIP       string   `gorm:"column:exit_ip;size:64"`
	ExitNode     string   `gorm:"column:exit_node;size:64"`
	ExitLatencyMs *int64  `gorm:"column:exit_latency_ms"`
	ClashAlive   *bool    `gorm:"column:clash_alive"`
	WGAlive      *bool    `gorm:"column:wg_alive"`
	WanRxBytes   *int64   `gorm:"column:wan_rx_bytes"`
	WanTxBytes   *int64   `gorm:"column:wan_tx_bytes"`
        [ -f "$_d/uncommitted" ] || { rm -rf "$_d"; continue; }
        _tid=$(cat "$_d/task_id" 2>/dev/null)
        _lease=$(cat "$_d/lease_id" 2>/dev/null)
        log "recover: 发现未提交事务 $_tid，执行回滚"
        if txn_rollback "$_d"; then
            [ -n "$_tid" ] && persist_result "$_tid" "${_lease:-}" rolled_back '{"error":"agent restarted during apply, restored backup"}'
            echo "rolled_back" > "$_d/final"
        else
            [ -n "$_tid" ] && persist_result "$_tid" "${_lease:-}" failed '{"error":"agent restarted during apply","rollback_failed":true}'
            echo "rollback_failed" > "$_d/final"
        fi
        rm -f "$_d/uncommitted"
    done
    return 0
}

task_apply_config() { # $1 任务 JSON（switch_node / reload_proxy）
    _tj="$1"
    _tid=$(json_str "$_tj" '$.task_id')
    _type=$(json_str "$_tj" '$.type')
    _lease=$(json_str "$_tj" '$.lease_id')
    _ver=$(json_str "$_tj" '$.config_version')
    _sha=$(json_str "$_tj" '$.config_sha256')
    _sig=$(json_str "$_tj" '$.signature')
    _curl_url=$(json_str "$_tj" '$.config_url')
    _node=$(json_str "$_tj" '$.params.node_name')
    _expect=$(json_str "$_tj" '$.params.expect_exit_ip')
    _deadline=$(json_str "$_tj" '$.deadline')

    _fail() { persist_result "$_tid" "$_lease" failed "{\"error\":\"$1\"}"; mv -f "$(txn_dir_for "$_tid")" "$STATE_DIR/txn-debug" 2>/dev/null; return 0; }

    # 0. 幂等：同任务已有最终结果只重传（§7.5）
    if [ -f "$STATE_DIR/results/$_tid.json" ]; then
        log "task $_tid 已有结果，仅重传"
        return 0
    fi

    _dir=$(oc_config_dir) || { _fail "未找到 OpenClash 配置目录（尝试过 /etc/openclash/config /etc/clash；RM_CLASH_DIR 可覆盖）"; return 0; }
    _active=$(oc_active_config) || { _fail "未找到活动配置文件"; return 0; }

    # 防重放高水位：版本必须高于已接受版本（本地恢复允许回旧活动版本但保留最高已接受，§7.5）
    _acc=$(accepted_version_read)
    case "$_acc" in ''|*[!0-9]*) _acc=0 ;; esac
    if [ -n "$_ver" ] && [ "$_ver" -le "$_acc" ] 2>/dev/null; then
        persist_result "$_tid" "$_lease" ok "{\"skipped\":true,\"accepted_version\":$_acc}"
        return 0
    fi

    _txn=$(txn_dir_for "$_tid")
    rm -rf "$_txn"; mkdir -p "$_txn"
    echo "$_tid" > "$_txn/task_id"; echo "$_lease" > "$_txn/lease_id"

    # 1. 下载指定不可变版本（同文件系统临时文件 600）
    _rpath=$(printf '%s' "$_curl_url" | sed 's|^[a-zA-Z][a-zA-Z0-9+.-]*://[^/]*||')
    case "$_rpath" in /api/v1/agent/configs/*) ;; *) { _fail "非法配置下载路径"; return 0; } ;; esac
    : > "$_txn/new.yaml"
    chmod 600 "$_txn/new.yaml"
    _code=$(api_call GET "$_rpath" /dev/null "$_txn/new.yaml")
    [ "$_code" = "200" ] || { _fail "配置下载失败 http=$_code"; return 0; }
    [ -s "$_txn/new.yaml" ] || { _fail "配置内容为空"; return 0; }

    # 设备/版本/哈希/签名校验
    _gotsha=$(openssl dgst -sha256 -hex "$_txn/new.yaml" | awk '{print $NF}')
    { [ -z "$_sha" ] || [ "$_gotsha" = "$_sha" ]; } || { _fail "配置哈希不匹配"; return 0; }
    [ -n "$_ver" ] || { _fail "缺少 config_version"; return 0; }
    verify_config_signature "$_txn/new.yaml" "$_ver" "$_sig" || { _fail "配置签名验证失败（拒绝应用）"; return 0; }

    # 2. 核心校验
    mihomo_validate "$_txn/new.yaml" || { _fail "mihomo 配置校验失败"; return 0; }

    # 3. 备份当前配置 + 活动路径 + PROXY 选择状态；落盘事务并启动看门狗
    cp "$_active" "$_txn/backup.yaml"
    _oldsel=$(oc_get_group PROXY)
    printf '%s\n%s\n' "$_active" "$_oldsel" > "$_txn/backup.meta"
    echo "backup_done" > "$_txn/phase"
    touch "$_txn/uncommitted"
    (
        _wd=${RM_WATCHDOG_SEC:-100}
        sleep "$_wd"
        if [ -f "$_txn/uncommitted" ]; then
            log "watchdog: 事务 $_tid 超时未提交，回滚"
            txn_rollback "$_txn" && echo "rolled_back" > "$_txn/final" || echo "rollback_failed" > "$_txn/final"
            rm -f "$_txn/uncommitted"
        fi
    ) &
    echo $! > "$_txn/watchdog.pid"

    # 4. 原子替换 + 加载 + 强制 PROXY 指向目标节点（避免 AUTO/持久化旧选择）
    if ! cp "$_txn/new.yaml" "${_active}.routermgmt.tmp"; then
        kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
        _fail "写临时配置失败"
        return 0
    fi
    chmod 644 "${_active}.routermgmt.tmp"
    if ! mv "${_active}.routermgmt.tmp" "$_active"; then
        kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
        _fail "原子替换失败"
        return 0
    fi
    echo "replaced" > "$_txn/phase"
    oc_reload "$_active" || {
        _rb=1
    }
    wait_api_ready || { _rb=1; }
    sleep 3  # DNS/fake-ip 缓存重载后的收敛等待，避免探针误判
    if [ "${_rb:-0}" = "1" ]; then
        # 应用失败 → 回滚
        kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
        if txn_rollback "$_txn"; then
            rm -f "$_txn/uncommitted"; echo "rolled_back" > "$_txn/final"
            persist_result "$_tid" "$_lease" rolled_back '{"error":"reload failed, restored backup"}'
        else
            rm -f "$_txn/uncommitted"; echo "rollback_failed" > "$_txn/final"
            persist_result "$_tid" "$_lease" failed '{"error":"reload failed","rollback_failed":true}'
        fi
        return 0
    fi
    if [ "$_type" = "switch_node" ] && [ -n "$_node" ]; then
        oc_set_group PROXY "$_node"
    fi

    # 5. 健康检查：出口（固定 IP 节点两次一致）+ 国内直连 + 管理面连通
    _healthy=1; _egress_ip=""
    if [ -n "$_expect" ]; then
        _p1=$(probe_egress) || _healthy=0
        _p2="" ; [ "$_healthy" = "1" ] && { _p2=$(probe_egress) || _healthy=0; }
        [ "$_healthy" = "1" ] && [ "$_p1" = "$_p2" ] && [ "$_p1" = "$_expect" ] || _healthy=0
        _egress_ip=$_p1
    else
        _egress_ip=$(probe_egress) || _healthy=0
    fi
    [ "$_healthy" = "1" ] && { probe_cn_direct || { sleep 3; probe_cn_direct || { _healthy=0; echo "cn_direct failed x2 $(date +%T)" > "$STATE_DIR/health.log"; }; }; }
    [ "$_healthy" = "1" ] && { probe_mgmt || { _healthy=0; echo "mgmt failed $(date +%T)" > "$STATE_DIR/health.log"; }; }

    # Restore automatic failover before committing, with the transaction watchdog
    # still armed. Failure follows the existing rollback path below.
    _grp=$(oc_get_group PROXY)
    if [ "$_healthy" = "1" ] && [ "$_type" = "switch_node" ] && [ -n "$_node" ]; then
        oc_set_group PROXY AUTO || _healthy=0
        sleep 1
        _grp=$(oc_get_group PROXY)
        [ "$_grp" = "AUTO" ] || _healthy=0
        [ "$_healthy" = "1" ] && { _egress_ip=$(probe_egress) || _healthy=0; }
    fi

    if [ "$_healthy" != "1" ]; then
        # 7. 健康检查失败 → 回滚（先备份/选择状态恢复，验证成功才报 rolled_back）
        kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
        if txn_rollback "$_txn"; then
            rm -f "$_txn/uncommitted"; echo "rolled_back" > "$_txn/final"
            persist_result "$_tid" "$_lease" rolled_back "{\"error\":\"health check failed\",\"exit_ip\":\"$_egress_ip\"}"
        else
            rm -f "$_txn/uncommitted"; echo "rollback_failed" > "$_txn/final"
            persist_result "$_tid" "$_lease" failed '{"error":"health check failed","rollback_failed":true}'
        fi
        return 0
    fi

    # 6. 提交：取消看门狗、更新最高已接受版本、持久化结果、回报 ok
    kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
    rm -f "$_txn/uncommitted"
    echo "committed" > "$_txn/final"
    if [ -n "$_ver" ] && [ "$_ver" -gt "$_acc" ]; then
        echo "$_ver" > "$STATE_DIR/accepted_version"
    fi
	persist_result "$_tid" "$_lease" ok "{\"exit_ip\":\"$_egress_ip\",\"version\":$_ver,\"proxy_group\":\"$_grp\"}"
	log "task $_tid committed version=$_ver exit=$_egress_ip"
	reapply_runtime_modes
	return 0
}
#!/bin/sh
# self-heal.sh v3.1 - safe version (2026-10-30 v3.1 fleet patch)
# Runs from cron every minute. Only restarts dead services, never reboots.
# v3.1 changes (R6 回滚事故复盘 2026-10-30 晚):
#   - pidof 检测在本平台不可靠（agent 以 /bin/sh 运行，进程名是 sh）——误判会在
#     配置应用中途重启 agent 导致事务回滚（R6 实证）。改用 ps + /proc/cmdline 双检。
#   - 应用事务进行中（state/txn/*/uncommitted 存在）绝不重启 agent。
#   - 18443 不通但心跳文件新鲜（10 分钟内）= 平台侧问题而非 agent 死，跳过重启。
# v3 changes (field test on R4):
#   - port-based detection instead of ps grep (ps unreliable on this BusyBox)
#   - mihomo: check port 9090 API responding
#   - agent: check port 18443 management responding (tunnel alive = agent alive)
# v2 changes (Codex review):
#   - removed auto-reboot (midnight cron is the fallback)
#   - removed tunnel restart (preserves rssh rescue channel)
#   - mkdir-based atomic lock
#   - 300s cooldown per service (prevents crash-restart loops)
#   - suppress during maintenance window (touch /tmp/selfheal.pause)

# Maintenance suppression
[ -f /tmp/selfheal.pause ] && exit 0

# Atomic lock via mkdir
LOCK=/tmp/selfheal.lock.d
mkdir "$LOCK" 2>/dev/null || {
    _now=$(date +%s)
    _created=$(cat "$LOCK/ts" 2>/dev/null || echo 0)
    _diff=$((_now - _created))
    [ "$_diff" -lt 180 ] && exit 0
    rm -rf "$LOCK"
    mkdir "$LOCK" 2>/dev/null || exit 0
}
echo "$(date +%s)" > "$LOCK/ts"
trap 'rm -rf "$LOCK"' EXIT

# 1) mihomo dead? Check API port 9090 responding (not ps grep)
if ! curl -s -m 3 -o /dev/null -w '' http://127.0.0.1:9090/version 2>/dev/null; then
    _cd=/tmp/selfheal.mihomo.cd
    _now=$(date +%s)
    _last=$(cat $_cd 2>/dev/null || echo 0)
    if [ $(($_now - _last)) -ge 300 ]; then
        echo $_now > $_cd
        logger -t self-heal "mihomo API not responding, restarting"
        /etc/init.d/mihomo restart 2>/dev/null
    fi
fi

# 2) agent dead? (v3.1: 可靠进程检测 + 事务保护 + 心跳新鲜度)
_agent_dead=0
if ! ps w 2>/dev/null | grep -v grep | grep -q "routermgmt-agent"; then
    _found=0
    for _d in /proc/[0-9]*/cmdline; do
        grep -q "routermgmt-agent" "$_d" 2>/dev/null && { _found=1; break; }
    done
    [ "$_found" = "0" ] && { _agent_dead=1; _reason="process dead"; }
elif ! curl -sk -m 3 -o /dev/null https://127.0.0.1:18443/api/v1/health 2>/dev/null; then
    if [ -z "$(find /etc/routermgmt/state/hb.json -mmin -10 2>/dev/null)" ]; then
        _agent_dead=1
        _reason="mgmt port not responding and heartbeat stale"
    fi
fi
if [ "$_agent_dead" = "1" ]; then
    if [ -n "$(ls /etc/routermgmt/state/txn/*/uncommitted 2>/dev/null)" ]; then
        logger -t self-heal "apply txn in progress, skip agent restart"
    else
        _cd=/tmp/selfheal.agent.cd
        _now=$(date +%s)
        _last=$(cat $_cd 2>/dev/null || echo 0)
        if [ $(($_now - _last)) -ge 300 ]; then
            echo $_now > $_cd
            logger -t self-heal "agent ${_reason}, restarting"
            /etc/init.d/routermgmt restart 2>/dev/null
        fi
    fi
fi

# NOTE: No tunnel restart (preserves rssh rescue channel).
# No auto-reboot (midnight 00:00 cron is the fallback).

exit 0
