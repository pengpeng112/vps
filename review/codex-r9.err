cp -p "$R7_SELFHEAL" "$R7_RUN/selfheal.before"

md5sum "$R7_CFG" "$R7_RUN/mihomo.config.before"
md5sum "$R7_SELFHEAL" "$R7_RUN/selfheal.before"

