cat /proc/sys/kernel/random/boot_id
test ! -e /tmp/selfheal.pause

api -o "$R7_RUN/proxy.preboot.json" "$R7_API/proxies/PROXY"
test "$(jsonfilter -i "$R7_RUN/proxy.preboot.json" -e '@.now')" = AUTO

sh -n "$R7_TUN"
grep -nE 'VPS4_(HOST|PORT)=' "$R7_TUN"
```

