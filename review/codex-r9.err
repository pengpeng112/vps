test -n "$R7_OLD_PROXY"
test "$(jsonfilter -i "$R7_RUN/proxy.before.json" -e '@.type')" = Selector

jsonfilter -i "$R7_RUN/proxy.before.json" -e '@.all[*]'
jsonfilter -i "$R7_RUN/auto.before.json" -e '@.now'

cache_copy before
