  85: class Tel:
  86:     def __init__(self):
  87:         self.s = socket.socket(); self.s.settimeout(5)
  88:         self.s.connect((HOST, 23)); self.buf = b""
  89:         time.sleep(1.2)
  90:         try: self.s.recv(4096)
  91:         except: pass
  92:     def send(self, line):
  93:         self.s.sendall(line.encode()+b"\n"); time.sleep(0.4)
  94:     def until(self, pat, timeout=6):
  95:         t0 = time.time(); acc = b""
  96:         while time.time()-t0 < timeout:
  97:             try:
  98:                 d = self.s.recv(4096)
  99:                 if d: self.buf += d; acc += d
 100:             except socket.timeout: pass
 101:             if re.search(pat, (self.buf+acc).decode(errors="replace")): return acc.decode(errors="replace")
 102:         return acc.decode(errors="replace")
