 109: def push(c, local, remote, mode=None):
 110:     # multi-verify V4 淇锛氭帹閫佸悗 md5 瀵规媿锛圫OP 鑷鏍囧噯锛汻7 瀹炴祴閫氶亾鍐欏彲琚埅鏂級
 111:     data = open(local, "rb").read()
 112:     want = hashlib.md5(data).hexdigest()
 113:     _, o, e = c.exec_command(f"cat > '{remote}' && md5sum '{remote}'", timeout=600)
 114:     o.channel.sendall(data); o.channel.shutdown_write()
 115:     out = o.read().decode(errors="replace")
 116:     got = out.split()[0] if out.split() else ""
 117:     if got != want:
 118:         print(f"  鉂?push md5 涓嶇 {remote}: {got[:12]} != {want[:12]}锛堥€氶亾鎴柇锛夆€斺€斾腑姝?)
 119:         sys.exit(4)
 120:     if mode: c.exec_command(f"chmod {mode} '{remote}'")[1].read()
