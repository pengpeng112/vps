  42:         try: s.recv(4096)
  43:         except OSError: pass
  44:         def until(p, t=5):
  45:             t0 = time.time(); acc = b""
  46:             while time.time() - t0 < t:
  47:                 try:
  48:                     d = s.recv(4096)
  49:                     if d: acc += d
  50:                 except socket.timeout: pass
  51:                 if re.search(p, acc.decode(errors="replace")): return acc.decode(errors="replace")
  52:             return acc.decode(errors="replace")
