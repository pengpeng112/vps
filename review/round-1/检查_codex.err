 112: def flash_one(ip, num, rssh, log):
 113:     p = subprocess.run([sys.executable, "-u", REPO + r"\scripts\flash-snr.py",
 114:                         "--num", str(num), "--rssh", str(rssh), "--host", ip],
 115:                        capture_output=True, text=True, timeout=1800, cwd=REPO + r"\scripts")
