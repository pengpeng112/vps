  61: 
  62: # ---- RSSH 端口自动分配（2026-09-30）----
  63: # 规则：同设备（snR{N}）复刷→复用 authorized_keys 已分配端口（幂等）；
  64: #       新设备→取"已分配端口与当前监听"的最大值+1（起点 13223，越界 13300 即停）。
  65: VPS_SSH = ['ssh','-p','28722','-i','C:/Users/Administrator/.ssh/id_rsa_dmit','-o','IdentitiesOnly=yes','root@179.255.137.64']  # 2026-10-02 端口表随公钥迁 DMIT
  66: 
  67: def alloc_rssh(n):
  68:     r = subprocess.run(VPS_SSH + ["grep -E 'rtr-mgmt-tunnel-snR%d$' /root/.ssh/authorized_keys 2>/dev/null | grep -oE 'permitlisten=\"127.0.0.1:[0-9]+\"' | grep -oE '[0-9]+\"' | tr -d '\"' | head -1" % n],
  69:                        capture_output=True, text=True, timeout=30)
  70:     mine = r.stdout.strip()
  71:     if mine:
  72:         print(f"  [rssh] snR{n} 已分配过端口 {mine}，复用（幂等复刷）")
  73:         return int(mine)
  74:     r = subprocess.run(VPS_SSH + ["(grep -oE 'permitlisten=\"127.0.0.1:[0-9]+\"' /root/.ssh/authorized_keys 2>/dev/null | grep -oE ':[0-9]+\"' | tr -d ':\"'; ss -tln 2>/dev/null | grep -oE '127.0.0.1:132[0-9][0-9]' | cut -d: -f2) | grep -E '^132[0-9]{2}$' | sort -n | tail -1"],
  75:                        capture_output=True, text=True, timeout=30)
  76:     try:
  77:         mx = int(r.stdout.strip())
  78:     except ValueError:
  79:         mx = 13222
  80:     nxt = max(mx + 1, 13223)
  81:     if nxt >= 13300:
  82:         sys.exit(f"  [rssh] 端口池将越界（{nxt}>=13300），人工核对 authorized_keys")
  83:     busy = subprocess.run(VPS_SSH + [f'ss -tln | grep -q "127.0.0.1:{nxt} " && echo BUSY || echo FREE'],
  84:                           capture_output=True, text=True, timeout=30).stdout.strip()
  85:     if busy == 'BUSY':
  86:         sys.exit(f"  [rssh] 端口 {nxt} 已被监听占用，人工核查")
  87:     print(f"  [rssh] 自动分配新端口 {nxt}")
  88:     return nxt
  89: 
  90: class Tel:
  91:     def __init__(self):
  92:         self.s = socket.socket(); self.s.settimeout(5)
  93:         self.s.connect((HOST, 23)); self.buf = b""
  94:         time.sleep(1.2)
  95:         try: self.s.recv(4096)
  96:         except: pass
  97:     def send(self, line):
  98:         self.s.sendall(line.encode()+b"\n"); time.sleep(0.4)
  99:     def until(self, pat, timeout=6):
 100:         t0 = time.time(); acc = b""
 101:         while time.time()-t0 < timeout:
 102:             try:
 103:                 d = self.s.recv(4096)
 104:                 if d: self.buf += d; acc += d
 105:             except socket.timeout: pass
 106:             if re.search(pat, (self.buf+acc).decode(errors="replace")): return acc.decode(errors="replace")
 107:         return acc.decode(errors="replace")
 108: 
 109: def ssh(pw):
 110:     c = paramiko.SSHClient(); c.set_missing_host_key_policy(paramiko.AutoAddPolicy())
 111:     c.connect(HOST, username="root", password=pw, timeout=10, allow_agent=False, look_for_keys=False)
 112:     return c
 113: 
 114: def push(c, local, remote, mode=None):
 115:     # multi-verify V4 修复：推送后 md5 对拍（SOP 自家标准；R7 实测通道写可被截断）
 116:     data = open(local, "rb").read()
 117:     want = hashlib.md5(data).hexdigest()
 118:     _, o, e = c.exec_command(f"cat > '{remote}' && md5sum '{remote}'", timeout=600)
 119:     o.channel.sendall(data); o.channel.shutdown_write()
 120:     out = o.read().decode(errors="replace")
 121:     got = out.split()[0] if out.split() else ""
 122:     if got != want:
 123:         print(f"  ❌ push md5 不符 {remote}: {got[:12]} != {want[:12]}（通道截断）——中止")
 124:         sys.exit(4)
 125:     if mode: c.exec_command(f"chmod {mode} '{remote}'")[1].read()
 126: 
 127: def run(c, script, timeout=240):
 128:     _, o, e = c.exec_command(script, timeout=timeout)
 129:     return (o.read()+e.read()).decode(errors="replace")
 130: 
 131: def _try_connect(addr, timeout=2):
 132:     try:
 133:         s = socket.create_connection(addr, timeout); s.close(); return True
 134:     except OSError:
 135:         return False
 136: 
 137: def main():
 138:     global HOST
 139:     ap = argparse.ArgumentParser()
 140:     ap.add_argument("--num", required=True, type=int, help="设备序号（如 4 → SN-R4-AX3000）——multi-verify V1：type=int 修复字符串算术崩溃")
 141:     ap.add_argument("--rssh", default="auto", help="反向 SSH 端口；默认 auto=自动分配（同设备复刷复用原端口）")
 142:     ap.add_argument("--random-pw", action="store_true", help="口令用随机值（默认=舰队统一值，2026-10-08 起）")
 143:     ap.add_argument("--host", default="192.168.132.1", help="设备地址（2026-10-13 批量并行刷机增补；可在任意网段）")
 144:     args = ap.parse_args()
 145:     N = args.num; NAME = f"SN-R{N}-AX3000"
 146:     HOST = args.host
 147:     RSSH = int(args.rssh) if str(args.rssh).isdigit() else alloc_rssh(int(N))
 148:     print(f"[{time.strftime('%H:%M:%S')}] 开始刷机 {NAME} @ {HOST} (RSSH {RSSH})")
 149: 
 150:     # 0) 探测
 151:     print(f"  可达: telnet={_try_connect((HOST,23))} ssh={_try_connect((HOST,22))}")
 152:     t = Tel(); t.until(r"login:"); t.send("root"); t.until(r"assword:")
 153:     t.send("abc@1234"); r = t.until(r"#", 5)
 154:     if "#" not in r:
 155:         print("telnet 登录失败"); sys.exit(1)
 156:     print("  telnet 登录成功")
 157: 
 158:     # 1) 改密（2026-10-08：默认直接舰队统一值，消除"先随机后统一"真空期）
 160:         PW, HASH = gen_creds(f"sn{N}")
 161:     else:
 162:         PW = UNIFIED_PW
 164:     open(REPO + rf"\backups\.snr{N}-pw", "w").write(PW + "\n" + HASH + "\n")
 165:     t.send(f"sed -i 's|^root:[^:]*:|root:{HASH}:|' /etc/shadow")
 166:     t.until(r"#", 5); t.s.close()
 167:     c = ssh(PW)
 168:     print(f"  SSH 新口令通过 ({PW[:6]}...)")
 169: 
 170:     # 2) 预装清理 + NTP

# set_wifi：远程开关 Wi-Fi（2026-09-23）。关闭时布防 5 分钟自动恢复兜底：
# 管理心跳走有线/WAN 隧道不受影响；300 秒内无新的 set_wifi enabled=true 确认，
# cron 每分钟巡检超时后自动重新启用并解除布防（防"远程关掉后联系不上"）。
# 2026-10-01 开机持久化修复：wifi.enabled 标记"最近一次人工开启"；rc.local 三态
# 判断（enabled→保持开 / disabled→主动关 / 都无=新设备默认关）。此前 rc.local 把
# wifi.disabled 当"已启用"读，语义反向：开启状态一重启就被关，禁用状态反而开回。
wifi_restore_disarm() {
    rm -f "$STATE_DIR/wifi.disabled"
    date +%s > "$STATE_DIR/wifi.enabled"
    sed -i '/#routermgmt-wifi-restore/d' /etc/crontabs/root 2>/dev/null
    [ -x /etc/init.d/cron ] && /etc/init.d/cron restart 2>/dev/null
    return 0
}

wifi_restore_arm() {
    date +%s > "$STATE_DIR/wifi.disabled"
    rm -f "$STATE_DIR/wifi.enabled"
    cat > /etc/routermgmt/wifi_restore.sh <<'EOS'
#!/bin/sh
# routermgmt Wi-Fi 自动恢复：布防 300 秒无确认则自动开回
_f="/etc/routermgmt/state/wifi.disabled"
[ -f "$_f" ] || exit 0
_now=$(date +%s); _ts=$(cat "$_f" 2>/dev/null || echo 0)
[ $((_now - _ts)) -lt 300 ] && exit 0
_rlist="$(uci show wireless 2>/dev/null | sed -n 's/^\(wireless\.[^.=]*\)=wifi-device$/\1/p')"
[ -z "$_rlist" ] && _rlist="$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.[^.]*\.device='\([^']*\)'/wireless.\1/p" | sort -u)"
for _r in $_rlist; do
    uci set "$_r.disabled=0"
done
# MTK 固件的 /sbin/wifi up 会关射频——检测到时跳过，纯 ifconfig
_mt7981=0
[ -d /etc/wireless/mediatek ] && _mt7981=1
for _i in $(ls -d /sys/class/net/ra[0-9]* /sys/class/net/rax[0-9]* 2>/dev/null | sed 's|.*/||'); do
    ifconfig "$_i" up 2>/dev/null
done
uci commit wireless
[ "$_mt7981" = "0" ] && { wifi up 2>/dev/null || /sbin/wifi up 2>/dev/null; }
rm -f "$_f"
date +%s > /etc/routermgmt/state/wifi.enabled
sed -i '/#routermgmt-wifi-restore/d' /etc/crontabs/root 2>/dev/null
[ -x /etc/init.d/cron ] && /etc/init.d/cron restart 2>/dev/null
logger -t routermgmt-agent "wifi auto-restored after timeout"
EOS
    chmod +x /etc/routermgmt/wifi_restore.sh
    grep -q '#routermgmt-wifi-restore' /etc/crontabs/root 2>/dev/null || \
        echo '* * * * * /etc/routermgmt/wifi_restore.sh #routermgmt-wifi-restore' >> /etc/crontabs/root
    [ -x /etc/init.d/cron ] && /etc/init.d/cron restart 2>/dev/null
    return 0
}

task_set_wifi() {
    _tj="$1"
    _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
    _en=$(json_str "$_tj" '$.params.enabled')
    case "$_en" in
        true|false) ;;
        *) persist_result "$_tid" "$_lease" failed '{"error":"invalid params.enabled"}'; return ;;
    esac
    # 段发现：标准 wifi-device + MT7981 风格（无线 iface 的 .device 指向的段名，如 RADIO2G）
    _rlist="$(uci show wireless 2>/dev/null | sed -n 's/^\(wireless\.[^.=]*\)=wifi-device$/\1/p')"
    [ -z "$_rlist" ] && _rlist="$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.[^.]*\.device='\([^']*\)'/wireless.\1/p" | sort -u)"
    _n=0
    for _r in $_rlist; do
        if [ "$_en" = "true" ]; then uci set "$_r.disabled=0"; else uci set "$_r.disabled=1"; fi
        _n=$((_n+1))
    done
    [ "$_n" -gt 0 ] || { persist_result "$_tid" "$_lease" failed '{"error":"no wifi-device found"}'; return 0; }
    uci commit wireless
    # MTK 私有驱动固件（SN-R2 类）：uci 不驱动射频，必须直接 ifconfig 控制接口。
    # 停用持久化由 $STATE_DIR/wifi.disabled 兜底（与 300s 自动恢复共用同一文件；
    # rc.local 的 wifi-default-off 钩子读取该文件判断是否执行）。
    _wl="$(ls -d /sys/class/net/ra[0-9]* /sys/class/net/rax[0-9]* /sys/class/net/rai[0-9]* /sys/class/net/rae[0-9]* 2>/dev/null | sed 's|.*/||' | tr '\n' ' ')"
    [ -z "$_wl" ] && _wl="ra0 rax0"
    _apply_mtk=0
    for _i in $_wl; do
        if [ "$_en" = "true" ]; then
            ifconfig "$_i" up 2>/dev/null && _apply_mtk=1
        else
            ifconfig "$_i" down 2>/dev/null && _apply_mtk=1
        fi
    done
    [ "$_apply_mtk" = "1" ] && log "set_wifi: MTK ifconfig applied ($_wl)"
    # MTK 固件的 /sbin/wifi 是 nossiac Lua 版，up/down 行为与标准相反（up 反而关射频），
    # 检测到 MT7981 风格时跳过 wifi 命令，纯 ifconfig 控制。
    _mt7981=0
    [ -d /etc/wireless/mediatek ] && _mt7981=1
    if [ "$_en" = "true" ]; then
        [ "$_mt7981" = "0" ] && { wifi up 2>/dev/null || /sbin/wifi up 2>/dev/null; }
        wifi_restore_disarm
        persist_result "$_tid" "$_lease" ok "{\"enabled\":true,\"radios\":$_n}"
        log "task $_tid wifi enabled radios=$_n"
    else
        [ "$_mt7981" = "0" ] && { wifi down 2>/dev/null || /sbin/wifi down 2>/dev/null; }
        wifi_restore_arm
        persist_result "$_tid" "$_lease" ok "{\"enabled\":false,\"radios\":$_n,\"auto_restore_s\":300}"
        log "task $_tid wifi disabled radios=$_n auto_restore=300s"
    fi
    return 0
}

