   1: #!/usr/bin/env python3
   2: # -*- coding: utf-8 -*-
   3: """SN-R 批量并行刷机驱动（2026-10-13 固化）
   4: 用法：
   5:   python flash-batch.py            # 扫描两网段的出厂态设备并全部并行刷机
   6:   python flash-batch.py --detect   # 只探测不刷机
   7:   python flash-batch.py --auto     # cron 无人值守：无设备则静默退出
   8: 发现条件：telnet(23) 开放 + root/abc@1234 可登 + MAC 不在现役清单（防误刷现役设备）。
   9: 并行：每台一线程跑 flash-snr.py --host X --num N --rssh R（端口由本驱动预分配防竞争）。
  10: """
  11: import argparse, json, os, re, socket, subprocess, sys, time
  12: from concurrent.futures import ThreadPoolExecutor
  13: 
  14: REPO = r"F:\vps"
  15: LOCK = REPO + r"\backups\.flash-batch.lock"
  16: SUBNETS = ["192.168.132", "192.168.2"]
  17: FACTORY_PW = "abc@1234"
  18: # 现役/已知设备 MAC（含 WiFi 与 pin 段）——扫描命中即排除，绝不误刷
  19: KNOWN_MAC_PREFIXES = ["a4:d8:ca:14:", "76:a7:c8:e0:4f:"]  # 兜底前缀（真实比对用精确集合）
  20: _EXACT_MACS = set()
  21: 
  22: def fleet_exact_macs():
  23:     try:
  24:         r = subprocess.run(['ssh','-p','28722','-i','C:/Users/Administrator/.ssh/id_rsa_dmit','-o','IdentitiesOnly=yes',
  25:                             'root@179.255.137.64',
  26:                             'docker exec routermgmt-db-1 psql -U postgres -d routermgmt -t -c "SELECT lower(mac_addr) FROM devices WHERE mac_addr IS NOT NULL"'],
  27:                            capture_output=True, text=True, timeout=30)
  28:         return {x.strip() for x in r.stdout.split() if ":" in x}
  29:     except Exception:
  30:         print("WARN: 平台 MAC 拉取失败，防误刷降级为前缀模式")
  31:         return set()
  32: 
  33: def sweep(subnet, port=23, timeout=1):
  34:     hits = []
  35:     def probe(ip):
  36:         try:
  37:             s = socket.create_connection((ip, port), timeout); s.close(); hits.append(ip)
  38:         except OSError:
  39:             pass
  40:     with ThreadPoolExecutor(max_workers=64) as ex:
  41:         list(ex.map(probe, [f"{subnet}.{i}" for i in range(2, 255)]))
  42:     return sorted(hits)
  43: 
  44: def telnet_fingerprint(ip):
  45:     """出厂态验证+取指纹；返回 (is_factory, info)"""
  46:     try:
  47:         s = socket.socket(); s.settimeout(5)
  48:         s.connect((ip, 23)); time.sleep(1.2)
  49:         try: s.recv(4096)
  50:         except OSError: pass
  51:         def until(p, t=5):
  52:             t0 = time.time(); acc = b""
  53:             while time.time() - t0 < t:
  54:                 try:
  55:                     d = s.recv(4096)
  56:                     if d: acc += d
  57:                 except socket.timeout: pass
  58:                 if re.search(p, acc.decode(errors="replace")): return acc.decode(errors="replace")
  59:             return acc.decode(errors="replace")
  60:         until(r"login:"); s.sendall(b"root\n"); time.sleep(0.4); until(r"assword:")
  61:         s.sendall(FACTORY_PW.encode() + b"\n")
  62:         r = until(r"#", 5)
  63:         if "#" not in r:
  64:             s.close(); return False, "telnet登录失败(非出厂口令)"
  65:         def cmd(c):
  66:             s.sendall(c.encode() + b"\n"); time.sleep(0.6)
  67:             return until(r"#", 4)
  68:         macs = cmd("for I in wan ra0; do [ -d /sys/class/net/$I ] && echo $I $(cat /sys/class/net/$I/address); done")
  69:         model = cmd("cat /tmp/sysinfo/model 2>/dev/null | head -1")
  70:         s.close()
  71:         m = dict(re.findall(r"(wan|ra0)\s+([0-9a-f:]+)", macs))
  72:         m = {k.lower(): v.lower() for k, v in m.items()}
  73:         _model = model.strip().splitlines()[-1] if model.strip() else "?"
  74:         info = f"model={_model} wan={m.get('wan','?')} ra0={m.get('ra0','?')}"
  75:         if "MT7981" not in _model and "AX3000" not in _model:
  76:             return False, f"型号不符({_model})——排除（仅刷 JCG AX3000/MT7981）"
  77:         if not m.get("wan"):
  78:             return False, "未取到 WAN MAC——排除（指纹不完整不刷）"
  79:         if _EXACT_MACS:
  80:             if m.get("wan") in _EXACT_MACS or m.get("ra0") in _EXACT_MACS:
  81:                 return False, "现役精确MAC匹配——排除 " + info
  82:         else:
  83:             for pfx in KNOWN_MAC_PREFIXES:
  84:                 if (m.get("wan") or "").startswith(pfx) or (m.get("ra0") or "").startswith(pfx):
  85:                     return False, f"现役前缀MAC匹配({pfx})——排除 " + info
  86:         return True, info
  87:     except Exception as e:
  88:         return False, f"探测异常: {e}"
  89: 
  90: def next_ports(n, start=None):
  91:     """从 DMIT authorized_keys+监听取当前最大 132xx，预分配 n 个连续端口"""
  92:     r = subprocess.run(['ssh','-p','28722','-i','C:/Users/Administrator/.ssh/id_rsa_dmit','-o','IdentitiesOnly=yes',
  93:                         'root@179.255.137.64',
  94:                         "(grep -oE 'permitlisten=\"127.0.0.1:132[0-9]{2}\"' /root/.ssh/authorized_keys; ss -tln | grep -oE '127.0.0.1:132[0-9]{2}') | grep -oE '132[0-9]{2}' | sort -n | tail -1"],
  95:                        capture_output=True, text=True, timeout=30)
  96:     if r.returncode != 0 or not r.stdout.strip():
  97:         print(f"端口分配查询失败（rc={r.returncode}）——中止而非猜测（V9）"); sys.exit(6)
  98:     mx = int(r.stdout.strip())
  99:     base = max(mx + 1, int(start) if start else 13230)
 100:     _ports = [base + i for i in range(n)]
 101:     if _ports[-1] >= 13300:
 102:         print(f"端口池越界（{_ports[-1]}>=13300）——中止（V9）"); sys.exit(6)
 103:     return _ports
 104: 
 105: def next_nums(n):
 106:     """平台现有 SN-R* 最大序号 +1 起取 n 个"""
 107:     r = subprocess.run(['ssh','-p','28722','-i','C:/Users/Administrator/.ssh/id_rsa_dmit','-o','IdentitiesOnly=yes',
 108:                         'root@179.255.137.64',
 109:                         'docker exec routermgmt-db-1 psql -U postgres -d routermgmt -t -c "SELECT name FROM devices WHERE name LIKE \'SN-R%\'"'],
 110:                        capture_output=True, text=True, timeout=30)
 111:     if r.returncode != 0 or not r.stdout.strip():
 112:         print(f"编号分配查询失败（rc={r.returncode}）——中止而非猜测（V9）"); sys.exit(6)
 113:     nums = [int(mm.group(1)) for mm in re.finditer(r"SN-R(\d+)", r.stdout)]
 114:     if not nums:
 115:         print("平台无 SN-R 记录（异常态）——中止（V9）"); sys.exit(6)
 116:     base = max(nums) + 1
 117:     return list(range(base, base + n))
 118: 
 119: def flash_one(ip, num, rssh, log):
 120:     p = subprocess.run([sys.executable, "-u", REPO + r"\scripts\flash-snr.py",
 121:                         "--num", str(num), "--rssh", str(rssh), "--host", ip],
 122:                        capture_output=True, text=True, timeout=1800, cwd=REPO + r"\scripts")
 123:     open(log, "w", encoding="utf-8").write(p.stdout + "\n" + p.stderr)
 124:     ok = p.returncode == 0
 125:     tail = [l for l in p.stdout.splitlines() if l.strip()][-3:]
 126:     return ok, num, ip, rssh, " | ".join(tail)
 127: 
 128: def main():
 129:     ap = argparse.ArgumentParser()
 130:     ap.add_argument("--detect", action="store_true")
 131:     ap.add_argument("--auto", action="store_true", help="无人值守：无设备静默退出")
 132:     ap.add_argument("--max", type=int, default=4, help="单轮最多刷机台数")
 133:     args = ap.parse_args()
 134: 
 135:     # 进程锁（V16：O_CREAT|O_EXCL 原子互斥；90 分钟遗留兜底）
 136:     try:
 137:         _fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
 138:         os.write(_fd, str(time.time()).encode()); os.close(_fd)
 139:     except FileExistsError:
 140:         age = time.time() - os.path.getmtime(LOCK)
 141:         if age < 5400:
 142:             print(f"上一轮刷机仍在进行（锁 {int(age/60)} 分钟前），本轮退出")
 143:             return
 144:         print(f"⚠️ 检测到遗留刷机锁（{int(age/60)} 分钟）——上轮可能挂起，自动解锁续扫（详见 backups/.flash-N*.log）")
 145:         os.remove(LOCK)
 146:         _fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
 147:         os.write(_fd, str(time.time()).encode()); os.close(_fd)
 148: 
 149:     global _EXACT_MACS
 150:     _EXACT_MACS = fleet_exact_macs()
 151:     print(f"现役精确 MAC 集合: {len(_EXACT_MACS)} 条")
 152:     print(f"[{time.strftime('%F %T')}] 扫描出厂态设备（{', '.join(SUBNETS)}.0/24）...")
 153:     found = []
 154:     try:
 155:         for sn in SUBNETS:
 156:             for ip in sweep(sn):
 157:                 isf, info = telnet_fingerprint(ip)
 158:                 print(f"  {ip}: {'✓出厂态' if isf else '跳过'} — {info}")
 159:                 if isf: found.append(ip)
 160:     finally:
 161:         if not found or args.detect:
 162:             os.remove(LOCK)
 163:     if not found:
 164:         print("未发现出厂态设备" + ("（auto 静默退出）" if args.auto else "——请确认设备已上电且 WAN/LAN 已接入两网段之一"))
 165:         return
 166:     if args.detect:
 167:         print(f"共 {len(found)} 台待刷: {found}")
 168:         return
 169:     found = found[:args.max]
 170:     ports = next_ports(len(found))
 171:     nums = next_nums(len(found))
 172:     print(f"刷机分配: {list(zip(found, nums, ports))}（并行）")
 173:     jobs = [(ip, nums[i], ports[i], REPO + rf"\backups\.flash-N{nums[i]}.log") for i, ip in enumerate(found)]
 174:     results = []
 175:     with ThreadPoolExecutor(max_workers=len(jobs)) as ex:
 176:         futs = [ex.submit(flash_one, *j) for j in jobs]
 177:         for f in futs:
 178:             results.append(f.result())
 179:     print(f"\n===== 批量结果 =====")
 180:     for ok, num, ip, rssh, tail in results:
 181:         print(f"  {'✅' if ok else '❌'} SN-R{num} @ {ip} (RSSH {rssh}): {tail}")
 182:     _fails = sum(0 if ok else 1 for ok, *_ in results)
 183:     try: os.remove(LOCK)
 184:     except OSError: pass
 185:     if _fails: sys.exit(1)  # V16：有失败非零退出
