  26: def sweep(subnet, port=23, timeout=1):
  27:     hits = []
  28:     def probe(ip):
  29:         try:
  30:             s = socket.create_connection((ip, port), timeout); s.close(); hits.append(ip)
  31:         except OSError:
  32:             pass
  33:     with ThreadPoolExecutor(max_workers=64) as ex:
  34:         list(ex.map(probe, [f"{subnet}.{i}" for i in range(2, 255)]))
  35:     return sorted(hits)
