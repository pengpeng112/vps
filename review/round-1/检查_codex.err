  19: def md5_crypt(pw, salt):
  20:     """glibc 鍏煎 $1$ MD5-crypt锛堢函 python锛學indows 鏃?crypt 妯″潡锛沷penssl 鍙屽悜閲忚嚜鏍￠獙锛夈€?""
  21:     import hashlib
  22:     ITOA = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
  23:     pwB = pw.encode("utf-8"); saltB = salt.encode("utf-8")
  24:     alt = hashlib.md5(pwB + saltB + pwB).digest()
  25:     ctx = hashlib.md5()
  26:     ctx.update(pwB); ctx.update(b"$1$"); ctx.update(saltB)
  27:     cnt = len(pwB)
  28:     while cnt > 0:
  29:         ctx.update(alt[:min(16, cnt)]); cnt -= 16
  30:     cnt = len(pwB)
  31:     while cnt > 0:
  32:         ctx.update(b"\x00" if (cnt & 1) else pwB[:1])
  33:         cnt >>= 1
  34:     final = ctx.digest()
  35:     for i in range(1000):
  36:         c = hashlib.md5()
  37:         if i % 2: c.update(pwB)
  38:         else:     c.update(final)
  39:         if i % 3: c.update(saltB)
  40:         if i % 7: c.update(pwB)
  41:         if i % 2: c.update(final)
  42:         else:     c.update(pwB)
  43:         final = c.digest()
  44:     def to64(v, n):
  45:         r = ""
  46:         while n > 0:
  47:             r += ITOA[v & 0x3f]; v >>= 6; n -= 1
  48:         return r
  49:     def grp(a, b, c):
  50:         return to64((final[a] << 16) | (final[b] << 8) | final[c], 4)
  51:     return "$1$" + salt + "$" + grp(0,6,12)+grp(1,7,13)+grp(2,8,14)+grp(3,9,15)+grp(4,10,5)+to64(final[11],2)
  52: 
