  60:             return until(r"#", 4)
  61:         macs = cmd("for I in wan ra0; do [ -d /sys/class/net/$I ] && echo $I $(cat /sys/class/net/$I/address); done")
  62:         model = cmd("cat /tmp/sysinfo/model 2>/dev/null | head -1")
  63:         s.close()
