 115: probe_egress() { # 经代理端口探测出口 IP（探测地址可配置）
 116:     if [ -n "${RM_FAKE_HEALTH_FAIL:-}" ]; then return 1; fi
 117:     _t=$(curl $CURL_OPTS -x "http://$PROXY_PORT" "$EGRESS_CHECK_URL" 2>/dev/null) || return 1
 118:     # ip= 行优先（cloudflare trace）；否则按纯文本回显（本地 fake 探测服务）
 119:     _ip=$(printf '%s\n' "$_t" | awk -F= '/^ip=/{print $2}' | head -n1)
 120:     if [ -z "$_ip" ]; then
 121:         _lines=$(printf '%s\n' "$_t" | grep -c .)
 122:         [ "$_lines" = "1" ] && _ip="$_t"
 123:     fi
 124:     [ -n "$_ip" ] || return 1
 125:     echo "$_ip"
 126: }
 127: 
 128: probe_cn_direct() { # 国内直连（不经代理端口）
 129:     # 真机注意：透明重定向只覆盖 LAN 客户端（prerouting br-lan），本机流量不进核心，
 130:     # 而本机 DNS 会拿到 fake-ip（198.18.x.x 无路由）→ 本机 curl 国内站必失败。
 131:     # 改用「向国内公共 DNS 解析」验证国内直连链路，公共 DNS IP 可用 RM_CN_DNS 覆盖。
 132:     if [ -n "${RM_FAKE_HEALTH_FAIL:-}" ]; then return 1; fi
 133:     nslookup "${CN_CHECK_HOST:-www.baidu.com}" "${RM_CN_DNS:-223.5.5.5}" >/dev/null 2>&1 && return 0
 134:     curl $CURL_OPTS -o /dev/null "$CN_CHECK_URL" 2>/dev/null
 135: }
 136: 
 137: probe_mgmt() { # 管理 HTTPS 连通（WG 面）
 138:     _url="${RM_MGMT_CHECK_URL:-$MGMT_URL/api/v1/health}"
 139:     curl $CURL_OPTS -o /dev/null "$_url" 2>/dev/null
 140: }
