  34: // 支持的节点协议（nodes.Proto 存量数据为空串，按 vless-reality 处理）
  35: const (
  36: 	ProtoVLESS   = "vless-reality"
  37: 	ProtoVLESSWS = "vless-ws" // 2026-10-30：Cloudflare CDN 中转（WS+TLS，host=CF 边缘 IPv4，SNI/Host=域名）
  38: 	ProtoHy2     = "hysteria2"
  39: )
  40: 
  41: // ValidHy2Password hysteria2 密码校验（节点 API 与渲染共用同一规则）。
  42: func ValidHy2Password(pw string) bool { return reHy2Password.MatchString(pw) }
  43: 
  44: // NodeRender 参与渲染的节点（已从 AES-GCM 信封解出参数）。
  45: type NodeRender struct {
  46: 	ID       int64
  47: 	Name     string
  48: 	Proto    string // vless-reality | vless-ws | hysteria2（空串= vless-reality）
  49: 	Host     string
  50: 	Port     int
  51: 	UUID     string
  52: 	PBK      string
  53: 	SNI      string
  54: 	SID      string
  55: 	Flow     string
  56: 	FP       string
  57: 	Password string // hysteria2
  58: 	WSPath   string // vless-ws：WebSocket 路径
  59: 	WSHost   string // vless-ws：Host 头（空=SNI）
  60: }
  61: 
  62: // RenderInput 渲染输入。
  63: type RenderInput struct {
  64: 	DeviceID      string
  65: 	Nodes         []NodeRender // 按优先级排序，第一个为 primary
  66: 	MgmtDirectIPs []string     // 管理面 WG endpoint 等需直连的 IPv4
  67: 	// 机场订阅兜底（2026-10-31 第4层）：AirportSubURL 非空时渲染 proxy-providers
  68: 	// 与 AIRPORT(url-test) 组；AirportGeneration 为缓存代次（换机场时递增，g01→g02）
  69: 	AirportSubURL     string
  70: 	AirportGeneration string
  71: }
  72: 
  73: // ValidateNodeName 校验节点名可安全嵌入 YAML/任务参数。
  74: func ValidateNodeName(name string) bool { return reNodeName.MatchString(name) }
  75: 
  76: // validateHost Session 1 仅支持 IPv4 字面量（域名/IPv6 在实现解析与直连规则前拒绝）。
  77: func validateHost(host string) error {
  78: 	ip := net.ParseIP(host)
  79: 	if ip == nil || ip.To4() == nil || strings.Contains(host, ":") {
  80: 		return fmt.Errorf("节点 host %q 不是 IPv4 字面量：Session 1 仅支持 IPv4，域名/IPv6 需先实现解析与对应直连规则", host)
  81: 	}
  82: 	return nil
  83: }
  84: 
  85: // Render 生成设备订阅 YAML（原始字节，含凭据；随后必须签名，禁止改动）。
  86: func Render(in RenderInput) ([]byte, error) {
  87: 	if len(in.Nodes) == 0 {
  88: 		return nil, errors.New("没有可用的绑定节点，拒绝生成配置")
  89: 	}
  90: 	var proxies, groupProxy, groupAuto, directRules, mediaMembers []string
  91: 	for _, n := range in.Nodes {
  92: 		if !ValidateNodeName(n.Name) {
  93: 			return nil, fmt.Errorf("节点名 %q 不合法（仅允许字母数字与 - _，长度 2~32）", n.Name)
  94: 		}
  95: 		if err := validateHost(n.Host); err != nil {
  96: 			return nil, err
  97: 		}
  98: 		if n.Port < 1 || n.Port > 65535 {
  99: 			return nil, fmt.Errorf("节点 %s 端口不合法", n.Name)
 100: 		}
 101: 		switch n.Proto {
 102: 		case "", ProtoVLESS:
 103: 			if err := renderVLESS(&n, &proxies); err != nil {
 104: 				return nil, err
 105: 			}
 106: 		case ProtoVLESSWS:
 107: 			if err := renderVLESSWS(&n, &proxies); err != nil {
 108: 				return nil, err
 109: 			}
 110: 		case ProtoHy2:
 111: 			if !ValidHy2Password(n.Password) {
 112: 				return nil, fmt.Errorf("节点 %s hysteria2 密码不合法（需 16~64 位字母数字/-_）", n.Name)
 113: 			}
 114: 			// 服务端自签证书（内部管理面使用），客户端跳过证书校验，接入靠密码鉴权
 115: 			proxies = append(proxies, fmt.Sprintf(`  - name: "%s"
 116:     type: hysteria2
 117:     server: %s
 118:     port: %d
 119:     password: %s
 120:     udp: true
 121:     skip-cert-verify: true`, n.Name, n.Host, n.Port, n.Password))
 122: 		default:
 123: 			return nil, fmt.Errorf("节点 %s 协议 %q 不支持（当前仅 vless-reality / vless-ws / hysteria2）", n.Name, n.Proto)
 124: 		}
 125: 		groupProxy = append(groupProxy, fmt.Sprintf("      - %s", n.Name))
 126: 		groupAuto = append(groupAuto, fmt.Sprintf("      - %s", n.Name))
 127: 		if strings.Contains(n.Name, "LAX") {
 128: 			mediaMembers = append(mediaMembers, fmt.Sprintf("      - %s", n.Name))
 129: 		}
 130: 		// 节点自身公网 IP 直连：不做这条，TUN 会把 SSH 绕回节点（§3.1）
 131: 		directRules = append(directRules, fmt.Sprintf("  - IP-CIDR,%s/32,DIRECT,no-resolve", n.Host))
 132: 	}
 133: 	// 管理面 WG endpoint 直连，避免 WG 套入代理（§3.2 末段）
 134: 	for _, ip := range in.MgmtDirectIPs {
 135: 		if err := validateHost(ip); err != nil {
 136: 			return nil, fmt.Errorf("管理面直连地址 %q 无效: %w", ip, err)
 137: 		}
 138: 		rule := fmt.Sprintf("  - IP-CIDR,%s/32,DIRECT,no-resolve", ip)
 139: 		if !containsStr(directRules, rule) {
 140: 			directRules = append(directRules, rule)
 141: 		}
 142: 	}
 143: 
 144: 	// include-all does not include other groups. Always append an explicit fallback.
 145: 	mediaMembers = append(mediaMembers, "      - NODE-PICK")
 146: 
 147: 	// 机场订阅兜底（第4层）：URL 非空时注入 provider/组/链位
