 142: # ---- 事务 ----
 143: txn_dir_for() { echo "$STATE_DIR/txn/$1"; }
 144: 
 145: verify_config_signature() { # $1 yaml 文件 $2 版本 $3 签名 hex
 146:     _yaml="$1"; _ver="$2"; _sig="$3"
 147:     [ -s "${SIGN_PUB_FILE:-/etc/routermgmt/sign_pub.pem}" ] || return 1
 148:     _hash=$(openssl dgst -sha256 -hex "$_yaml" | awk '{print $NF}')
 149:     # 签名原文：字段间 LF、末尾无 LF（§7.5）
 150:     printf '%s\n%s\n%s' "$_hash" "$DEVICE_ID" "$_ver" > "$STATE_DIR/sigpayload.$$"
 151:     # hex→二进制：busybox awk 的 printf "%c",0 会丢弃 0x00 字节——Ed25519 签名约 1/4 概率含零字节，
 152:     # 曾导致验签随机失败（2026-09-25 实锤：同管线 v2/v4 成功、v3 失败）。
 153:     # 改用 ash printf \xHH 逐对生成（实测含 NUL 二进制安全，写文件重定向可靠）。
 154:     _sighex=$(printf '%s' "$_sig" | tr 'A-F' 'a-f')
 155:     : > "$STATE_DIR/sig.bin.$$"
 156:     while [ -n "$_sighex" ]; do
 157:         printf "\\x${_sighex%"${_sighex#??}"}" >> "$STATE_DIR/sig.bin.$$"
 158:         _sighex="${_sighex#??}"
 159:     done
 160:     # 旧固件（如 SN-R1 的 OpenWrt 21.02）openssl 1.1.1 无 -rawin；部署了 openssl3 则优先用
 161:     _ossl="${VERIFY_OPENSSL:-openssl}"
 162:     [ -x /usr/bin/openssl-mgmt ] && { _ossl=/usr/bin/openssl-mgmt; export LD_LIBRARY_PATH="/usr/lib/mgmt-ssl:${LD_LIBRARY_PATH:-}"; }
 163:     "$_ossl" pkeyutl -verify -pubin -inkey "${SIGN_PUB_FILE:-/etc/routermgmt/sign_pub.pem}" \
 164:         -rawin -in "$STATE_DIR/sigpayload.$$" -sigfile "$STATE_DIR/sig.bin.$$" >/dev/null 2>&1
 165:     _rc=$?
 166:     unset LD_LIBRARY_PATH
 167:     rm -f "$STATE_DIR/sigpayload.$$" "$STATE_DIR/sig.bin.$$"
 168:     return $_rc
 169: }
 170: 
 171: accepted_version_read() {
 172:     [ -f "$STATE_DIR/accepted_version" ] && cat "$STATE_DIR/accepted_version" 2>/dev/null || echo 0
 173: }
 174: 
 175: txn_rollback() { # $1 事务目录 → 恢复备份与选择状态；返回 0=恢复成功
 176:     _d="$1"
 177:     _active=$(sed -n 1p "$_d/backup.meta")
 178:     _oldsel=$(sed -n 2p "$_d/backup.meta")
 179:     [ -s "$_d/backup.yaml" ] && [ -n "$_active" ] || return 1
 180:     cp "$_d/backup.yaml" "$_active" || return 1
 181:     oc_reload "$_active" || return 1
 182:     wait_api_ready || true
 183:     [ -n "$_oldsel" ] && [ "$_oldsel" != "null" ] && oc_set_group PROXY "$_oldsel"
 184:     # 恢复校验：配置文件哈希与备份一致
 185:     _h1=$(openssl dgst -sha256 -hex "$_active" | awk '{print $NF}')
 186:     _h2=$(openssl dgst -sha256 -hex "$_d/backup.yaml" | awk '{print $NF}')
 187:     [ "$_h1" = "$_h2" ] || return 1
 188:     return 0
 189: }
 190: 
 191: txn_recover_all() {
 192:     # 启动恢复：发现未提交事务 → 恢复备份并补报 rolled_back（§7.5 第 7 步）
 193:     [ -d "$STATE_DIR/txn" ] || return 0
 194:     for _d in "$STATE_DIR/txn"/*; do
 195:         [ -d "$_d" ] || continue
 196:         [ -f "$_d/uncommitted" ] || { rm -rf "$_d"; continue; }
 197:         _tid=$(cat "$_d/task_id" 2>/dev/null)
 198:         _lease=$(cat "$_d/lease_id" 2>/dev/null)
 199:         log "recover: 发现未提交事务 $_tid，执行回滚"
 200:         if txn_rollback "$_d"; then
 201:             [ -n "$_tid" ] && persist_result "$_tid" "${_lease:-}" rolled_back '{"error":"agent restarted during apply, restored backup"}'
 202:             echo "rolled_back" > "$_d/final"
 203:         else
 204:             [ -n "$_tid" ] && persist_result "$_tid" "${_lease:-}" failed '{"error":"agent restarted during apply","rollback_failed":true}'
 205:             echo "rollback_failed" > "$_d/final"
 206:         fi
 207:         rm -f "$_d/uncommitted"
 208:     done
 209:     return 0
 210: }
 211: 
 212: task_apply_config() { # $1 任务 JSON（switch_node / reload_proxy）
 213:     _tj="$1"
 214:     _tid=$(json_str "$_tj" '$.task_id')
 215:     _type=$(json_str "$_tj" '$.type')
 216:     _lease=$(json_str "$_tj" '$.lease_id')
 217:     _ver=$(json_str "$_tj" '$.config_version')
 218:     _sha=$(json_str "$_tj" '$.config_sha256')
 219:     _sig=$(json_str "$_tj" '$.signature')
 220:     _curl_url=$(json_str "$_tj" '$.config_url')
 221:     _node=$(json_str "$_tj" '$.params.node_name')
 222:     _expect=$(json_str "$_tj" '$.params.expect_exit_ip')
 223:     _deadline=$(json_str "$_tj" '$.deadline')
 224: 
 225:     _fail() { persist_result "$_tid" "$_lease" failed "{\"error\":\"$1\"}"; mv -f "$(txn_dir_for "$_tid")" "$STATE_DIR/txn-debug" 2>/dev/null; return 0; }
 226: 
 227:     # 0. 幂等：同任务已有最终结果只重传（§7.5）
 228:     if [ -f "$STATE_DIR/results/$_tid.json" ]; then
 229:         log "task $_tid 已有结果，仅重传"
 230:         return 0
 231:     fi
 232: 
 233:     _dir=$(oc_config_dir) || { _fail "未找到 OpenClash 配置目录（尝试过 /etc/openclash/config /etc/clash；RM_CLASH_DIR 可覆盖）"; return 0; }
 234:     _active=$(oc_active_config) || { _fail "未找到活动配置文件"; return 0; }
 235: 
 236:     # 防重放高水位：版本必须高于已接受版本（本地恢复允许回旧活动版本但保留最高已接受，§7.5）
 237:     _acc=$(accepted_version_read)
 238:     case "$_acc" in ''|*[!0-9]*) _acc=0 ;; esac
 239:     if [ -n "$_ver" ] && [ "$_ver" -le "$_acc" ] 2>/dev/null; then
 240:         persist_result "$_tid" "$_lease" ok "{\"skipped\":true,\"accepted_version\":$_acc}"
 241:         return 0
 242:     fi
 243: 
 244:     _txn=$(txn_dir_for "$_tid")
 245:     rm -rf "$_txn"; mkdir -p "$_txn"
 246:     echo "$_tid" > "$_txn/task_id"; echo "$_lease" > "$_txn/lease_id"
 247: 
 248:     # 1. 下载指定不可变版本（同文件系统临时文件 600）
 249:     _rpath=$(printf '%s' "$_curl_url" | sed 's|^[a-zA-Z][a-zA-Z0-9+.-]*://[^/]*||')
 250:     case "$_rpath" in /api/v1/agent/configs/*) ;; *) { _fail "非法配置下载路径"; return 0; } ;; esac
 251:     : > "$_txn/new.yaml"
 252:     chmod 600 "$_txn/new.yaml"
 253:     _code=$(api_call GET "$_rpath" /dev/null "$_txn/new.yaml")
 254:     [ "$_code" = "200" ] || { _fail "配置下载失败 http=$_code"; return 0; }
 255:     [ -s "$_txn/new.yaml" ] || { _fail "配置内容为空"; return 0; }
 256: 
 257:     # 设备/版本/哈希/签名校验
 258:     _gotsha=$(openssl dgst -sha256 -hex "$_txn/new.yaml" | awk '{print $NF}')
 259:     { [ -z "$_sha" ] || [ "$_gotsha" = "$_sha" ]; } || { _fail "配置哈希不匹配"; return 0; }
 260:     [ -n "$_ver" ] || { _fail "缺少 config_version"; return 0; }
 261:     verify_config_signature "$_txn/new.yaml" "$_ver" "$_sig" || { _fail "配置签名验证失败（拒绝应用）"; return 0; }
 262: 
 263:     # 2. 核心校验
 264:     mihomo_validate "$_txn/new.yaml" || { _fail "mihomo 配置校验失败"; return 0; }
 265: 
 266:     # 3. 备份当前配置 + 活动路径 + PROXY 选择状态；落盘事务并启动看门狗
 267:     cp "$_active" "$_txn/backup.yaml"
 268:     _oldsel=$(oc_get_group PROXY)
 269:     printf '%s\n%s\n' "$_active" "$_oldsel" > "$_txn/backup.meta"
 270:     echo "backup_done" > "$_txn/phase"
 271:     touch "$_txn/uncommitted"
 272:     (
 273:         _wd=${RM_WATCHDOG_SEC:-100}
 274:         sleep "$_wd"
 275:         if [ -f "$_txn/uncommitted" ]; then
 276:             log "watchdog: 事务 $_tid 超时未提交，回滚"
 277:             txn_rollback "$_txn" && echo "rolled_back" > "$_txn/final" || echo "rollback_failed" > "$_txn/final"
 278:             rm -f "$_txn/uncommitted"
 279:         fi
 280:     ) &
 281:     echo $! > "$_txn/watchdog.pid"
 282: 
 283:     # 4. 原子替换 + 加载 + 强制 PROXY 指向目标节点（避免 AUTO/持久化旧选择）
 284:     if ! cp "$_txn/new.yaml" "${_active}.routermgmt.tmp"; then
 285:         kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
 286:         _fail "写临时配置失败"
 287:         return 0
 288:     fi
 289:     chmod 644 "${_active}.routermgmt.tmp"
 290:     if ! mv "${_active}.routermgmt.tmp" "$_active"; then
 291:         kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
 292:         _fail "原子替换失败"
 293:         return 0
 294:     fi
 295:     echo "replaced" > "$_txn/phase"
 296:     oc_reload "$_active" || {
 297:         _rb=1
 298:     }
 299:     wait_api_ready || { _rb=1; }
 300:     sleep 3  # DNS/fake-ip 缓存重载后的收敛等待，避免探针误判
 301:     if [ "${_rb:-0}" = "1" ]; then
 302:         # 应用失败 → 回滚
 303:         kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
 304:         if txn_rollback "$_txn"; then
 305:             rm -f "$_txn/uncommitted"; echo "rolled_back" > "$_txn/final"
 306:             persist_result "$_tid" "$_lease" rolled_back '{"error":"reload failed, restored backup"}'
 307:         else
 308:             rm -f "$_txn/uncommitted"; echo "rollback_failed" > "$_txn/final"
 309:             persist_result "$_tid" "$_lease" failed '{"error":"reload failed","rollback_failed":true}'
 310:         fi
 311:         return 0
 312:     fi
 313:     if [ "$_type" = "switch_node" ] && [ -n "$_node" ]; then
 314:         oc_set_group PROXY "$_node"
 315:     fi
 316: 
 317:     # 5. 健康检查：出口（固定 IP 节点两次一致）+ 国内直连 + 管理面连通
 318:     _healthy=1; _egress_ip=""
 319:     if [ -n "$_expect" ]; then
 320:         _p1=$(probe_egress) || _healthy=0
 321:         _p2="" ; [ "$_healthy" = "1" ] && { _p2=$(probe_egress) || _healthy=0; }
 322:         [ "$_healthy" = "1" ] && [ "$_p1" = "$_p2" ] && [ "$_p1" = "$_expect" ] || _healthy=0
 323:         _egress_ip=$_p1
 324:     else
 325:         _egress_ip=$(probe_egress) || _healthy=0
 326:     fi
 327:     [ "$_healthy" = "1" ] && { probe_cn_direct || { sleep 3; probe_cn_direct || { _healthy=0; echo "cn_direct failed x2 $(date +%T)" > "$STATE_DIR/health.log"; }; }; }
 328:     [ "$_healthy" = "1" ] && { probe_mgmt || { _healthy=0; echo "mgmt failed $(date +%T)" > "$STATE_DIR/health.log"; }; }
 329: 
 330:     # Restore automatic failover before committing, with the transaction watchdog
 331:     # still armed. Failure follows the existing rollback path below.
 332:     _grp=$(oc_get_group PROXY)
 333:     if [ "$_healthy" = "1" ] && [ "$_type" = "switch_node" ] && [ -n "$_node" ]; then
 334:         oc_set_group PROXY AUTO || _healthy=0
 335:         sleep 1
 336:         _grp=$(oc_get_group PROXY)
 337:         [ "$_grp" = "AUTO" ] || _healthy=0
 338:         [ "$_healthy" = "1" ] && { _egress_ip=$(probe_egress) || _healthy=0; }
 339:     fi
 340: 
 341:     if [ "$_healthy" != "1" ]; then
 342:         # 7. 健康检查失败 → 回滚（先备份/选择状态恢复，验证成功才报 rolled_back）
 343:         kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
 344:         if txn_rollback "$_txn"; then
 345:             rm -f "$_txn/uncommitted"; echo "rolled_back" > "$_txn/final"
 346:             persist_result "$_tid" "$_lease" rolled_back "{\"error\":\"health check failed\",\"exit_ip\":\"$_egress_ip\"}"
 347:         else
 348:             rm -f "$_txn/uncommitted"; echo "rollback_failed" > "$_txn/final"
 349:             persist_result "$_tid" "$_lease" failed '{"error":"health check failed","rollback_failed":true}'
 350:         fi
 351:         return 0
 352:     fi
 353: 
 354:     # 6. 提交：取消看门狗、更新最高已接受版本、持久化结果、回报 ok
 355:     kill "$(cat "$_txn/watchdog.pid" 2>/dev/null)" 2>/dev/null
 356:     rm -f "$_txn/uncommitted"
 357:     echo "committed" > "$_txn/final"
 358:     if [ -n "$_ver" ] && [ "$_ver" -gt "$_acc" ]; then
 359:         echo "$_ver" > "$STATE_DIR/accepted_version"
 360:     fi
 361: 	persist_result "$_tid" "$_lease" ok "{\"exit_ip\":\"$_egress_ip\",\"version\":$_ver,\"proxy_group\":\"$_grp\"}"
 362: 	log "task $_tid committed version=$_ver exit=$_egress_ip"
 363: 	reapply_runtime_modes
 364: 	return 0
 365: }
 366: 
 367: # set_proxy_state：远程停用/启用 VPS 代理（不动配置文件，只切 PROXY 组选择）。
 368: # 停用=PROXY→DIRECT（全部流量直连，VPS 闲置）；启用=PROXY→AUTO（恢复 url-test 自动选节点）。
 369: # 选择经 profile.store-selected 持久化，核心重启后状态保持。
 370: task_set_proxy_state() {
 371: 	_tj="$1"
 372: 	_tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 373: 	_en=$(json_str "$_tj" '$.params.enabled')
 374: 	case "$_en" in
 375: 		true|false) ;;
 376: 		*) persist_result "$_tid" "$_lease" failed '{"error":"invalid params.enabled"}'; return ;;
 377: 	esac
 378: 	_target="DIRECT"; [ "$_en" = "true" ] && _target="AUTO"
 379: 	oc_set_group PROXY "$_target"
 380: 	sleep 2
 381: 	_now=$(oc_get_group PROXY)
 382: 	if [ "$_now" = "$_target" ]; then
 383: 		persist_result "$_tid" "$_lease" ok "{\"group_now\":\"$_now\",\"enabled\":$_en}"
 384: 		log "task $_tid proxy enabled=$_en group=$_now"
 385: 	else
 386: 		persist_result "$_tid" "$_lease" failed "{\"error\":\"group not applied\",\"group_now\":\"$_now\",\"want\":\"$_target\"}"
 387: 		log "task $_tid FAILED group_now=$_now want=$_target"
 388: 	fi
 389: 	return 0
 390: }
 391: 
 392: # agent_update：远程升级 agent 自身（2026-09-18）。
 393: # 流程：HMAC 下载签名包 → Ed25519 验签（与配置验签同构）→ sh -n 语法门禁 →
 394: #       备份当前文件 → 原子替换 → 上报 ok → 延迟重启服务（新进程由 procd 拉起）。
 395: # 回滚：tar 还原 agent-bak-*.tar.gz 到 /etc/routermgmt 后 /etc/init.d/routermgmt restart。
 396: task_agent_update() {
 397:     _tj="$1"
 398:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 399:     _ver=$(json_str "$_tj" '$.params.version')
 400:     _af_fail() { persist_result "$_tid" "$_lease" failed "{\"error\":\"$1\",\"version\":\"$_ver\"}"; log "task $_tid agent_update FAILED: $1"; return 0; }
 401:     case "$_ver" in ''|*[!0-9]*) _af_fail "invalid version" ; return ;; esac
 402: 
 403:     _bundle="$STATE_DIR/agent-$_ver.tar.gz"
 404:     _hdr="$STATE_DIR/bundle-$_ver.hdr"
 405:     rm -f "$_bundle" "$_hdr"
 406:     RM_HDR_FILE="$_hdr" api_call GET "/api/v1/agent/bundles/$_ver" /dev/null "$_bundle" > "$STATE_DIR/bundle.code"
 407:     _code=$(cat "$STATE_DIR/bundle.code" 2>/dev/null)
 408:     [ "$_code" = "200" ] || { _af_fail "download http=$_code" ; return; }
 409:     [ -s "$_bundle" ] || { _af_fail "empty bundle" ; return; }
 410:     _sig=$(grep -i '^X-Signature:' "$_hdr" 2>/dev/null | tail -n1 | tr -d '\r' | awk '{print $2}')
 411:     case "$_sig" in ''|*[!0-9a-fA-F]*) _af_fail "no signature header" ; return ;; esac
 412: 
 413:     verify_config_signature "$_bundle" "$_ver" "$_sig" || { _af_fail "signature verify failed" ; return; }
 414: 
 415:     _stage="/tmp/agentupd.$$"
 416:     rm -rf "$_stage"; mkdir -p "$_stage"
 417:     tar -xzf "$_bundle" -C "$_stage" 2>/dev/null || { rm -rf "$_stage"; _af_fail "extract failed" ; return; }
 418:     _na="$_stage/routermgmt-agent.sh"; _nh="$_stage/handlers/switch_node.sh"; _ni="$_stage/init/routermgmt"
 419:     { [ -f "$_na" ] && [ -f "$_nh" ]; } || { rm -rf "$_stage"; _af_fail "bundle layout unexpected" ; return; }
 420:     sh -n "$_na" 2>/dev/null || { rm -rf "$_stage"; _af_fail "agent.sh syntax check failed" ; return; }
 421:     sh -n "$_nh" 2>/dev/null || { rm -rf "$_stage"; _af_fail "handlers syntax check failed" ; return; }
 422:     [ ! -f "$_ni" ] || sh -n "$_ni" 2>/dev/null || { rm -rf "$_stage"; _af_fail "init syntax check failed" ; return; }
 423:     [ ! -f "$_stage/access-fw.sh" ] || sh -n "$_stage/access-fw.sh" 2>/dev/null || { rm -rf "$_stage"; _af_fail "access-fw syntax check failed" ; return; }
 424: 
 425:     _bak="/etc/routermgmt/agent-bak-$(date +%Y%m%d%H%M%S).tar.gz"
 426:     tar -czf "$_bak" -C /etc/routermgmt routermgmt-agent.sh handlers access-fw.sh 2>/dev/null
 427:     cp "$_na" /etc/routermgmt/routermgmt-agent.sh.new
 428:     cp "$_nh" /etc/routermgmt/handlers/switch_node.sh.new
 429:     chmod 700 /etc/routermgmt/routermgmt-agent.sh.new
 430:     chmod 600 /etc/routermgmt/handlers/switch_node.sh.new
 431:     sync
 432:     mv -f /etc/routermgmt/routermgmt-agent.sh.new /etc/routermgmt/routermgmt-agent.sh
 433:     mv -f /etc/routermgmt/handlers/switch_node.sh.new /etc/routermgmt/handlers/switch_node.sh
 434:     cp /etc/routermgmt/routermgmt-agent.sh /usr/bin/routermgmt-agent && chmod 755 /usr/bin/routermgmt-agent
 435:     if [ -f "$_stage/access-fw.sh" ]; then
 436:         cp "$_stage/access-fw.sh" /etc/routermgmt/access-fw.sh && chmod 755 /etc/routermgmt/access-fw.sh
 437:     fi
 438:     if [ -f "$_ni" ]; then
 439:         cp "$_ni" /etc/init.d/routermgmt.new && chmod 755 /etc/init.d/routermgmt.new             && mv -f /etc/init.d/routermgmt.new /etc/init.d/routermgmt
 440:         /etc/init.d/routermgmt enable >/dev/null 2>&1
 441:     fi
 442:     rm -rf "$_stage"
 443: 
 444:     persist_result "$_tid" "$_lease" ok "{\"version\":\"$_ver\",\"backup\":\"$(basename "$_bak")\"}"
 445:     log "task $_tid agent_update ok ver=$_ver backup=$(basename "$_bak"), restarting in 3s"
 446:     flush_pending_results
 447:     ( sleep 3; /etc/init.d/routermgmt restart ) >/dev/null 2>&1 &
 448:     return 0
 449: }
 450: 
 451: # repair_mgmt_tunnel：VPS 侧 mgmt-rssh-probe 探测到 -R 排障口丢失时下发的白名单修复任务
 452: # （2026-09-24 阶段1C）。只允许重启本机 mgmt-tunnel 服务；不接受任何参数命令。
 453: # 立即重启会切断本任务结果上报所走的 -L 心跳通道，故延迟 2s 后台执行。
 454: task_repair_mgmt_tunnel() {
 455:     _tj="$1"
 456:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 457:     if [ ! -x /etc/init.d/mgmt-tunnel ]; then
 458:         persist_result "$_tid" "$_lease" failed '{"error":"mgmt-tunnel not installed"}'
 459:         return 0
 460:     fi
 461:     _before=$(pgrep -f 'id_dropbear_mgmt' 2>/dev/null | wc -l)
 462:     ( sleep 2; /etc/init.d/mgmt-tunnel restart ) >/dev/null 2>&1 &
 463:     persist_result "$_tid" "$_lease" ok "{\"restarted\":true,\"instances_before\":$_before}"
 464:     log "task $_tid repair_mgmt_tunnel: restart dispatched (instances_before=$_before)"
 465:     return 0
 466: }
 467: 
 468: # ---- 策略落地：VPS 限速 / 定时重启 / 授权关停（国内直连不限）----
 469: # 只处理 IPv4 点分地址；限速打在本机 input/output（mihomo 本地出站），不碰 LAN→CN。
 470: 
 471: _valid_v4() {
 472:     case "$1" in
 473:         *[!0-9.]*|'') return 1 ;;
 474:     esac
 475:     echo "$1" | awk -F. 'NF==4 && $1>=0 && $1<=255 && $2>=0 && $2<=255 && $3>=0 && $3<=255 && $4>=0 && $4<=255 {ok=1} END{exit ok?0:1}'
 476: }
 477: 
 478: _valid_reboot_cron() {
 479:     case "$1" in
 480:         ''|'0 0 * * *'|'0 8 * * *'|'0 */8 * * *'|'0 */12 * * *') return 0 ;;
 481:         *) return 1 ;;
 482:     esac
 483: }
 484: 
 485: apply_vps_qos_ipt() { # 无 nft 的设备（SN-R1）：只限制本机访问 VPS:443
 486:     _act="$1"; _kbps="$2"; _host="$3"
 487:     iptables -D OUTPUT -j VPS_QOS 2>/dev/null
 488:     iptables -D INPUT -j VPS_QOS_IN 2>/dev/null
 489:     iptables -F VPS_QOS 2>/dev/null
 490:     iptables -X VPS_QOS 2>/dev/null
 491:     iptables -F VPS_QOS_IN 2>/dev/null
 492:     iptables -X VPS_QOS_IN 2>/dev/null
 493:     _valid_v4 "$_host" || return 0
 494:     iptables -N VPS_QOS
 495:     iptables -N VPS_QOS_IN
 496:     iptables -I OUTPUT 1 -j VPS_QOS
 497:     iptables -I INPUT 1 -j VPS_QOS_IN
 498:     if [ "$_act" = "false" ]; then
 499:         iptables -A VPS_QOS -d "$_host" -p tcp --dport 443 -j DROP
 500:         iptables -A VPS_QOS_IN -s "$_host" -p tcp --sport 443 -j DROP
 501:         return 0
 502:     fi
 503:     case "$_kbps" in ''|0|*[!0-9]*) return 0 ;; esac
 504:     _kbytes=$(( _kbps / 8 ))
 505:     [ "$_kbytes" -lt 1 ] && _kbytes=1
 506:     iptables -A VPS_QOS -d "$_host" -p tcp --dport 443 -m hashlimit \
 507:         --hashlimit-name vpsup --hashlimit-mode dstip \
 508:         --hashlimit-above ${_kbytes}kb/s --hashlimit-burst ${_kbytes}kb -j DROP
 509:     iptables -A VPS_QOS_IN -s "$_host" -p tcp --sport 443 -m hashlimit \
 510:         --hashlimit-name vpsdown --hashlimit-mode srcip \
 511:         --hashlimit-above ${_kbytes}kb/s --hashlimit-burst ${_kbytes}kb -j DROP
 512: }
 513: 
 514: apply_vps_qos() { # $1=service_active(true/false) $2=kbps $3=vps_host
 515:     _act="$1"; _kbps="$2"; _host="$3"
 516:     if ! command -v nft >/dev/null 2>&1; then
 517:         apply_vps_qos_ipt "$_act" "$_kbps" "$_host"
 518:         return $?
 519:     fi
 520:     nft delete table inet vps_qos 2>/dev/null || true
 521:     _valid_v4 "$_host" || return 0
 522:     if [ "$_act" = "false" ]; then
 523:         nft -f - <<EOF
 524: table inet vps_qos {
 525:   chain output {
 526:     type filter hook output priority 0; policy accept;
 527:     ip daddr $_host tcp dport 443 counter drop
 528:   }
 529:   chain input {
 530:     type filter hook input priority 0; policy accept;
 531:     ip saddr $_host tcp sport 443 counter drop
 532:   }
 533: }
 534: EOF
 535:         return 0
 536:     fi
 537:     case "$_kbps" in ''|0|*[!0-9]*) return 0 ;; esac
 538:     [ "$_kbps" -gt 0 ] 2>/dev/null || return 0
 539:     _kbytes=$(( _kbps / 8 ))
 540:     [ "$_kbytes" -lt 1 ] && _kbytes=1
 541:     nft -f - <<EOF
 542: table inet vps_qos {
 543:   chain output {
 544:     type filter hook output priority 0; policy accept;
 545:     ip daddr $_host tcp dport 443 limit rate over ${_kbytes} kbytes/second counter drop
 546:   }
 547:   chain input {
 548:     type filter hook input priority 0; policy accept;
 549:     ip saddr $_host tcp sport 443 limit rate over ${_kbytes} kbytes/second counter drop
 550:   }
 551: }
 552: EOF
 553: }
 554: 
 555: apply_reboot_cron() { # $1=crontab 五行或空
 556:     _cron="$1"
 557:     _valid_reboot_cron "$_cron" || return 1
 558:     _cf=/etc/crontabs/root
 559:     mkdir -p /etc/crontabs
 560:     touch "$_cf"
 561:     if [ -f "$_cf" ]; then
 562:         grep -v '#routermgmt-reboot' "$_cf" > "$_cf.tmp" 2>/dev/null || : > "$_cf.tmp"
 563:         mv -f "$_cf.tmp" "$_cf"
 564:     fi
 565:     [ -n "$_cron" ] && echo "$_cron /sbin/reboot #routermgmt-reboot" >> "$_cf"
 566:     /etc/init.d/cron restart >/dev/null 2>&1 || true
 567:     return 0
 568: }
 569: 
 570: apply_proxy_mode() { # $1=rule|global|direct  $2=service_active
 571:     _m="$1"; _sa="$2"
 572:     [ "$_sa" = "false" ] && _m=direct
 573:     case "$_m" in rule|global|direct) ;; *) _m=rule ;; esac
 574:     printf '%s\n' "$_m" > "$STATE_DIR/proxy.mode"
 575:     curl $CURL_OPTS -o /dev/null -X PATCH -H 'Content-Type: application/json' \
 576:         --data-binary "{\"mode\":\"$_m\"}" "http://$MIHOMO_API/configs" 2>/dev/null || true
 577:     for _f in /etc/mihomo/run.yaml /etc/mihomo/config.yaml; do
 578:         [ -f "$_f" ] && sed -i "s/^mode: .*/mode: $_m/" "$_f" 2>/dev/null || true
 579:     done
 580: }
 581: 
 582: apply_access_ctl() { # $1=mode $2=list
 583:     _am="$1"; _al="$2"
 584:     case "$_am" in all|whitelist|blacklist) ;; *) _am=all ;; esac
 585:     printf '%s\n' "$_am" > "$STATE_DIR/access.mode"
 586:     printf '%s\n' "$_al" > "$STATE_DIR/access.list"
 587:     if [ -x /etc/routermgmt/access-fw.sh ]; then
 588:         /etc/routermgmt/access-fw.sh
 589:     fi
 590: }
 591: 
 592: reapply_runtime_modes() {
 593:     # 配置热替换/防火墙重装后把运行模式和访问控制再打一遍
 594:     _sa=true
 595:     [ -f "$STATE_DIR/license_forced_direct" ] && _sa=false
 596:     [ -f "$STATE_DIR/proxy.mode" ] && apply_proxy_mode "$(cat "$STATE_DIR/proxy.mode")" "$_sa"
 597:     [ -x /etc/routermgmt/access-fw.sh ] && /etc/routermgmt/access-fw.sh
 598: }
 599: 
 600: apply_policy_fields() { # $1=active $2=kbps $3=cron $4=host $5=proxy_mode $6=access_mode $7=access_list
 601:     _act="$1"; _kbps="$2"; _cron="$3"; _host="$4"
 602:     _pmode="${5:-rule}"; _amode="${6:-all}"; _alist="${7:-}"
 603:     [ -n "$_act" ] || return 0
 604:     case "$_act" in true|false) ;; *) return 0 ;; esac
 605:     case "$_kbps" in ''|*[!0-9]*) _kbps=0 ;; esac
 606:     case "$_pmode" in rule|global|direct) ;; *) _pmode=rule ;; esac
 607:     case "$_amode" in all|whitelist|blacklist) ;; *) _amode=all ;; esac
 608:     _fp="$_act|$_kbps|$_cron|$_host|$_pmode|$_amode|$_alist"
 609:     _old=$(cat "$STATE_DIR/policy.fp" 2>/dev/null || true)
 610:     if [ "$_fp" = "$_old" ]; then
 611:         return 0
 612:     fi
 613:     apply_vps_qos "$_act" "$_kbps" "$_host"
 614:     apply_reboot_cron "$_cron" || true
 615:     apply_proxy_mode "$_pmode" "$_act"
 616:     apply_access_ctl "$_amode" "$_alist"
 617:     if [ "$_act" = "false" ]; then
 618:         echo 1 > "$STATE_DIR/license_forced_direct"
 619:         oc_set_group PROXY DIRECT 2>/dev/null || true
 620:     elif [ -f "$STATE_DIR/license_forced_direct" ]; then
 621:         oc_set_group PROXY AUTO 2>/dev/null || true
 622:         rm -f "$STATE_DIR/license_forced_direct"
 623:     fi
 624:     printf '%s\n' "$_fp" > "$STATE_DIR/policy.fp"
 625:     log "policy applied active=$_act kbps=$_kbps mode=$_pmode access=$_amode cron='$_cron'"
 626: }
 627: 
 628: apply_policy_from_hb() {
 629:     _raw=$(cat "$STATE_DIR/hb.resp" 2>/dev/null) || return 0
 630:     _act=$(json_str "$_raw" '$.policy.service_active')
 631:     [ -n "$_act" ] || return 0
 632:     apply_policy_fields "$_act" \
 633:         "$(json_str "$_raw" '$.policy.vps_limit_kbps')" \
 634:         "$(json_str "$_raw" '$.policy.reboot_cron')" \
 635:         "$(json_str "$_raw" '$.policy.vps_host')" \
 636:         "$(json_str "$_raw" '$.policy.proxy_mode')" \
 637:         "$(json_str "$_raw" '$.policy.access_mode')" \
 638:         "$(json_str "$_raw" '$.policy.access_list')"
 639: }
 640: 
 641: task_apply_policy() {
 642:     _tj="$1"
 643:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 644:     _act=$(json_str "$_tj" '$.params.service_active')
 645:     _kbps=$(json_str "$_tj" '$.params.vps_limit_kbps')
 646:     _cron=$(json_str "$_tj" '$.params.reboot_cron')
 647:     _host=$(json_str "$_tj" '$.params.vps_host')
 648:     _pmode=$(json_str "$_tj" '$.params.proxy_mode')
 649:     _amode=$(json_str "$_tj" '$.params.access_mode')
 650:     _alist=$(json_str "$_tj" '$.params.access_list')
 651:     case "$_act" in true|false) ;; *) persist_result "$_tid" "$_lease" failed '{"error":"invalid service_active"}'; return ;; esac
 652:     rm -f "$STATE_DIR/policy.fp"  # 强制落地
 653:     apply_policy_fields "$_act" "$_kbps" "$_cron" "$_host" "$_pmode" "$_amode" "$_alist"
 654:     persist_result "$_tid" "$_lease" ok "{\"service_active\":$_act,\"proxy_mode\":\"$_pmode\",\"access_mode\":\"$_amode\"}"
 655: }
 656: 
 657: _diag_trim() { # stdin → 单行，截断
 658:     tr '\n' '|' | head -c 2000
 659: }
 660: 
 661: task_collect_diag() {
 662:     _tj="$1"
 663:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 664:     _up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
 665:     _mem=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
 666:     _wan=$(ip -4 -o addr show dev wan 2>/dev/null | awk '{print $4}' | tr '\n' ',')
 667:     _wg=$(wg show wg0 2>/dev/null | _diag_trim)
 668:     _mh=dead
 669:     curl -sS -m 2 -o /dev/null http://127.0.0.1:9090/version 2>/dev/null && _mh=ok
 670:     _ww=$(tail -5 /etc/routermgmt/logs/wan-watch.log 2>/dev/null | _diag_trim)
 671:     _fp=$(cat "$STATE_DIR/policy.fp" 2>/dev/null)
 672:     _nft=$(nft list table inet vps_qos 2>/dev/null | _diag_trim)
 673:     _np=$(tail -12 /etc/routermgmt/logs/netprobe.log 2>/dev/null)
 674:     persist_result "$_tid" "$_lease" ok "$(printf '{"uptime_s":%s,"mem_avail_mb":%s,"wan":"%s","mihomo":"%s","wg":"%s","wan_watch":"%s","policy_fp":"%s","vps_qos":"%s","netprobe":"%s"}' \
 675:         "${_up:-0}" "${_mem:-0}" "$(printf '%s' "$_wan" | sed 's/"/\\"/g')" "$_mh" \
 676:         "$(printf '%s' "$_wg" | sed 's/"/\\"/g')" "$(printf '%s' "$_ww" | sed 's/"/\\"/g')" \
 677:         "$(printf '%s' "$_fp" | sed 's/"/\\"/g')" "$(printf '%s' "$_nft" | sed 's/"/\\"/g')" \
 678:         "$(printf '%s' "$_np" | tr '\n' '|' | sed 's/"/\\"/g')")"
 679: }
 680: 
 681: # set_wifi：远程开关 Wi-Fi（2026-09-23）。关闭时布防 5 分钟自动恢复兜底：
 682: # 管理心跳走有线/WAN 隧道不受影响；300 秒内无新的 set_wifi enabled=true 确认，
 683: # cron 每分钟巡检超时后自动重新启用并解除布防（防"远程关掉后联系不上"）。
 684: # 2026-10-01 开机持久化修复：wifi.enabled 标记"最近一次人工开启"；rc.local 三态
 685: # 判断（enabled→保持开 / disabled→主动关 / 都无=新设备默认关）。此前 rc.local 把
 686: # wifi.disabled 当"已启用"读，语义反向：开启状态一重启就被关，禁用状态反而开回。
 687: wifi_restore_disarm() {
 688:     rm -f "$STATE_DIR/wifi.disabled"
 689:     date +%s > "$STATE_DIR/wifi.enabled"
 690:     sed -i '/#routermgmt-wifi-restore/d' /etc/crontabs/root 2>/dev/null
 691:     [ -x /etc/init.d/cron ] && /etc/init.d/cron restart 2>/dev/null
 692:     return 0
 693: }
 694: 
 695: wifi_restore_arm() {
 696:     date +%s > "$STATE_DIR/wifi.disabled"
 697:     rm -f "$STATE_DIR/wifi.enabled"
 698:     cat > /etc/routermgmt/wifi_restore.sh <<'EOS'
 699: #!/bin/sh
 700: # routermgmt Wi-Fi 自动恢复：布防 300 秒无确认则自动开回
 701: _f="/etc/routermgmt/state/wifi.disabled"
 702: [ -f "$_f" ] || exit 0
 703: _now=$(date +%s); _ts=$(cat "$_f" 2>/dev/null || echo 0)
 704: [ $((_now - _ts)) -lt 300 ] && exit 0
 705: _rlist="$(uci show wireless 2>/dev/null | sed -n 's/^\(wireless\.[^.=]*\)=wifi-device$/\1/p')"
 706: [ -z "$_rlist" ] && _rlist="$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.[^.]*\.device='\([^']*\)'/wireless.\1/p" | sort -u)"
 707: for _r in $_rlist; do
 708:     uci set "$_r.disabled=0"
 709: done
 710: # MTK 固件的 /sbin/wifi up 会关射频——检测到时跳过，纯 ifconfig
 711: _mt7981=0
 712: [ -d /etc/wireless/mediatek ] && _mt7981=1
 713: for _i in $(ls -d /sys/class/net/ra[0-9]* /sys/class/net/rax[0-9]* 2>/dev/null | sed 's|.*/||'); do
 714:     ifconfig "$_i" up 2>/dev/null
 715: done
 716: uci commit wireless
 717: [ "$_mt7981" = "0" ] && { wifi up 2>/dev/null || /sbin/wifi up 2>/dev/null; }
 718: rm -f "$_f"
 719: date +%s > /etc/routermgmt/state/wifi.enabled
 720: sed -i '/#routermgmt-wifi-restore/d' /etc/crontabs/root 2>/dev/null
 721: [ -x /etc/init.d/cron ] && /etc/init.d/cron restart 2>/dev/null
 722: logger -t routermgmt-agent "wifi auto-restored after timeout"
 723: EOS
 724:     chmod +x /etc/routermgmt/wifi_restore.sh
 725:     grep -q '#routermgmt-wifi-restore' /etc/crontabs/root 2>/dev/null || \
 726:         echo '* * * * * /etc/routermgmt/wifi_restore.sh #routermgmt-wifi-restore' >> /etc/crontabs/root
 727:     [ -x /etc/init.d/cron ] && /etc/init.d/cron restart 2>/dev/null
 728:     return 0
 729: }
 730: 
 731: task_set_wifi() {
 732:     _tj="$1"
 733:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 734:     _en=$(json_str "$_tj" '$.params.enabled')
 735:     case "$_en" in
 736:         true|false) ;;
 737:         *) persist_result "$_tid" "$_lease" failed '{"error":"invalid params.enabled"}'; return ;;
 738:     esac
 739:     # 段发现：标准 wifi-device + MT7981 风格（无线 iface 的 .device 指向的段名，如 RADIO2G）
 740:     _rlist="$(uci show wireless 2>/dev/null | sed -n 's/^\(wireless\.[^.=]*\)=wifi-device$/\1/p')"
 741:     [ -z "$_rlist" ] && _rlist="$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.[^.]*\.device='\([^']*\)'/wireless.\1/p" | sort -u)"
 742:     _n=0
 743:     for _r in $_rlist; do
 744:         if [ "$_en" = "true" ]; then uci set "$_r.disabled=0"; else uci set "$_r.disabled=1"; fi
 745:         _n=$((_n+1))
 746:     done
 747:     [ "$_n" -gt 0 ] || { persist_result "$_tid" "$_lease" failed '{"error":"no wifi-device found"}'; return 0; }
 748:     uci commit wireless
 749:     # MTK 私有驱动固件（SN-R2 类）：uci 不驱动射频，必须直接 ifconfig 控制接口。
 750:     # 停用持久化由 $STATE_DIR/wifi.disabled 兜底（与 300s 自动恢复共用同一文件；
 751:     # rc.local 的 wifi-default-off 钩子读取该文件判断是否执行）。
 752:     _wl="$(ls -d /sys/class/net/ra[0-9]* /sys/class/net/rax[0-9]* /sys/class/net/rai[0-9]* /sys/class/net/rae[0-9]* 2>/dev/null | sed 's|.*/||' | tr '\n' ' ')"
 753:     [ -z "$_wl" ] && _wl="ra0 rax0"
 754:     _apply_mtk=0
 755:     for _i in $_wl; do
 756:         if [ "$_en" = "true" ]; then
 757:             ifconfig "$_i" up 2>/dev/null && _apply_mtk=1
 758:         else
 759:             ifconfig "$_i" down 2>/dev/null && _apply_mtk=1
 760:         fi
 761:     done
 762:     [ "$_apply_mtk" = "1" ] && log "set_wifi: MTK ifconfig applied ($_wl)"
 763:     # MTK 固件的 /sbin/wifi 是 nossiac Lua 版，up/down 行为与标准相反（up 反而关射频），
 764:     # 检测到 MT7981 风格时跳过 wifi 命令，纯 ifconfig 控制。
 765:     _mt7981=0
 766:     [ -d /etc/wireless/mediatek ] && _mt7981=1
 767:     if [ "$_en" = "true" ]; then
 768:         [ "$_mt7981" = "0" ] && { wifi up 2>/dev/null || /sbin/wifi up 2>/dev/null; }
 769:         wifi_restore_disarm
 770:         persist_result "$_tid" "$_lease" ok "{\"enabled\":true,\"radios\":$_n}"
 771:         log "task $_tid wifi enabled radios=$_n"
 772:     else
 773:         [ "$_mt7981" = "0" ] && { wifi down 2>/dev/null || /sbin/wifi down 2>/dev/null; }
 774:         wifi_restore_arm
 775:         persist_result "$_tid" "$_lease" ok "{\"enabled\":false,\"radios\":$_n,\"auto_restore_s\":300}"
 776:         log "task $_tid wifi disabled radios=$_n auto_restore=300s"
 777:     fi
 778:     return 0
 779: }

 succeeded in 2117ms:
   1: #!/bin/sh
   2: # routermgmt-agent — 路由器管理台 Agent（busybox ash，OpenWrt/iStoreOS）
   3: # 依赖：curl openssl-util jsonfilter（由 install-agent.sh 探测安装）
   4: # 配置：/etc/routermgmt/agent.conf（600）：DEVICE_ID HMAC_KEY MGMT_URL SUB_URL SIGN_PUB
   5: # 主循环：心跳 60s + 任务轮询 10s（测试可用 HEARTBEAT_INTERVAL/TASK_INTERVAL 覆盖）
   6: #
   7: # 安全约定（任务书 §7/§14）：
   8: #  - 禁止 sed/正则解析任务 JSON；一律 jsonfilter
   9: #  - 禁止 eval 服务器参数；shell 变量一律加引号
  10: #  - 每次请求新 nonce；重试也换 nonce（服务端防重放）
  11: #  - 请求路径不含 query；变量名不用 PATH
  12: 
  13: set -u
  14: 
  15: CONF_PATH="${RM_CONF:-/etc/routermgmt/agent.conf}"
  16: STATE_DIR="${RM_STATE_DIR:-/etc/routermgmt/state}"
  17: LOG_TAG="routermgmt-agent"
  18: 
  19: HEARTBEAT_INTERVAL="${HEARTBEAT_INTERVAL:-60}"
  20: TASK_INTERVAL="${TASK_INTERVAL:-10}"
  21: PROXY_PORT="${RM_PROXY_PORT:-127.0.0.1:7890}"
  22: MIHOMO_API="${RM_MIHOMO_API:-127.0.0.1:9090}"
  23: EGRESS_CHECK_URL="${RM_EGRESS_CHECK_URL:-https://www.cloudflare.com/cdn-cgi/trace}"
  24: CN_CHECK_URL="${RM_CN_CHECK_URL:-https://www.baidu.com}"
  25: WAN_IF="${RM_WAN_IF:-}"
  26: CURL_OPTS="${RM_CURL_OPTS:--sS -m 10 -k}"
  27: 
  28: log() {
  29:     echo "$(date '+%F %T') $*" >&2
  30:     logger -t "$LOG_TAG" -- "$*" 2>/dev/null || true
  31: }
  32: 
  33: die() {
  34:     log "FATAL: $*"
  35:     exit 1
  36: }
  37: 
  38: # ---- 配置加载：先严格校验每一行格式，再 source（§14：只允许严格编码的本地生成内容）----
  39: load_conf() {
  40:     [ -f "$CONF_PATH" ] || die "缺少配置 $CONF_PATH"
  41:     while IFS= read -r line; do
  42:         case "$line" in
  43:             ""|\#*) continue ;;
  44:             DEVICE_ID=*|HMAC_KEY=*|MGMT_URL=*|SUB_URL=*|SIGN_PUB=*)
  45:                 case "$line" in
  46:                     *[!A-Za-z0-9_=:/.\?\&\-]*) die "配置行含非法字符: ${line%%=*}" ;;
  47:                 esac ;;
  48:             *) die "配置包含不允许的键: $line" ;;
  49:         esac
  50:     done < "$CONF_PATH"
  51:     # shellcheck disable=SC1090
  52:     . "$CONF_PATH"
  53:     [ -n "${DEVICE_ID:-}" ] && [ -n "${HMAC_KEY:-}" ] && [ -n "${MGMT_URL:-}" ] || die "配置缺少必填键"
  54: }
  55: 
  56: # ---- HMAC 签名请求（§7.1，与 Go 侧 CanonicalString 完全一致）----
  57: # 用法: api_call METHOD REQUEST_PATH BODY_FILE OUT_FILE
  58: # 请求路径不含 query；POST 用 --data-binary @file 保证签名字节=发送字节
  59: api_call() {
  60:     _method="$1"; _rpath="$2"; _body="$3"; _out="$4"
  61:     _ts=$(date +%s)
  62:     _nonce=$(openssl rand -hex 16)
  63:     _bhash=$(openssl dgst -sha256 -hex "$_body" | awk '{print $NF}')
  64:     _sig=$(printf '%s\n%s\n%s\n%s\n%s\n%s' \
  65:         "$DEVICE_ID" "$_ts" "$_nonce" "$_method" "$_rpath" "$_bhash" \
  66:         | openssl dgst -sha256 -hmac "$HMAC_KEY" -hex | awk '{print $NF}')
  67:     _hdrdump=""
  68:     [ -n "${RM_HDR_FILE:-}" ] && _hdrdump="-D $RM_HDR_FILE"
  69:     if [ "$_method" = "GET" ]; then
  70:         curl $CURL_OPTS -X GET -o "$_out" -w '%{http_code}' $_hdrdump \
  71:             -H "X-Device-Id: $DEVICE_ID" -H "X-Timestamp: $_ts" -H "X-Nonce: $_nonce" \
  72:             -H "Authorization: HMAC-SHA256 $_sig" \
  73:             "$MGMT_URL$_rpath" 2>/dev/null
  74:     else
  75:         curl $CURL_OPTS -X "$_method" -o "$_out" -w '%{http_code}' \
  76:             -H "X-Device-Id: $DEVICE_ID" -H "X-Timestamp: $_ts" -H "X-Nonce: $_nonce" \
  77:             -H "Authorization: HMAC-SHA256 $_sig" \
  78:             -H "Content-Type: application/json" \
  79:             --data-binary "@$_body" \
  80:             "$MGMT_URL$_rpath" 2>/dev/null
  81:     fi
  82: }
  83: 
  84: json_str() { jsonfilter -s "$1" -e "$2" 2>/dev/null; }
  85: 
  86: # ---- 指标采集（缺数据输出 null；代理采集口径见 §19.5）----
  87: jstr() { # 字符串转 JSON 字符串或 null（转义反斜杠与引号，避免指标字段注入）
  88:     if [ -z "$1" ]; then printf 'null'; return; fi
  89:     printf '"'
  90:     printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
  91:     printf '"'
  92: }
  93: jnum() {
  94:     if [ -n "$1" ]; then printf '%s' "$1"; else printf 'null'; fi
  95: }
  96: 
  97: collect_metrics() { # $1 = 输出文件
  98:     _out="$1"
  99:     _sample=$(cat /proc/sys/kernel/random/uuid 2>/dev/null)
 100:     _boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
 101:     [ -n "$_sample" ] || _sample="s-$(date +%s)-$$"
 102:     [ -n "$_boot" ] || _boot="boot-unknown"
 103: 
 104:     # CPU%（/proc/stat 相邻采样差值）
 105:     _cpu=""
 106:     _tot1=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8}' /proc/stat 2>/dev/null)
 107:     _idle1=$(awk '/^cpu /{print $5}' /proc/stat 2>/dev/null)
 108:     if [ -f "$STATE_DIR/cpu.prev" ] && [ -n "$_tot1" ] && [ -n "$_idle1" ]; then
 109:         read -r _ptot _pidle < "$STATE_DIR/cpu.prev" 2>/dev/null
 110:         case "$_ptot" in ''|*[!0-9]*) _ptot="" ;; esac
 111:         if [ -n "$_ptot" ] && [ "$_tot1" -gt "$_ptot" ] 2>/dev/null; then
 112:             _cpu=$(awk -v t="$_tot1" -v i="$_idle1" -v pt="$_ptot" -v pi="$_pidle" \
 113:                 'BEGIN{d=t-pt; di=i-pi; if(d>0) printf "%.1f", (d-di)*100/d}')
 114:         fi
 115:     fi
 116:     printf '%s %s\n' "${_tot1:-0}" "${_idle1:-0}" > "$STATE_DIR/cpu.prev" 2>/dev/null
 117: 
 118:     # 内存
 119:     _memtotal=$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
 120:     _memavail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
 121:     _memused=""
 122:     [ -n "$_memtotal" ] && [ -n "$_memavail" ] && _memused=$(($_memtotal - $_memavail))
 123: 
 124:     # 温度（取最高温区）
 125:     _temp=""
 126:     for z in /sys/class/thermal/thermal_zone*/temp; do
 127:         [ -f "$z" ] || continue
 128:         v=$(cat "$z" 2>/dev/null)
 129:         case "$v" in ''|*[!0-9]*) continue ;; esac
 130:         v=$(awk -v v="$v" 'BEGIN{printf "%.1f", v/1000}')
 131:         case "$v" in *.*) [ -z "$_temp" ] && _temp=$v || _temp=$(awk -v a="$_temp" -v b="$v" 'BEGIN{print (b>a)?b:a}') ;; esac
 132:     done
 133: 
 134:     _disk=$(df -k /etc 2>/dev/null | awk 'NR==2{print int($4/1024)}')
 135:     _uptime=$(cut -d. -f1 /proc/uptime 2>/dev/null)
 136: 
 137:     # WAN 接口与 IP（ubus 优先）
 138:     _wanif="$WAN_IF"
 139:     if [ -z "$_wanif" ] && command -v ubus >/dev/null 2>&1; then
 140:         _wjson=$(ubus call network.interface.wan status 2>/dev/null)
 141:         if [ -n "$_wjson" ]; then
 142:             _wanip=$(json_str "$_wjson" '$.ipv4-address[0].address')
 143:             _wanif=$(json_str "$_wjson" '$.device')
 144:             [ -n "$_wanif" ] || _wanif=$(json_str "$_wjson" '$.l3_device')
 145:         fi
 146:     fi
 147:     if [ -n "$_wanif" ] && [ -f "/sys/class/net/$_wanif/statistics/rx_bytes" ]; then
 148:         _wanrx=$(cat "/sys/class/net/$_wanif/statistics/rx_bytes")
 149:         _wantx=$(cat "/sys/class/net/$_wanif/statistics/tx_bytes")
 150:     fi
 151: 
 152:     # 代理进程与 WG
 153:     _clash=; pidof clash >/dev/null 2>&1 && _clash=true || { pidof mihomo >/dev/null 2>&1 && _clash=true; }
 154:     _wg=; [ -d /sys/class/net/wg0 ] && _wg=true
 155: 
 156:     # 出口 IP/延迟/当前节点（经代理端口探测；外部探测服务不可用≠节点不可用）
 157:     _exitip=""; _lat=""; _exitnode=""
 158:     _t0=$(date +%s)
 159:     _trace=$(curl $CURL_OPTS -x "http://$PROXY_PORT" "$EGRESS_CHECK_URL" 2>/dev/null)
 160:     _t1=$(date +%s)
 161:     if [ -n "$_trace" ]; then
 162:         _exitip=$(printf '%s\n' "$_trace" | awk -F= '/^ip=/{print $2}' | head -n1)
 163:         _lat=$(($_t1 - $_t0))
 164:         [ -n "$_exitip" ] || _exitip=$(printf '%s\n' "$_trace" | head -n1)
 165:     fi
 166:     _pjson=$(curl $CURL_OPTS "http://$MIHOMO_API/proxies/PROXY" 2>/dev/null)
 167:     [ -n "$_pjson" ] && _exitnode=$(json_str "$_pjson" '$.now')
 168: 
 169:     # 代理流量：只累计经节点的连接（非 DIRECT），轮询口径为估算（§19.5）
 170:     _prx=""; _ptx=""; _pstatus="unavailable"; _pepoch=""
 171:     _cjson=$(curl $CURL_OPTS "http://$MIHOMO_API/connections" 2>/dev/null)
 172:     if [ -n "$_cjson" ]; then
 173:         _cpid=$(pidof clash 2>/dev/null || pidof mihomo 2>/dev/null)
 174:         _pepoch="$_boot-$_cpid"
 175:         _chains=$(json_str "$_cjson" '$.connections[*].chains[0]')
 176:         _downs=$(json_str "$_cjson" '$.connections[*].download')
 177:         _ups=$(json_str "$_cjson" '$.connections[*].upload')
 178:         if [ -n "$_chains" ] && [ -n "$_downs" ] && [ -n "$_ups" ]; then
 179:             # 三个列表来自同一 JSON 的同序遍历，用分隔段对齐后累计
 180:             _acc=$( { printf '%s\n' "$_chains"; echo "__SPLIT__"; printf '%s\n' "$_downs"; echo "__SPLIT__"; printf '%s\n' "$_ups"; } | awk '
 181:                 BEGIN{sec=1} # 首段从 1 开始：split 前的 chains 进段 1，避免整体错位一段
 182:                 $0=="__SPLIT__"{sec++; next}
 183:                 {cnt[sec]++; line[sec","cnt[sec]]=$0}
 184:                 END{
 185:                     for(i=1;i<=cnt[1];i++){
 186:                         ch=line[1","i]; dn=line[2","i]+0; up=line[3","i]+0
 187:                         if(ch!="" && ch!="DIRECT" && ch!="COMPATIBLE" && ch!="REJECT"){
 188:                             tot+=dn; tup+=up
 189:                         }
 190:                     }
 191:                     printf "%d %d", tot+0, tup+0
 192:                 }')
 193:             _prx=$(printf '%s' "$_acc" | awk '{print $1}')
 194:             _ptx=$(printf '%s' "$_acc" | awk '{print $2}')
 195:             case "$_prx" in ''|*[!0-9]*) _prx=""; _ptx=""; _pstatus="unavailable" ;; esac
 196:             [ -n "$_prx" ] && _pstatus="partial" # 轮询会漏短连接：界面须标「估算」
 197:         fi
 198:     fi
 199: 
 200:     _cfgver=0
 201:     [ -f "$STATE_DIR/accepted_version" ] && _cfgver=$(cat "$STATE_DIR/accepted_version" 2>/dev/null)
 202:     case "$_cfgver" in ''|*[!0-9]*) _cfgver=0 ;; esac
 203: 
 204:     cat > "$_out" <<EOF
 205: {
 206:   "device_id": "$DEVICE_ID",
 207:   "ts": $(date +%s),
 208:   "metrics": {
 209:     "cpu": $(jnum "$_cpu"),
 210:     "mem_used_mb": $(jnum "$_memused"),
 211:     "mem_total_mb": $(jnum "$_memtotal"),
 212:     "temp_c": $(jnum "$_temp"),
 213:     "disk_free_mb": $(jnum "$_disk"),
 214:     "uptime_s": $(jnum "$_uptime"),
 215:     "wan_ip": $(jstr "${_wanip:-}"),
 216:     "exit_ip": $(jstr "$_exitip"),
 217:     "exit_node": $(jstr "$_exitnode"),
 218:     "exit_latency_ms": $(jnum "$_lat"),
 219:     "clash_alive": $(jbool "$_clash"),
 220:     "wg_alive": $(jbool "$_wg"),
 221:     "wan_rx_bytes": $(jnum "${_wanrx:-}"),
 222:     "wan_tx_bytes": $(jnum "${_wantx:-}"),
 223:     "sample_id": "$_sample",
 224:     "boot_id": "$_boot",
 225:     "proxy_counter_epoch": $(jstr "$_pepoch"),
 226:     "proxy_measurement_status": "$( [ -n "$_prx" ] && echo "$_pstatus" || echo unavailable )",
 227:     "proxy_rx_bytes": $(jnum "${_prx:-}"),
 228:     "proxy_tx_bytes": $(jnum "${_ptx:-}"),
 229:     "config_version": $_cfgver
 230:   }
 231: }
 232: EOF
 233: }
 234: 
 235: jbool() { if [ -n "$1" ]; then echo true; else echo false; fi; }
 236: 
 237: send_heartbeat() {
 238:     _body="$STATE_DIR/hb.json"
 239:     collect_metrics "$_body"
 240:     _code=$(api_call POST /api/v1/agent/heartbeat "$_body" "$STATE_DIR/hb.resp")
 241:     if [ "$_code" = "200" ]; then
 242:         log "heartbeat ok"
 243:         apply_policy_from_hb 2>/dev/null || true
 244:     else
 245:         log "heartbeat failed http=$_code resp=$(head -c 200 "$STATE_DIR/hb.resp" 2>/dev/null)"
 246:         return 1
 247:     fi
 248: }
 249: 
 250: # ---- 任务执行 ----
 251: post_result() { # $1 task_id $2 lease_id $3 status $4 detail-json(对象或空)
 252:     _tid="$1"; _lease="$2"; _st="$3"; _det="${4:-\{\}}"
 253:     _body="$STATE_DIR/result.$$.json"
 254:     printf '{"lease_id":"%s","status":"%s","detail":%s}\n' "$_lease" "$_st" "$_det" > "$_body"
 255:     _try=0
 256:     while [ "$_try" -lt 3 ]; do
 257:         _code=$(api_call POST "/api/v1/agent/tasks/$_tid/result" "$_body" "$STATE_DIR/result.$$.resp")
 258:         case "$_code" in 200|409) break ;; esac
 259:         _try=$((_try + 1))
 260:         sleep 2
 261:     done
 262:     rm -f "$_body" "$STATE_DIR/result.$$.resp"
 263:     case "$_code" in
 264:         200|409) return 0 ;;
 265:         *) log "report result failed task=$_tid http=$_code"; return 1 ;;
 266:     esac
 267: }
 268: 
 269: # 任务结果落盘（网络断时先持久化；重启后补报）
 270: persist_result() {
 271:     mkdir -p "$STATE_DIR/results"
 272:     printf '{"task_id":"%s","lease_id":"%s","status":"%s","detail":%s}\n' \
 273:         "$1" "$2" "$3" "${4:-\{\}}" > "$STATE_DIR/results/$1.json"
 274: }
 275: clear_result() { rm -f "$STATE_DIR/results/$1.json"; }
 276: 
 277: flush_pending_results() {
 278:     [ -d "$STATE_DIR/results" ] || return 0
 279:     for f in "$STATE_DIR/results"/*.json; do
 280:         [ -f "$f" ] || continue
 281:         _tid=$(json_str "$(cat "$f")" '$.task_id')
 282:         _lease=$(json_str "$(cat "$f")" '$.lease_id')
 283:         _st=$(json_str "$(cat "$f")" '$.status')
 284:         _det=$(json_str "$(cat "$f")" '$.detail')
 285:         [ -n "$_det" ] || _det='{}'
 286:         post_result "$_tid" "$_lease" "$_st" "$_det" && rm -f "$f"
 287:     done
 288: }
 289: 
 290: run_task() { # $1 = 单个任务的 JSON 文本
 291:     _tj="$1"
 292:     _tid=$(json_str "$_tj" '$.task_id')
 293:     _type=$(json_str "$_tj" '$.type')
 294:     _lease=$(json_str "$_tj" '$.lease_id')
 295:     log "task start id=$_tid type=$_type"
 296:     case "$_type" in
 297:         switch_node|reload_proxy)
 298:             task_apply_config "$_tj" ;;
 299:         reboot)
 300:             task_reboot "$_tj" ;;
 301:         ping_test)
 302:             task_ping_test "$_tj" ;;
 303:         set_proxy_state)
 304:             task_set_proxy_state "$_tj" ;;
 305:         set_wifi)
 306:             task_set_wifi "$_tj" ;;
 307:         agent_update)
 308:             task_agent_update "$_tj" ;;
 309:         repair_mgmt_tunnel)
 310:             task_repair_mgmt_tunnel "$_tj" ;;
 311:         apply_policy|set_ratelimit|set_reboot_schedule|set_license)
 312:             task_apply_policy "$_tj" ;;
 313:         collect_diag)
 314:             task_collect_diag "$_tj" ;;
 315:         *)
 316:             persist_result "$_tid" "$_lease" failed "{\"error\":\"unsupported task type\"}"
 317:             ;;
 318:     esac
 319:     flush_pending_results
 320: }
 321: 
 322: # 基础任务：ping_test / reboot（§14：限制目标格式/次数/超时，不经 eval）
 323: task_ping_test() {
 324:     _tj="$1"
 325:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 326:     _host=$(json_str "$_tj" '$.params.host')
 327:     case "$_host" in
 328:         ''|*[!A-Za-z0-9._\-]*) 
 329:             persist_result "$_tid" "$_lease" failed '{"error":"invalid host"}'
 330:             return ;;
 331:     esac
 332:     _out=$(ping -c 1 -W 3 "$_host" 2>&1)
 333:     _rc=$?
 334:     if [ "$_rc" = "0" ]; then
 335:         _ms=$(printf '%s\n' "$_out" | awk -F'time=' '/time=/{split($2,a," ");print a[1];exit}' | tr -d ' ' | awk -F. '{print int($1)}')
 336:         case "$_ms" in ''|*[!0-9]*) _ms=0 ;; esac
 337:         persist_result "$_tid" "$_lease" ok "{\"delay_ms\":$_ms,\"host\":\"$_host\"}"
 338:     else
 339:         persist_result "$_tid" "$_lease" failed "{\"error\":\"ping failed\",\"host\":\"$_host\"}"
 340:     fi
 341: }
 342: 
 343: task_reboot() {
 344:     # 重启前持久化标记 + 旧 boot_id；重启后确认 boot_id 变化才报 ok（§19.2）
 345:     _tj="$1"
 346:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 347:     _oldboot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
 348:     mkdir -p "$STATE_DIR/reboot_pending"
 349:     printf '%s\n%s\n%s\n' "$_tid" "$_lease" "$_oldboot" > "$STATE_DIR/reboot_pending/$_tid"
 350:     sync
 351:     # 先尝试回报"即将重启"无效——服务端要求最终 ok 必须带重启证据，这里保持 running
 352:     sleep 2
 353:     reboot || persist_result "$_tid" "$_lease" failed '{"error":"reboot command failed"}'
 354: }
 355: 
 356: check_reboot_evidence() {
 357:     # 开机恢复：boot_id 已变化 → 报 ok；未变化（没重启成）→ 报 failed
 358:     [ -d "$STATE_DIR/reboot_pending" ] || return 0
 359:     _nowboot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
 360:     for f in "$STATE_DIR/reboot_pending"/*; do
 361:         [ -f "$f" ] || continue
 362:         _tid=$(sed -n 1p "$f"); _lease=$(sed -n 2p "$f"); _old=$(sed -n 3p "$f")
 363:         if [ "$_nowboot" != "$_old" ]; then
 364:             persist_result "$_tid" "$_lease" ok '{"boot_id_changed":true}'
 365:             rm -f "$f"
 366:         else
 367:             persist_result "$_tid" "$_lease" failed '{"error":"boot_id unchanged, reboot did not happen"}'
 368:             rm -f "$f"
 369:         fi
 370:     done
 371: }
 372: 
 373: poll_tasks() {
 374:     : > "$STATE_DIR/tasks.body"
 375:     _code=$(api_call GET /api/v1/agent/tasks "$STATE_DIR/tasks.body" "$STATE_DIR/tasks.resp")
 376:     [ "$_code" = "200" ] || { [ -n "$_code" ] && log "poll tasks http=$_code"; return 0; }
 377:     _one=$(json_str "$(cat "$STATE_DIR/tasks.resp")" '$.tasks[0]')
 378:     [ -n "$_one" ] || return 0
 379:     run_task "$_one"
 380: }
 381: 
 382: # ---- 主循环 ----
 383: main() {
 384:     load_conf
 385:     mkdir -p "$STATE_DIR"
 386:     chmod 700 "$STATE_DIR" 2>/dev/null
 387: 
 388:     # 加载 handlers（同 shell 进程，函数共享）
 389:     _hd="/etc/routermgmt/handlers/switch_node.sh"
 390:     [ -f "$_hd" ] || _hd="$(dirname "$0")/handlers/switch_node.sh"
 391:     [ -f "$_hd" ] || die "找不到 handlers/switch_node.sh"
 392:     # shellcheck disable=SC1090
 393:     . "$_hd"
 394: 
 395:     # 崩溃/重启恢复：未提交事务回滚 + reboot 证据 + 补报结果
 396:     txn_recover_all
 397:     check_reboot_evidence
 398:     flush_pending_results
 399: 
 400:     _last_hb=0
 401:     log "agent started device=$DEVICE_ID url=$MGMT_URL"
 402:     while :; do
 403:         _now=$(date +%s)
 404:         if [ $(( _now - _last_hb )) -ge "$HEARTBEAT_INTERVAL" ]; then
 405:             send_heartbeat && _last_hb=$_now
 406:         fi
 407:         flush_pending_results  # 每轮补报（重启证据等结果不能只靠启动时/有任务时上报）
 408:         poll_tasks
 409:         sleep "$TASK_INTERVAL"
 410:     done
 411: }
 412: 
 413: main "$@"

exec
