 102: func (s *Server) renderFor(tx *gorm.DB, dev *models.Device) ([]byte, []clash.NodeRender, error) {
 103: 	nodes, _, err := s.resolveRenderNodes(tx, dev)
 104: 	if err != nil {
 105: 		return nil, nil, err
 106: 	}
 107: 	yamlBytes, err := clash.Render(clash.RenderInput{
 108: 		AirportSubURL: s.Cfg.AirportSubURL, AirportGeneration: s.Cfg.AirportGeneration,
 109: 		DeviceID: dev.ID, Nodes: nodes, MgmtDirectIPs: s.mgmtDirectIPs(),
 110: 	})
 111: 	if err != nil {
 112: 		return nil, nil, err
 113: 	}
 114: 	return yamlBytes, nodes, nil
 115: }
