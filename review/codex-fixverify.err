   1: #!/bin/sh
   2: # handlers/switch_node.sh — 配置应用事务（§7.5，被 routermgmt-agent.sh source）
   3: # 实现：下载→验签→校验→备份→看门狗→原子替换→强制 PROXY 指向目标→健康检查→提交/回滚
   4: # 适配层全部可通过 RM_* 环境变量覆盖，供 alpine 容器用假服务/网络适配器测试。
   5: #
   6: # 这里同时实现 switch_node 与 reload_proxy（同一事务管线，后者不换节点）。
   7: 
   8: # ---- OpenClash 适配层 ----
   9: oc_config_dir() {
  10:     # 返回 mihomo -d 目录：必须与运行核心一致（含 Geo 数据文件），否则 GEOSITE/GEOIP 规则校验
  11:     # 会因缺数据尝试在线下载而失败。运行核心为 /usr/bin/mihomo -d /etc/openclash。
  12:     if [ -n "${RM_CLASH_DIR:-}" ]; then
  13:         [ -d "$RM_CLASH_DIR" ] && { echo "$RM_CLASH_DIR"; return 0; }
  14:         return 1
  15:     fi
  16:     for d in /etc/openclash /etc/mihomo /etc/openclash/config /etc/clash; do
  17:         [ -d "$d" ] || continue
  18:         for g in GeoSite.dat geosite.dat geoip.metadb Country.mmdb; do
  19:             [ -f "$d/$g" ] && { echo "$d"; return 0; }
  20:         done
  21:     done
  22:     for d in /etc/openclash /etc/mihomo /etc/openclash/config /etc/clash; do
  23:         [ -d "$d" ] && { echo "$d"; return 0; }
  24:     done
  25:     return 1
  26: }
  27: 
  28: oc_active_config() {
  29:     if [ -n "${RM_ACTIVE_CONFIG:-}" ]; then echo "$RM_ACTIVE_CONFIG"; return 0; fi
  30:     _dir=$(oc_config_dir) || return 1
  31:     if command -v uci >/dev/null 2>&1; then
  32:         _p=$(uci -q get openclash.config.config_path 2>/dev/null)
  33:         [ -n "$_p" ] && [ -f "$_p" ] && { echo "$_p"; return 0; }
  34:     fi
  35:     _p=$(ls -t "$_dir"/*.yaml "$_dir"/*.yml 2>/dev/null | head -n1)
  36:     [ -n "$_p" ] && { echo "$_p"; return 0; }
  37:     return 1
  38: }
  39: 
  40: mihomo_bin() {
  41:     if [ -n "${RM_MIHOMO_BIN:-}" ] && [ -x "$RM_MIHOMO_BIN" ]; then echo "$RM_MIHOMO_BIN"; return 0; fi
  42:     for b in /etc/openclash/core/clash_meta /etc/openclash/core/clash_tun; do
  43:         [ -x "$b" ] && { echo "$b"; return 0; }
  44:     done
  45:     command -v clash 2>/dev/null && return 0
  46:     command -v mihomo 2>/dev/null && return 0
  47:     return 1
  48: }
  49: 
  50: mihomo_validate() { # $1 配置文件；核心路径与命令在目标版本验证，不得猜测成功（§7.5）
  51:     _bin=$(mihomo_bin) || return 1
  52:     _dir=$(oc_config_dir 2>/dev/null || echo /tmp)
  53:     # 诊断留痕：bin/dir/完整 stderr 落盘，失败时可远程读取定位（成功时清掉）
  54:     "$_bin" -t -d "$_dir" -f "$1" >"$STATE_DIR/validate.log" 2>&1
  55:     _rc=$?
  56:     [ "$_rc" = "0" ] && rm -f "$STATE_DIR/validate.log"
  57:     return $_rc
  58: }
  59: 
  60: reload_effective() { # $1=待生效 yaml：其中声明的 proxies/groups 必须已存在于运行时
  61:     # 热加载可能被核心的 home 路径限制静默拒绝（PUT 返回 400：-d /etc/openclash 时
  62:     # 配置在 /etc/mihomo 会被拒），或 204 后异步重载失败保留旧配置——不能只信
  63:     # HTTP 返回码，必须核对运行时组名单（2026-09-25 雅典娜"文件换了运行时没换"实锤）。
  64:     _names=$(grep -E '^[[:space:]]*- name: "' "$1" 2>/dev/null | sed 's/.*"\(.*\)".*/\1/')
  65:     [ -n "$_names" ] || return 1
  66:     for _g in $_names; do
  67:         curl $CURL_OPTS -s -m 3 "http://$MIHOMO_API/proxies/$_g" 2>/dev/null | grep -q '"name"' || return 1
  68:     done
  69:     return 0
  70: }
  71: 
  72: oc_reload() {
  73:     # 首选 external-controller 热加载，失败回退 init.d 重启
  74:     _cfg="$1"
  75:     if [ -n "${RM_FAKE_RELOAD_FAIL:-}" ]; then return 1; fi
  76:     _code=$(curl $CURL_OPTS -o /dev/null -w '%{http_code}' -X PUT \
  77:         -H 'Content-Type: application/json' \
  78:         --data-binary "{\"path\":\"$_cfg\"}" \
  79:         "http://$MIHOMO_API/configs?force=true" 2>/dev/null)
  80:     if [ "$_code" = "204" ] || [ "$_code" = "200" ]; then
  81:         wait_api_ready || true
  82:         reload_effective "$_cfg" && return 0
  83:     fi
  84:     # 热加载不可用/未生效 → 完整重启核心。直跑脚本优先：openclash 包装层在自身
  85:     # enable=0 时 restart 返回成功但不重启核心（雅典娜实锤），必须放后面并逐个核验
  86:     for _init in "${RM_OPENCLASH_INIT:-}" /etc/init.d/mihomo /etc/init.d/openclash; do
  87:         [ -n "$_init" ] || continue
  88:         [ -x "$_init" ] || continue
  89:         "$_init" restart >/dev/null 2>&1 || continue
  90:         wait_api_ready || continue
  91:         reload_effective "$_cfg" && return 0
  92:     done
  93:     return 1
  94: }
  95: 
  96: oc_get_group() { # $1 组名 → 当前选择
  97:     curl $CURL_OPTS "http://$MIHOMO_API/proxies/$1" 2>/dev/null | jsonfilter -e '$.now' 2>/dev/null
  98: }
  99: 
 100: oc_set_group() { # $1 组名 $2 目标
 101:     curl $CURL_OPTS -o /dev/null -X PUT -H 'Content-Type: application/json' \
 102:         --data-binary "{\"name\":\"$2\"}" \
 103:         "http://$MIHOMO_API/proxies/$1" 2>/dev/null
 104: }
 105: 
 106: wait_api_ready() { # 最多等 30s
 107:     _i=0
 108:     while [ "$_i" -lt 30 ]; do
 109:         curl $CURL_OPTS -o /dev/null "http://$MIHOMO_API/version" 2>/dev/null && return 0
 110:         _i=$((_i + 1)); sleep 1
 111:     done
 112:     return 1
 113: }
