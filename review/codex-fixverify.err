 119: func (s *Server) handleConfigPreview(c *gin.Context) {
 120: 	var dev models.Device
 121: 	if err := s.DB.Where("id=?", c.Param("id")).First(&dev).Error; err != nil {
 122: 		fail404(c, "设备不存在")
 123: 		return
 124: 	}
 125: 	var yamlBytes []byte
 126: 	var revision string
 127: 	err := s.DB.Transaction(func(tx *gorm.DB) error {
 128: 		var e error
 129: 		yamlBytes, _, e = s.renderFor(tx, &dev)
 130: 		if e != nil {
 131: 			return e
 132: 		}
 133: 		revision, e = s.bindingRevision(tx, &dev)
 134: 		return e
 135: 	})
 136: 	if err != nil {
 137: 		if err == errNoBindableNode {
 138: 			fail409(c, err.Error())
 139: 			return
 140: 		}
 141: 		fail422(c, "渲染失败: "+err.Error())
 142: 		return
 143: 	}
 144: 	// 与当前已发布版本做掩码 diff
 145: 	maskedNew := clash.MaskYAML(yamlBytes)
 146: 	var oldMasked string
 147: 	var oldVersion int64
 148: 	if dev.DesiredConfigVersion > 0 {
 149: 		var cfg models.Config
 150: 		if err := s.DB.Where("device_id=? AND version=?", dev.ID, dev.DesiredConfigVersion).First(&cfg).Error; err == nil {
 151: 			if raw, derr := crypto.Decrypt(s.MasterKey, cfg.ContentEnc, fmt.Sprintf("configs:%d:content", cfg.ID)); derr == nil {
 152: 				oldMasked = clash.MaskYAML(raw)
 153: 				oldVersion = cfg.Version
 154: 			}
 155: 		}
 156: 	}
 157: 	nextVersion := dev.DesiredConfigVersion + 1
 158: 	c.JSON(http.StatusOK, gin.H{
 159: 		"revision":        revision,
 160: 		"next_version":    nextVersion,
 161: 		"sha256":          crypto.SHA256Hex(yamlBytes),
 162: 		"masked_yaml":     maskedNew,
 163: 		"current_version": oldVersion,
 164: 		"diff":            lineDiff(oldMasked, maskedNew),
 165: 	})
 166: }
