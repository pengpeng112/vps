  68:             VPS_HOST)         _valid_host "$_v"   && TC_VPS_HOST="$_v" ;;
  69:             VPS_PORT)         _valid_port "$_v"   && TC_VPS_PORT="$_v" ;;
  70:             MGMT_LOCAL_PORT)  _valid_port "$_v"   && TC_MGMT_LOCAL_PORT="$_v" ;;
  71:             MGMT_TARGET)      _valid_target "$_v" && TC_MGMT_TARGET="$_v" ;;
  72:             RSSH_REMOTE_PORT) _valid_port "$_v"   && TC_RSSH_REMOTE_PORT="$_v" ;;
  73:             RSSH_TARGET)      _valid_target "$_v" && TC_RSSH_TARGET="$_v" ;;
  74:             # v2: 备用端点
  75:             VPS2_HOST)        _valid_host "$_v"   && TC_VPS2_HOST="$_v" ;;
  76:             VPS2_PORT)        _valid_port "$_v"   && TC_VPS2_PORT="$_v" || TC_VPS2_PORT=28722 ;;
  77:             VPS3_HOST)        _valid_host "$_v"   && TC_VPS3_HOST="$_v" ;;
  78:             VPS3_PORT)        _valid_port "$_v"   && TC_VPS3_PORT="$_v" || TC_VPS3_PORT=28722 ;;
  79:             # v3: 第四端点
  80:             VPS4_HOST)        _valid_host "$_v"   && TC_VPS4_HOST="$_v" ;;
  81:             VPS4_PORT)        _valid_port "$_v"   && TC_VPS4_PORT="$_v" || TC_VPS4_PORT=28722 ;;
  82:             VPS5_HOST)        _valid_host "$_v"   && TC_VPS5_HOST="$_v" ;;
  83:             VPS5_PORT)        _valid_port "$_v"   && TC_VPS5_PORT="$_v" ;;
  84:         esac
  85:     done < "$CONF"
  86:     [ -n "$TC_VPS_HOST" ] && [ -n "$TC_VPS_PORT" ] && \
  87:     [ -n "$TC_MGMT_LOCAL_PORT" ] && [ -n "$TC_MGMT_TARGET" ]
  88: }
  89: 
  90: _open_instance() {
  91:     _inst="$1"; _vps="$2"; _port="$3"; _fwd="$4"
  92:     _y="-y"
  93:     if [ -f "$KH" ] && grep -q "^$_vps " "$KH" 2>/dev/null; then
  94:         _y=""
  95:     else
  96:         logger -t mgmt-tunnel "WARN: $KH 无 ${_vps} 条目，使用 -y 接受（备用端点直通 DO，密钥相同）"
  97:     fi
  98:     procd_open_instance "$_inst"
  99:     # ExitOnForwardFailure: -R 端口被占时 ssh 必须退出（10-01 R3 实锤：静默苟活进程
 100:     # 让 procd 以为健康、端口释放后无人再申请转发=永久半开），配合 retry=0 无限重生必自愈
 101:     procd_set_param command /usr/bin/ssh -i "$KEY" -p "$_port" -N -K 30 -T -o ExitOnForwardFailure=yes $_y $_fwd "root@$_vps"
 102:     # retry=0 无限重试：2026-10-01 实锤 5 次上限会在服务端故障期耗尽后永不自愈
 103:     # （R3 TX/BWG 路径服务端修复后仍死）；退避仍防风暴，慢失败最终必回
 104:     procd_set_param respawn 3600 0 0
 105:     procd_set_param stdout 1
 106:     procd_set_param stderr 1
 107:     procd_close_instance
 108: }
 109: 
 110: start_service() {
 111:     if ! load_tunnel_conf; then
 112:         logger -t mgmt-tunnel "WARN: $CONF 缺失或核心字段无效，降级为仅管理通道(-L)默认配置"
 113:         _open_instance mgmt "$DEF_VPS" "$DEF_PORT" \
 114:             "-L 127.0.0.1:$DEF_LOCAL:$DEF_HUB"
 115:         return
 116:     fi
 117: 
 118:     # === 主端点（DO 直连，-L + -R）===
 119:     _open_instance mgmt "$TC_VPS_HOST" "$TC_VPS_PORT" \
 120:         "-L 127.0.0.1:$TC_MGMT_LOCAL_PORT:$TC_MGMT_TARGET"
 121:     if [ -n "$TC_RSSH_REMOTE_PORT" ] && [ -n "$TC_RSSH_TARGET" ]; then
 122:         _open_instance rssh "$TC_VPS_HOST" "$TC_VPS_PORT" \
 123:             "-R 127.0.0.1:$TC_RSSH_REMOTE_PORT:$TC_RSSH_TARGET"
 124:     else
 125:         logger -t mgmt-tunnel "WARN: RSSH 未配置，排障通道未启动"
 126:     fi
 127: 
 128:     # === 备用端点 2（TX socat 中继，仅 -L，本地端口 18444）===
 129:     if [ -n "$TC_VPS2_HOST" ]; then
 130:         _p2=$((TC_MGMT_LOCAL_PORT + 1))
 131:         _open_instance mgmt2 "$TC_VPS2_HOST" "$TC_VPS2_PORT" \

