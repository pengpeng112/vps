  87: // bindingRevision 绑定/节点参数指纹：apply 时重算并比对，变化则 409（§19.3）。
  88: func (s *Server) bindingRevision(tx *gorm.DB, dev *models.Device) (string, error) {
  89: 	nodes, _, err := s.resolveRenderNodes(tx, dev)
  90: 	if err != nil {
  91: 		return "", err
  92: 	}
  93: 	var sb strings.Builder
  94: 	for _, n := range nodes {
  95: 		// 指纹含协议与各自凭据：任何参数变化都触发 apply 重算比对（§19.3）
  96: 		sb.WriteString(fmt.Sprintf("%d|%s|%s|%d|%s|%s|%s|%s|%s|%s|%s|%s|%s;", n.ID, n.Name, n.Proto, n.Port, n.Host, n.UUID, n.PBK, n.SNI, n.SID, n.Flow, n.Password, n.WSPath, n.WSHost))
  97: 	}
  98: 	sb.WriteString(strings.Join(s.mgmtDirectIPs(), ","))
  99: 	return crypto.SHA256Hex([]byte(sb.String())), nil
 100: }
