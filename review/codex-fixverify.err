 396: // ---- 绑定 ----
 397: 
 398: type assignmentResult struct {
 399: 	DeviceID string `json:"device_id"`
 400: 	OK       bool   `json:"ok"`
 401: 	Error    string `json:"error,omitempty"`
 402: 	TaskID   string `json:"task_id,omitempty"`
 403: 	Version  int64  `json:"version,omitempty"`
 404: }
 405: 
 406: // handleAssignmentsBatch 批量绑定：默认只更新期望绑定；apply=true 才发布配置并生成任务，
 407: // 响应逐台列明结果，不假装全成功（§19.3）。
 408: func (s *Server) handleAssignmentsBatch(c *gin.Context) {
 409: 	a := adminFrom(c)
 410: 	var req struct {
 411: 		DeviceIDs []string `json:"device_ids" binding:"required"`
 412: 		NodeID    int64    `json:"node_id" binding:"required"`
 413: 		IsPrimary bool     `json:"is_primary"`
 414: 		Apply     bool     `json:"apply"`
 415: 	}
 416: 	if err := c.ShouldBindJSON(&req); err != nil {
 417: 		fail422(c, "device_ids 与 node_id 必填")
 418: 		return
 419: 	}
 420: 	var node models.Node
 421: 	if err := s.DB.Where("id=?", req.NodeID).First(&node).Error; err != nil {
 422: 		fail404(c, "节点不存在")
 423: 		return
 424: 	}
 425: 	if !node.Enabled {
 426: 		fail409(c, "节点已停用，不能绑定")
 427: 		return
 428: 	}
 429: 	results := make([]assignmentResult, 0, len(req.DeviceIDs))
 430: 	for _, deviceID := range req.DeviceIDs {
 431: 		r := assignmentResult{DeviceID: deviceID, OK: true}
 432: 		err := s.DB.Transaction(func(tx *gorm.DB) error {
 433: 			var dev models.Device
 434: 			if err := tx.Where("id=?", deviceID).First(&dev).Error; err != nil {
 435: 				r.Error, r.OK = "设备不存在", false
 436: 				return nil
 437: 			}
 438: 			if dev.LifecycleStatus != models.LifecycleApproved {
 439: 				r.Error, r.OK = "设备不是 approved 状态", false
 440: 				return nil
 441: 			}
 442: 			// 先降级旧 primary，再 upsert 新绑定（顺序错会触发 one_primary 唯一索引）
 443: 			if req.IsPrimary {
 444: 				if err := tx.Exec(`UPDATE node_assignments SET is_primary=false
 445: 					WHERE device_id=? AND node_id<>? AND is_primary`, deviceID, req.NodeID).Error; err != nil {
 446: 					r.Error, r.OK = "primary 调整失败", false
 447: 					return nil
 448: 				}
 449: 			}
 450: 			if err := tx.Exec(`INSERT INTO node_assignments (device_id, node_id, is_primary, failover_priority)
 451: 				VALUES (?,?,?,0)
 452: 				ON CONFLICT (device_id, node_id) DO UPDATE SET is_primary=EXCLUDED.is_primary, updated_at=now()`,
 453: 				deviceID, req.NodeID, req.IsPrimary).Error; err != nil {
 454: 				r.Error, r.OK = "绑定写入失败", false
 455: 				return nil
 456: 			}
 457: 			if req.IsPrimary {
 458: 				tx.Model(&models.Device{}).Where("id=?", deviceID).Update("current_node_id", req.NodeID)
 459: 			}
 460: 			if err := auditTx(tx, "admin", a.Username, "assignment_set", fmt.Sprintf("device:%s", deviceID),
 461: 				gin.H{"node_id": req.NodeID, "is_primary": req.IsPrimary, "apply": req.Apply}); err != nil {
 462: 				return err
 463: 			}
 464: 			if req.Apply {
 465: 				taskID, version, err := s.publishAndEnqueue(tx, &dev, &node, a.Username, "")
 466: 				if err != nil {
 467: 					r.Error, r.OK = "发布失败: "+err.Error(), false
 468: 					return nil
 469: 				}
 470: 				r.TaskID, r.Version = taskID, version
 471: 			}
 472: 			return nil
 473: 		})
 474: 		if err != nil {
 475: 			r.OK, r.Error = false, "事务失败: "+err.Error()
 476: 		}
 477: 		results = append(results, r)
 478: 	}
 479: 	c.JSON(http.StatusOK, gin.H{"items": results, "apply": req.Apply})
 480: }
   1: package httpserver
   2: 
   3: // 配置发布管线（§7.5 / §19.3）：
   4: //   preview → 掩码 YAML + revision + diff（不发布、不进版本）
   5: //   apply   → 校验 revision 未变，发布不可变版本 + 签名 + 原子入队 switch 任务
   6: //   订阅    → 只返回已发布最新版本；GET 不生成版本、不改生效状态
   7: 
   8: import (
   9: 	"fmt"
  10: 	"net/http"
  11: 	"os"
  12: 	"path/filepath"
  13: 	"regexp"
  14: 	"strings"
  15: 	"time"
  16: 
  17: 	"github.com/gin-gonic/gin"
  18: 	"github.com/google/uuid"
  19: 	"gorm.io/gorm"
  20: 
  21: 	"routermgmt/internal/clash"
  22: 	"routermgmt/internal/crypto"
  23: 	"routermgmt/internal/models"
  24: )
  25: 
  26: // resolveRenderNodes 解析设备可用的渲染节点：授权绑定且 enabled（§7.6），
  27: // primary 在前；必须有且仅有一个 primary（§19.3）。
  28: func (s *Server) resolveRenderNodes(tx *gorm.DB, dev *models.Device) ([]clash.NodeRender, *models.Node, error) {
  29: 	type row struct {
  30: 		ID        int64 `gorm:"column:id"`
  31: 		IsPrimary bool  `gorm:"column:is_primary"`
  32: 	}
  33: 	var ids []row
  34: 	if err := tx.Raw(`SELECT n.id, a.is_primary FROM node_assignments a
  35: 		JOIN nodes n ON n.id=a.node_id
  36: 		WHERE a.device_id=? AND n.enabled=true
  37: 		ORDER BY a.is_primary DESC, a.failover_priority, n.priority DESC, n.id`, dev.ID).Scan(&ids).Error; err != nil {
  38: 		return nil, nil, err
  39: 	}
  40: 	if len(ids) == 0 {
  41: 		return nil, nil, errNoBindableNode
  42: 	}
  43: 	primaryCount := 0
  44: 	for _, r := range ids {
  45: 		if r.IsPrimary {
  46: 			primaryCount++
  47: 		}
  48: 	}
  49: 	if primaryCount != 1 {
  50: 		return nil, nil, fmt.Errorf("设备必须且只能有一个 primary 绑定节点（当前 %d 个）", primaryCount)
  51: 	}
  52: 	var out []clash.NodeRender
  53: 	var primary *models.Node
  54: 	for _, r := range ids {
  55: 		var n models.Node
  56: 		if err := tx.First(&n, r.ID).Error; err != nil {
  57: 			return nil, nil, err
  58: 		}
  59: 		p := s.decryptNodeParams(&n)
  60: 		out = append(out, clash.NodeRender{
  61: 			ID: n.ID, Name: n.Name, Proto: n.Proto, Host: n.Host, Port: n.Port,
  62: 			UUID: p.UUID, PBK: p.PBK, SNI: p.SNI, SID: p.SID, Flow: p.Flow, FP: p.FP,
  63: 			Password: p.Password, WSPath: p.WSPath, WSHost: p.WSHost,
  64: 		})
  65: 		if r.IsPrimary {
  66: 			cp := n
  67: 			primary = &cp
  68: 		}
  69: 	}
  70: 	return out, primary, nil
  71: }
  72: 
  73: var errNoBindableNode = fmt.Errorf("没有可用绑定节点，拒绝发布（保留当前配置）")
  74: 
  75: // mgmtDirectIPs 管理面直连地址（WG endpoint 为 IPv4 字面量时加入）。
  76: func (s *Server) mgmtDirectIPs() []string {
  77: 	host := s.Cfg.WGHubEndpoint
  78: 	if i := strings.LastIndex(host, ":"); i > 0 {
  79: 		host = host[:i]
  80: 	}
  81: 	if host != "" && isIPv4Literal(host) {
  82: 		return []string{host}
  83: 	}
  84: 	return nil
  85: }
