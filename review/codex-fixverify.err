 111: func (s *Server) devicePolicy(dev *models.Device) gin.H {
 112: 	vpsHost := ""
 113: 	if dev.CurrentNodeID != nil {
 114: 		var n models.Node
 115: 		if err := s.DB.First(&n, *dev.CurrentNodeID).Error; err == nil {
 116: 			if ip := net.ParseIP(n.Host); ip != nil && ip.To4() != nil {
 117: 				vpsHost = n.Host
 118: 			}
 119: 		}
 120: 	}
 121: 	var exp any
 122: 	if dev.LicenseExpiresAt != nil {
 123: 		exp = dev.LicenseExpiresAt.UTC().Format(time.RFC3339)
 124: 	} else {
 125: 		exp = nil
 126: 	}
 127: 	return gin.H{
 128: 		"service_active":     deviceServiceActive(dev, time.Now().UTC()),
 129: 		"vps_limit_kbps":     dev.VpsLimitKbps,
 130: 		"reboot_cron":        dev.RebootCron,
 131: 		"license_enabled":    dev.LicenseEnabled,
 132: 		"license_expires_at": exp,
 133: 		"vps_host":           vpsHost,
 134: 		"proxy_mode":         orDefault(dev.ProxyMode, "rule"),
 135: 		"access_mode":        orDefault(dev.AccessMode, "all"),
 136: 		"access_list":        dev.AccessList,
 137: 	}
 138: }
 139: 
 140: func orDefault(s, d string) string {
 141: 	if s == "" {
 142: 		return d
 143: 	}
 144: 	return s
 145: }
