   1: #!/bin/sh
   2: # self-heal.sh v3.1 - safe version (2026-10-30 v3.1 fleet patch)
   3: # Runs from cron every minute. Only restarts dead services, never reboots.
   4: # v3.1 changes (R6 回滚事故复盘 2026-10-30 晚):
   5: #   - pidof 检测在本平台不可靠（agent 以 /bin/sh 运行，进程名是 sh）——误判会在
   6: #     配置应用中途重启 agent 导致事务回滚（R6 实证）。改用 ps + /proc/cmdline 双检。
   7: #   - 应用事务进行中（state/txn/*/uncommitted 存在）绝不重启 agent。
   8: #   - 18443 不通但心跳文件新鲜（10 分钟内）= 平台侧问题而非 agent 死，跳过重启。
   9: # v3 changes (field test on R4):
  10: #   - port-based detection instead of ps grep (ps unreliable on this BusyBox)
  11: #   - mihomo: check port 9090 API responding
  12: #   - agent: check port 18443 management responding (tunnel alive = agent alive)
  13: # v2 changes (Codex review):
  14: #   - removed auto-reboot (midnight cron is the fallback)
  15: #   - removed tunnel restart (preserves rssh rescue channel)
  16: #   - mkdir-based atomic lock
  17: #   - 300s cooldown per service (prevents crash-restart loops)
  18: #   - suppress during maintenance window (touch /tmp/selfheal.pause)
  19: 
  20: # Maintenance suppression
  21: [ -f /tmp/selfheal.pause ] && exit 0
  22: 
  23: # Atomic lock via mkdir
  24: LOCK=/tmp/selfheal.lock.d
  25: mkdir "$LOCK" 2>/dev/null || {
  26:     _now=$(date +%s)
  27:     _created=$(cat "$LOCK/ts" 2>/dev/null || echo 0)
  28:     _diff=$((_now - _created))
  29:     [ "$_diff" -lt 180 ] && exit 0
  30:     rm -rf "$LOCK"
  31:     mkdir "$LOCK" 2>/dev/null || exit 0
  32: }
  33: echo "$(date +%s)" > "$LOCK/ts"
  34: trap 'rm -rf "$LOCK"' EXIT
  35: 
  36: # 1) mihomo dead? Check API port 9090 responding (not ps grep)
  37: if ! curl -s -m 3 -o /dev/null -w '' http://127.0.0.1:9090/version 2>/dev/null; then
  38:     _cd=/tmp/selfheal.mihomo.cd
  39:     _now=$(date +%s)
  40:     _last=$(cat $_cd 2>/dev/null || echo 0)
  41:     if [ $(($_now - _last)) -ge 300 ]; then
  42:         echo $_now > $_cd
  43:         logger -t self-heal "mihomo API not responding, restarting"
  44:         /etc/init.d/mihomo restart 2>/dev/null
  45:     fi
  46: fi
  47: 
  48: # 2) agent dead? (v3.1: 可靠进程检测 + 事务保护 + 心跳新鲜度)
  49: _agent_dead=0
  50: if ! ps w 2>/dev/null | grep -v grep | grep -q "routermgmt-agent"; then
  51:     _found=0
  52:     for _d in /proc/[0-9]*/cmdline; do
  53:         grep -q "routermgmt-agent" "$_d" 2>/dev/null && { _found=1; break; }
  54:     done
  55:     [ "$_found" = "0" ] && { _agent_dead=1; _reason="process dead"; }
  56: elif ! curl -sk -m 3 -o /dev/null https://127.0.0.1:18443/api/v1/health 2>/dev/null; then
  57:     if [ -z "$(find /etc/routermgmt/state/hb.json -mmin -10 2>/dev/null)" ]; then
  58:         _agent_dead=1
  59:         _reason="mgmt port not responding and heartbeat stale"
  60:     fi
  61: fi
  62: if [ "$_agent_dead" = "1" ]; then
  63:     if [ -n "$(ls /etc/routermgmt/state/txn/*/uncommitted 2>/dev/null)" ]; then
  64:         logger -t self-heal "apply txn in progress, skip agent restart"
  65:     else
  66:         _cd=/tmp/selfheal.agent.cd
  67:         _now=$(date +%s)
  68:         _last=$(cat $_cd 2>/dev/null || echo 0)
  69:         if [ $(($_now - _last)) -ge 300 ]; then
  70:             echo $_now > $_cd
  71:             logger -t self-heal "agent ${_reason}, restarting"
  72:             /etc/init.d/routermgmt restart 2>/dev/null
  73:         fi
  74:     fi
  75: fi
  76: 
  77: # NOTE: No tunnel restart (preserves rssh rescue channel).
  78: # No auto-reboot (midnight 00:00 cron is the fallback).
  79: 
  80: exit 0
   1: #!/bin/sh /etc/rc.common
   2: # routermgmt agent procd service (repo ships no init script; deployed alongside install-agent.sh)
   3: USE_PROCD=1
   4: START=99
   5: STOP=10
   6: 
   7: start_service() {
   8:     procd_open_instance
   9:     procd_set_param command /usr/bin/routermgmt-agent
  10:     procd_set_param env RM_CURL_OPTS="-sS -m 10 -k"
  11:     procd_set_param respawn 3600 0 0
  12:     procd_set_param stdout 1
  13:     procd_set_param stderr 1
  14:     procd_close_instance
  15: }

