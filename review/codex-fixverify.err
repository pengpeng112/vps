 168: // publishAndEnqueue 发布不可变版本并原子入队（同一事务，§19.3）。
 169: // idemKey 可为空（apply 未带幂等键时生成唯一值）。
 170: // 若最新已发布内容与本次完全一致，则复用版本不重复发布（版本号仍单调）。
 171: func (s *Server) publishAndEnqueue(tx *gorm.DB, dev *models.Device, node *models.Node, actor, idemKey string) (string, int64, error) {
 172: 	yamlBytes, nodes, err := s.renderFor(tx, dev)
 173: 	if err != nil {
 174: 		return "", 0, err
 175: 	}
 176: 	sum := crypto.SHA256Hex(yamlBytes)
 177: 
 178: 	// 复用内容一致的最新版本（重复 switch 同一配置不膨胀版本）
 179: 	var existing models.Config
 180: 	reuse := false
 181: 	if err := tx.Raw(`SELECT * FROM configs WHERE device_id=? ORDER BY version DESC LIMIT 1`, dev.ID).Scan(&existing).Error; err == nil && existing.ID > 0 && existing.SHA256 == sum {
 182: 		reuse = true
 183: 	}
 184: 	var cfg models.Config
 185: 	if reuse {
 186: 		cfg = existing
 187: 	} else {
 188: 		var maxVer int64
 189: 		tx.Raw(`SELECT COALESCE(MAX(version),0) FROM configs WHERE device_id=?`, dev.ID).Scan(&maxVer)
 190: 		cfg = models.Config{
 191: 			DeviceID: dev.ID, Kind: "clash_yaml", Version: maxVer + 1,
 192: 			SHA256: sum, CreatedBy: actor,
 193: 		}
 194: 		enc, err := crypto.Encrypt(s.MasterKey, yamlBytes, fmt.Sprintf("configs:%s:v%d:content", dev.ID, cfg.Version))
 195: 		if err != nil {
 196: 			return "", 0, err
 197: 		}
 198: 		sig, err := s.signing.Sign(yamlBytes, dev.ID, cfg.Version)
 199: 		if err != nil {
 200: 			return "", 0, err
 201: 		}
 202: 		cfg.Signature = sig
 203: 		cfg.ContentEnc = enc
 204: 		if err := tx.Create(&cfg).Error; err != nil {
 205: 			return "", 0, err
 206: 		}
 207: 		enc, err = crypto.Encrypt(s.MasterKey, yamlBytes, fmt.Sprintf("configs:%d:content", cfg.ID))
 208: 		if err != nil {
 209: 			return "", 0, err
 210: 		}
 211: 		// 用记录 ID 作为 AAD 重存（绑定记录 ID，§8）
 212: 		if err := tx.Model(&models.Config{}).Where("id=?", cfg.ID).Update("content_enc", enc).Error; err != nil {
 213: 			return "", 0, err
 214: 		}
 215: 	}
 216: 	// 期望版本 + 任务入队
 217: 	if err := tx.Model(&models.Device{}).Where("id=?", dev.ID).Updates(map[string]any{
 218: 		"desired_config_version": cfg.Version,
 219: 		"updated_at":             time.Now().UTC(),
 220: 	}).Error; err != nil {

