 465: // applyTaskSideEffects 结果副作用：版本推进 / 回滚计数 / 告警（同事务）。
 466: func (s *Server) applyTaskSideEffects(tx *gorm.DB, t *models.Task, status string, detail map[string]any) {
 467: 	isConfigTask := t.Type == "switch_node" || t.Type == "reload_proxy"
 468: 	now := time.Now().UTC()
 469: 	// 先读当前 streak（更新前），保证「连续 2 次」判定不受同事务更新影响
 470: 	var devBefore models.Device
 471: 	tx.Where("id=?", t.DeviceID).First(&devBefore)
 472: 	updates := map[string]any{"updated_at": now}
 473: 	newStreak := devBefore.RollbackStreak
 474: 	switch {
 475: 	case status == models.TaskOK && isConfigTask && t.ConfigVersion != nil:
 476: 		updates["current_config_version"] = *t.ConfigVersion
 477: 		if *t.ConfigVersion > 0 {
 478: 			updates["highest_accepted_version"] = gorm.Expr("GREATEST(highest_accepted_version, ?)", *t.ConfigVersion)
 479: 		}
 480: 		updates["rollback_streak"] = 0
 481: 		newStreak = 0
 482: 	case status == models.TaskRolledBack && isConfigTask:
 483: 		updates["rollback_streak"] = gorm.Expr("rollback_streak + 1")
 484: 		newStreak = devBefore.RollbackStreak + 1
 485: 	}
 486: 	tx.Model(&models.Device{}).Where("id=?", t.DeviceID).Updates(updates)
 487: 
 488: 	if status == models.TaskRolledBack && isConfigTask && newStreak >= 2 {
 489: 		s.alerts.Raise(tx, "consecutive_rollback", &t.DeviceID, "critical",
 490: 			fmt.Sprintf("设备 %s 连续 %d 次配置回滚，请检查节点或配置", t.DeviceID, newStreak),
 491: 			fmt.Sprintf("consecutive_rollback:%s", t.DeviceID))
 492: 	}
 493: 	if rollbackFailed, _ := detail["rollback_failed"].(bool); rollbackFailed {
 494: 		s.alerts.Raise(tx, "rollback_failed", &t.DeviceID, "critical",
 495: 			fmt.Sprintf("设备 %s 任务 %s 回滚失败，需要人工介入", t.DeviceID, t.ID),
 496: 			fmt.Sprintf("rollback_failed:%s:%s", t.DeviceID, t.ID))
 497: 	}
 498: 	// 任务带出的出口 IP 变化，关联任务 ID（§7.3）
 499: 	if exitIP, _ := detail["exit_ip"].(string); exitIP != "" {
 500: 		var dev models.Device
 501: 		if err := tx.Where("id=?", t.DeviceID).First(&dev).Error; err == nil {
 502: 			if dev.CurrentExitIP != "" && dev.CurrentExitIP != exitIP {
 503: 				s.alerts.Raise(tx, "exit_ip_changed", &dev.ID, "info",
 504: 					fmt.Sprintf("设备 %s 出口 IP 变化 %s -> %s（任务 %s）", dev.ID, dev.CurrentExitIP, exitIP, t.ID),
 505: 					fmt.Sprintf("exit_ip_changed:%s:%s", dev.ID, t.ID))
 506: 			}
 507: 			tx.Model(&models.Device{}).Where("id=?", dev.ID).Update("current_exit_ip", exitIP)
 508: 		}
 509: 	}
 510: }
