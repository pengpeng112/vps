 392: # agent_update：远程升级 agent 自身（2026-09-18）。
 393: # 流程：HMAC 下载签名包 → Ed25519 验签（与配置验签同构）→ sh -n 语法门禁 →
 394: #       备份当前文件 → 原子替换 → 上报 ok → 延迟重启服务（新进程由 procd 拉起）。
 395: # 回滚：tar 还原 agent-bak-*.tar.gz 到 /etc/routermgmt 后 /etc/init.d/routermgmt restart。
 396: task_agent_update() {
 397:     _tj="$1"
 398:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 399:     _ver=$(json_str "$_tj" '$.params.version')
 400:     _af_fail() { persist_result "$_tid" "$_lease" failed "{\"error\":\"$1\",\"version\":\"$_ver\"}"; log "task $_tid agent_update FAILED: $1"; return 0; }
 401:     case "$_ver" in ''|*[!0-9]*) _af_fail "invalid version" ; return ;; esac
 402: 
 403:     _bundle="$STATE_DIR/agent-$_ver.tar.gz"
 404:     _hdr="$STATE_DIR/bundle-$_ver.hdr"
 405:     rm -f "$_bundle" "$_hdr"
 406:     RM_HDR_FILE="$_hdr" api_call GET "/api/v1/agent/bundles/$_ver" /dev/null "$_bundle" > "$STATE_DIR/bundle.code"
 407:     _code=$(cat "$STATE_DIR/bundle.code" 2>/dev/null)
 408:     [ "$_code" = "200" ] || { _af_fail "download http=$_code" ; return; }
 409:     [ -s "$_bundle" ] || { _af_fail "empty bundle" ; return; }
 410:     _sig=$(grep -i '^X-Signature:' "$_hdr" 2>/dev/null | tail -n1 | tr -d '\r' | awk '{print $2}')
 411:     case "$_sig" in ''|*[!0-9a-fA-F]*) _af_fail "no signature header" ; return ;; esac
 412: 
 413:     verify_config_signature "$_bundle" "$_ver" "$_sig" || { _af_fail "signature verify failed" ; return; }
 414: 
 415:     _stage="/tmp/agentupd.$$"
 416:     rm -rf "$_stage"; mkdir -p "$_stage"
 417:     tar -xzf "$_bundle" -C "$_stage" 2>/dev/null || { rm -rf "$_stage"; _af_fail "extract failed" ; return; }
 418:     _na="$_stage/routermgmt-agent.sh"; _nh="$_stage/handlers/switch_node.sh"; _ni="$_stage/init/routermgmt"
 419:     { [ -f "$_na" ] && [ -f "$_nh" ]; } || { rm -rf "$_stage"; _af_fail "bundle layout unexpected" ; return; }
 420:     sh -n "$_na" 2>/dev/null || { rm -rf "$_stage"; _af_fail "agent.sh syntax check failed" ; return; }
 421:     sh -n "$_nh" 2>/dev/null || { rm -rf "$_stage"; _af_fail "handlers syntax check failed" ; return; }
 422:     [ ! -f "$_ni" ] || sh -n "$_ni" 2>/dev/null || { rm -rf "$_stage"; _af_fail "init syntax check failed" ; return; }
 423:     [ ! -f "$_stage/access-fw.sh" ] || sh -n "$_stage/access-fw.sh" 2>/dev/null || { rm -rf "$_stage"; _af_fail "access-fw syntax check failed" ; return; }
 424: 
 425:     _bak="/etc/routermgmt/agent-bak-$(date +%Y%m%d%H%M%S).tar.gz"
 426:     tar -czf "$_bak" -C /etc/routermgmt routermgmt-agent.sh handlers access-fw.sh 2>/dev/null
 427:     cp "$_na" /etc/routermgmt/routermgmt-agent.sh.new
 428:     cp "$_nh" /etc/routermgmt/handlers/switch_node.sh.new
 429:     chmod 700 /etc/routermgmt/routermgmt-agent.sh.new
 430:     chmod 600 /etc/routermgmt/handlers/switch_node.sh.new
 431:     sync
 432:     mv -f /etc/routermgmt/routermgmt-agent.sh.new /etc/routermgmt/routermgmt-agent.sh
 433:     mv -f /etc/routermgmt/handlers/switch_node.sh.new /etc/routermgmt/handlers/switch_node.sh
 434:     cp /etc/routermgmt/routermgmt-agent.sh /usr/bin/routermgmt-agent && chmod 755 /usr/bin/routermgmt-agent
 435:     if [ -f "$_stage/access-fw.sh" ]; then
 436:         cp "$_stage/access-fw.sh" /etc/routermgmt/access-fw.sh && chmod 755 /etc/routermgmt/access-fw.sh
 437:     fi
 438:     if [ -f "$_ni" ]; then
 439:         cp "$_ni" /etc/init.d/routermgmt.new && chmod 755 /etc/init.d/routermgmt.new             && mv -f /etc/init.d/routermgmt.new /etc/init.d/routermgmt
 440:         /etc/init.d/routermgmt enable >/dev/null 2>&1
 441:     fi
 442:     rm -rf "$_stage"
 443: 
 444:     persist_result "$_tid" "$_lease" ok "{\"version\":\"$_ver\",\"backup\":\"$(basename "$_bak")\"}"
 445:     log "task $_tid agent_update ok ver=$_ver backup=$(basename "$_bak"), restarting in 3s"
 446:     flush_pending_results
 447:     ( sleep 3; /etc/init.d/routermgmt restart ) >/dev/null 2>&1 &
 448:     return 0
 449: }
 450: 
 451: # repair_mgmt_tunnel：VPS 侧 mgmt-rssh-probe 探测到 -R 排障口丢失时下发的白名单修复任务
 452: # （2026-09-24 阶段1C）。只允许重启本机 mgmt-tunnel 服务；不接受任何参数命令。
 453: # 立即重启会切断本任务结果上报所走的 -L 心跳通道，故延迟 2s 后台执行。
 454: task_repair_mgmt_tunnel() {
 455:     _tj="$1"
 456:     _tid=$(json_str "$_tj" '$.task_id'); _lease=$(json_str "$_tj" '$.lease_id')
 457:     if [ ! -x /etc/init.d/mgmt-tunnel ]; then
 458:         persist_result "$_tid" "$_lease" failed '{"error":"mgmt-tunnel not installed"}'
 459:         return 0
 460:     fi
 461:     _before=$(pgrep -f 'id_dropbear_mgmt' 2>/dev/null | wc -l)
 462:     ( sleep 2; /etc/init.d/mgmt-tunnel restart ) >/dev/null 2>&1 &
 463:     persist_result "$_tid" "$_lease" ok "{\"restarted\":true,\"instances_before\":$_before}"
 464:     log "task $_tid repair_mgmt_tunnel: restart dispatched (instances_before=$_before)"
 465:     return 0
 466: }
 467: 
 468: # ---- 策略落地：VPS 限速 / 定时重启 / 授权关停（国内直连不限）----
 469: # 只处理 IPv4 点分地址；限速打在本机 input/output（mihomo 本地出站），不碰 LAN→CN。
 470: 
 471: _valid_v4() {
 472:     case "$1" in
 473:         *[!0-9.]*|'') return 1 ;;
 474:     esac
 475:     echo "$1" | awk -F. 'NF==4 && $1>=0 && $1<=255 && $2>=0 && $2<=255 && $3>=0 && $3<=255 && $4>=0 && $4<=255 {ok=1} END{exit ok?0:1}'
 476: }
 477: 
 478: _valid_reboot_cron() {
 479:     case "$1" in
 480:         ''|'0 0 * * *'|'0 8 * * *'|'0 */8 * * *'|'0 */12 * * *') return 0 ;;
 481:         *) return 1 ;;
 482:     esac
 483: }
 484: 
 485: apply_vps_qos_ipt() { # 无 nft 的设备（SN-R1）：只限制本机访问 VPS:443
 486:     _act="$1"; _kbps="$2"; _host="$3"
 487:     iptables -D OUTPUT -j VPS_QOS 2>/dev/null
 488:     iptables -D INPUT -j VPS_QOS_IN 2>/dev/null
 489:     iptables -F VPS_QOS 2>/dev/null
 490:     iptables -X VPS_QOS 2>/dev/null
 491:     iptables -F VPS_QOS_IN 2>/dev/null
 492:     iptables -X VPS_QOS_IN 2>/dev/null
 493:     _valid_v4 "$_host" || return 0
 494:     iptables -N VPS_QOS
 495:     iptables -N VPS_QOS_IN
 496:     iptables -I OUTPUT 1 -j VPS_QOS
 497:     iptables -I INPUT 1 -j VPS_QOS_IN
 498:     if [ "$_act" = "false" ]; then
 499:         iptables -A VPS_QOS -d "$_host" -p tcp --dport 443 -j DROP
 500:         iptables -A VPS_QOS_IN -s "$_host" -p tcp --sport 443 -j DROP
 501:         return 0
 502:     fi
 503:     case "$_kbps" in ''|0|*[!0-9]*) return 0 ;; esac
 504:     _kbytes=$(( _kbps / 8 ))
 505:     [ "$_kbytes" -lt 1 ] && _kbytes=1
 506:     iptables -A VPS_QOS -d "$_host" -p tcp --dport 443 -m hashlimit \
 507:         --hashlimit-name vpsup --hashlimit-mode dstip \
 508:         --hashlimit-above ${_kbytes}kb/s --hashlimit-burst ${_kbytes}kb -j DROP
 509:     iptables -A VPS_QOS_IN -s "$_host" -p tcp --sport 443 -m hashlimit \
 510:         --hashlimit-name vpsdown --hashlimit-mode srcip \

 succeeded in 1907ms:
   1: # 设备升级标准流程（v2.0 合并版）— 2026-10-31 定稿
   2: 
   3: > 依据：10-29~31 R1-R8 升级与应急修复全部实战（含 R8 全链路恢复、R6 回滚事故、R7 五次迭代）+ Codex 三轮审查。
   4: > 所有 AI 会话按此流程操作设备，不得偏离。**每台设备独立走完全部关卡，禁止把单台验收外推全舰队。**
   5: > 适用：既有 SN-R 设备的任何升级；新设备首次刷机仍走 `scripts/flash-snr.py`（本文只管"刷过之后"）。
   6: > 本文取代 `docs/current/` 下同名 v1.0（已删除，避免双份分叉）。
   7: 
   8: ---
   9: 
  10: ## 一、核心原则（不可违反）
  11: 
  12: | # | 原则 | 出处 |
  13: |---|---|---|
  14: | P1 | **禁止通过反向 SSH echo/base64 链推送文件**；文件只走 SCP/SFTP/LAN | R8 10-29 文件损坏全服务挂 |
  15: | P2 | **一次只推一个变更，验证通过再推下一个** | R8 一次推 6 组件全失败 |
  16: | P3 | **改动前备份原文件 + 记录 md5** | 每轮脚本标配 |
  17: | P4 | respawn 修改后 `/etc/init.d/<svc> restart` 即生效（procd 重建实例重读参数），**无需整机断电重启** | R8 10-31 实测（uptime 33min 未重启整机，服务稳定） |
  18: | P5 | **-L 与 -R 是独立实例，分开验证**（-L 通不代表 -R 通） | Codex 实证 |
  19: | P6 | 应急脚本走本地 LAN（向日葵），不走远程隧道 | LAN 直连可靠 |
  20: | P7 | self-heal v3.1 事务保护不绕过；配置应用窗口 `touch /tmp/selfheal.pause` 双保险 | R6 回滚事故 10-30 |
  21: 
  22: ---
  23: 
  24: ## 二、平台硬前提（每次升级前必做）
  25: 
  26: ### 2.1 平台分工（2026-10-31 晚更新：§2.2 已完成）
  27: 
  28: | 平台 | 角色 | 状态 |
  29: |---|---|---|
  30: | 广州 gz-api（nginx 8443 TLS → Go 127.0.0.1:8080） | **全功能主平台**：心跳、任务、配置发布、监控、远程 SSH | ✅ 2026-10-31 完成二进制重编译（含 vless-ws/istarshine）+ CF/CF2 节点导入 + 签名私钥同步 DMIT，R8 v6 发布实测全通 |
  31: | DMIT api 容器 | 参照库/温备（设备不再连它，任务收不到） | ✅ 运行中 |
  32: 
  33: Go 后端无内置 TLS、端口只认 `LISTEN` env（`-port` 参数无效）——10-31 根因定案，勿再试。
  34: 
  35: ### 2.2 ~~第 0 步阻塞项~~（✅ 2026-10-31 晚已完成，留存操作记录）
  36: 
  37: 广州平台补齐实录（后续重建/再迁移照此）：
  38: 1. **二进制**：本地 `mgmt/backend` 交叉编译 `GOOS=linux GOARCH=amd64 CGO_ENABLED=0` → 广州 `/opt/mgmt/server`（旧件备份 `server.bak-20261031`，库备份 `db-backup-20261031.sql`）。
  39: 2. **节点**：DMIT 库 `format()` 导出 nodes 10/11 为 INSERT（密文直拷，密钥一致故有效；布尔值必须输出 `true/false` 字面量——`t`/`f`/整数都会语法错）。
  40: 3. **签名私钥**：DMIT `/data/signing_ed25519(.pub).pem` → 广州 `/data/`（设备端验签公钥认 DMIT 系）。**pub 指纹 DMIT=81b85fe1**，广州自生成的（22ea1f8e）作废。
  41: 4. **MASTER_KEY 教训（X14）**：`mgmt/deploy/.env` 里的值是**过时未生效值**；DMIT 容器与广州 unit 的运行真值=0d5665c7…（两者一致）。**对拍密钥必须取运行中进程/容器的 environ，不能取仓库配置文件**。曾按 .env 换 KEY 导致 TOTP 全 401，回滚即恢复。
  42: 5. 验收链：`strings | grep vless-ws` ≥1 → TOTP 登录 TOKEN_OK → preview diff 方向核对 → apply → 任务 ok → 设备端 G1-G6。
  43: 
  44: ### 2.3 服务器三件套（1 分钟检查）
  45: 
  46: ```bash
  47: curl -sk https://127.0.0.1:8443/api/v1/health   # 200
  48: systemctl is-active nginx gz-api                 # 双 active
  49: ss -tln | grep -E ':8443|:8080|132[0-9]{2}'      # 目标设备反向口状态
  50: ```
  51: 任一不满足 → 先修平台再动设备。广州 8443 **公网必须保持 000**（安全组收口；设备走 SSH -L 不受影响）。
  52: 
  53: ---
  54: 
  55: ## 三、设备状态分级与动线
  56: 
  57: | 级别 | 定义 | 允许的操作 |
  58: |---|---|---|
  59: | **S0 全通** | 心跳秒级 + 反向口通 + 出口正常 | 远程逐项升级（§五） |
  60: | **S1 半通** | 心跳通但反向口不通 | 只推平台任务/配置，不推文件 |
  61: | **S2 仅排灾** | 心跳断但反向口通 | 只读诊断，不推文件 |
  62: | **S3 全断** | 心跳和反向口都断 | 向日葵 + 应急脚本（§六） |
  63: | **S4 系统损坏** | SSH 通但命令返回空/文件系统错乱 | 断电重启或重刷（flash-snr.py） |
  64: 
  65: 反向口分配：R1=13222 R2=13223 R4=13224 R5=13225 R6=13226 R3=13227 雅典娜=13228 R7=13229 R8=13230 R9=13231 R10=13232 R11=13233（广州侧）。
  66: 
  67: ---
  68: 
  69: ## 四、目标态基线（升级后每台必须达到）
  70: 
  71: | # | 组件 | 标准值 | 设备端验收 |
  72: |---|---|---|---|
  73: | T1 | tunnel.conf 主端点 | `VPS_HOST=134.175.151.213` `VPS_PORT=28722`（-L + -R） | `grep ^VPS_HOST /etc/routermgmt/tunnel.conf` |
  74: | T2 | GIA 新 IP | `154.36.139.155`（tunnel.conf 与 mihomo config 同步替换） | `grep -c 154\.36\.137\.54 两文件` = 0 |
  75: | T3 | DO 死端点 | `VPS4_HOST/PORT` 注释（DO 无 key，连接风暴） | `grep -c '^#VPS4'` ≥1 |
  76: | T4 | respawn | `respawn 3600 0 0` 两处（routermgmt/mgmt-tunnel） | `grep respawn 两个 init` |
  77: | T5 | self-heal | **v3.1**（md5 329c6081）+ cron `* * * * *` | `head -2 self-heal.sh; crontab -l` |
  78: | T6 | MGMT_URL | `https://127.0.0.1:18443`（18443 主，多端口备选同源） | `grep MGMT_URL agent.conf` |
  79: | T7 | fw3 include | mihomo-ipt include（reload 不丢透明代理） | `uci show firewall \| grep mihomo-ipt` |
  80: | T8 | 时钟 | 与北京时差 <60s（TLS/心跳前提） | `date -u` 对时，漂了先 `ntpd -q -p ntp.aliyun.com` |
  81: | T9 | 心跳 | 广州库 `last_heartbeat_at` ≤90s | 平台 UI / psql |
  82: | T10 | 远程控制 | 广州 132xx LISTEN + sshpass 实登成功 | 广州侧 |
  83: | T11 | 出口 | 7890 代理出当前基准出口（现=GIA 154.36.139.155） | `curl -s -m 10 -x http://127.0.0.1:7890 https://api.ipify.org` |
  84: 
  85: ---
  86: 
  87: ## 五、S0 在线升级（逐项推送，风险从低到高）
  88: 
  89: ```
  90: ① uci 命令（fw3 include、网页密码）— 无文件传输，最安全
  91: ② 小文件 via SCP from 广州（<2KB）
  92: ③ 脚本文件 via SFTP→SCP 链（self-heal.sh、tunnel-watchdog）
  93: ④ init 脚本 via SFTP→SCP 链（最后推，风险最高；推完 sh -n，择窗 restart）
  94: ```
  95: 
  96: - 配置发布（平台任务）：等 §2.2 完成。发布前导出设备当前 config.yaml+md5；发布后核对 desired=accepted；期间 `touch /tmp/selfheal.pause`，验收后删除。
  97: - agent/handler 更新：旧 agent 包（2905/2906）缺多端口选路补丁，**推送前核对包内容与 main 一致**；handler 新文件需 agent restart 才加载。
  98: 
  99: ---
 100: 
 101: ## 六、S3 离线回线（R7/R9/R10/R11 适用）
 102: 
 103: 这些设备 10-14 刷机后端点全部失效（DMIT 旧 IP 被墙、GIA 已换 IP），**通电后隧道必然建不起来**。
 104: 
 105: 1. **通电前**（广州侧）：清目标设备 stale 反向口会话（`ss -tlnp | grep 132xx` → 只杀该口 sshd-session，不动其他）。
 106: 2. **向日葵现场**：`scripts/emergency-kit/fix-router.bat` + `fix-cmds.txt`（plink stdin，勿手敲）。一轮完成 T1-T7，成功判据=现场窗口看到 `HEALTH: 200`、`EGRESS: <GIA IP>`、`AGENT: ≥1`、`CRON: 1`、`ALL_DONE`。
 107: 3. **FAIL 处理**：现场重试不超 1 次；再 FAIL 改跑 `diag-cmds.txt` 收 `DIAG_DONE` 输出回来分析，禁止盲改。
 108: 4. **回管验证**：广州库心跳 ≤90s + 132xx sshpass 实登 + 时钟核对（R8 实证：时钟漂移让 TLS 心跳假死）。
 109: 5. 转路径 A 补齐剩余项（配置发布等 §2.2）。
 110: 
 111: ### 应急脚本维护规则
 112: 
 113: | 规则 | 说明 |
 114: |---|---|
 115: | 修复时间目标 | <60 秒 |
 116: | 文件大小 | <8KB（plink -m 安全范围） |
 117: | 必含 | 隧道修复（T1-T3）+ respawn（T4）+ self-heal v3.1（T5） |
 118: | 可选 | fw3 include（uci 命令，安全） |
 119: | 禁含 | init 脚本推送（太大 + 损坏风险） |
 120: | 修改后 | 必须先在一台在线设备验证一轮再交付现场 |
 121: 
 122: ---
 123: 
 124: ## 七、终验六关卡（每台设备，全过才算完成）
 125: 
 126: | 关 | 检查 | 通过标准 |
 127: |---|---|---|
 128: | G1 | 广州库心跳 | ≤90s 且持续两个周期 |
 129: | G2 | 远程实登 | 132xx sshpass 登录正常返回 |
 130: | G3 | 进程 | mihomo=1、routermgmt-agent≥1 |
 131: | G4 | 出口 | 7890 出基准 IP；gstatic 204 |
 132: | G5 | 一致性 | desired=accepted；旧 GIA IP 计数=0；respawn 两处 3600 0 0 |
 133: | G6 | 自愈在位 | self-heal v3.1 md5 一致 + cron 在 + pause 已清 |
 134: 
 135: 任一关 FAIL → 停止下一台，按 §九排障；**禁止"先推完再说"**。
 136: 
 137: ---
 138: 
 139: ## 八、回退
 140: 
 141: | 变更 | 回退点 |
 142: |---|---|
 143: | tunnel.conf | `.bak`（fix-cmds 自动留） |
 144: | init 脚本 | 替换前 cp 备份（md5 对拍后恢复） |
 145: | mihomo 配置 | 发布前导出 yaml+md5；平台重发上一 accepted 版本 |
 146: | self-heal | 同目录旧版留档；停用=删 cron 行 |
 147: | 广州二进制（§2.2） | 备份的旧 server + restart gz-api |
 148: | 最坏情况 | 向日葵 fix-cmds.txt 全量重铺（T1-T7 幂等可重复） |
 149: 
 150: ---
 151: 
 152: ## 九、禁令清单（坑库）
 153: 
 154: | # | 禁令 | 出处 |
 155: |---|---|---|
 156: | X1 | echo/base64 链远程推文件 | R8 10-29 |
 157: | X2 | 广州 authorized_keys 加 `restrict`（新会话 -R 全断）——只用 `no-pty` | R1 假象 10-30 |
 158: | X3 | respawn 重试上限（必须 3600 0 0） | R8 停摆 10-29 |
 159: | X4 | 重启 mgmt-tunnel 前不查 132xx stale 会话归属 | R8 端口被占 10-30 |
 160: | X5 | gz-relay 与 gz-api 同跑（8443 冲突+假后端） | 广州假后端 10-29 |
 161: | X6 | 期望 Go 原生 TLS / 用 `-port` 参数 | 10-31 根因定案 |
 162: | X7 | self-heal 非 v3.1 在配置应用窗口运行 | R6 回滚 10-30 |
 163: | X8 | 时钟未同步就排障 TLS/心跳 | R8 时钟漂移 10-30 |
 164: | X9 | permitopen 逗号拼接 | AGENTS.md 10-01 |
 165: | X10 | 测量脚本裸 `%`（busybox date 假阴性） | AGENTS.md 10-01 |
 166: | X11 | 断电风险窗口动 dat/闪存写；改 dat 前放开写权限 | AGENTS.md + R11 |
 167: | X12 | 单台验收外推全舰队 / 跳过其他台关卡 | AGENTS.md 铁律 |
 168: | X13 | 模板未同步的平台发配置覆盖现网 | 10-29 记录（已随 §2.2 完成解除） |
 169: | X14 | 用 `mgmt/deploy/.env` 对拍/替换运行密钥（过时值）——**密钥对拍只认运行中进程/容器的 environ** | 10-31 TOTP 全 401 事故 |
 170: | X15 | SQL 导出布尔列用 `%s`（输出 `t`/`f` 报"column t does not exist"）；布尔必须输出 `true/false` 字面量，NULL 数值列用 COALESCE | 10-31 节点导入三次返工 |
 171: 
 172: ---
