 sed -i '/#routermgmt-wifi-restore/d' /etc/crontabs/root 2>/dev/null
 [ -x /etc/init.d/cron ] && /etc/init.d/cron restart 2>/dev/null
 logger -t routermgmt-agent "wifi auto-restored after timeout"
