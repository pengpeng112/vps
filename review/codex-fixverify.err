 179:       - airport-sub
 180:     url: https://www.gstatic.com/generate_204
  73:       - https://doh.pub/dns-query
  74:       - https://dns.alidns.com/dns-query
  75: 
  76: proxies:
  77: #{{NODE_PROXIES}}
  78: 
  79: #{{PROXY_PROVIDERS}}
  80: proxy-groups:
