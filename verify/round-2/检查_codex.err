  91 +class Tel:
  92 +    def __init__(self):
  93 +        self.s = socket.socket(); self.s.settimeout(5)
  94 +        self.s.connect((HOST, 23)); self.buf = b""
  95 +        time.sleep(1.2)
  96 +        try: self.s.recv(4096)
  97 +        except: pass
  98 +    def send(self, line):
  99 +        self.s.sendall(line.encode()+b"\n"); time.sleep(0.4)
 100 +    def until(self, pat, timeout=6):
 101 +        t0 = time.time(); acc = b""
 102 +        while time.time()-t0 < timeout:
 103 +            try:
 104 +                d = self.s.recv(4096)
 105 +                if d: self.buf += d; acc += d
 106 +            except socket.timeout: pass
 107 +            if re.search(pat, (self.buf+acc).decode(errors="replace")): return acc.decode(errors="replace")
 108 +        return acc.decode(errors="replace")
