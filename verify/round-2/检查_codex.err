  25 +def md5_crypt(pw, salt):
  26 +    """glibc 鍏煎 $1$ MD5-crypt锛堢函 python锛學indows 鏃?crypt 妯″潡锛沷penssl 鍙屽悜閲忚嚜鏍￠獙锛夈€?""
  27 +    import hashlib
  28 +    ITOA = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
  29 +    pwB = pw.encode("utf-8"); saltB = salt.encode("utf-8")
  30 +    alt = hashlib.md5(pwB + saltB + pwB).digest()
  31 +    ctx = hashlib.md5()
  32 +    ctx.update(pwB); ctx.update(b"$1$"); ctx.update(saltB)
  33 +    cnt = len(pwB)
  34 +    while cnt > 0:
  35 +        ctx.update(alt[:min(16, cnt)]); cnt -= 16
  36 +    cnt = len(pwB)
  37 +    while cnt > 0:
  38 +        ctx.update(b"\x00" if (cnt & 1) else pwB[:1])
  39 +        cnt >>= 1
  40 +    final = ctx.digest()
  41 +    for i in range(1000):
  42 +        c = hashlib.md5()
  43 +        if i % 2: c.update(pwB)
  44 +        else:     c.update(final)
  45 +        if i % 3: c.update(saltB)
  46 +        if i % 7: c.update(pwB)
  47 +        if i % 2: c.update(final)
  48 +        else:     c.update(pwB)
  49 +        final = c.digest()
  50 +    def to64(v, n):
  51 +        r = ""
  52 +        while n > 0:
  53 +            r += ITOA[v & 0x3f]; v >>= 6; n -= 1
  54 +        return r
  55 +    def grp(a, b, c):
  56 +        return to64((final[a] << 16) | (final[b] << 8) | final[c], 4)
  57 +    return "$1$" + salt + "$" + grp(0,6,12)+grp(1,7,13)+grp(2,8,14)+grp(3,9,15)+grp(4,10,5)+to64(final[11],2)
