   7 +#!/usr/bin/env python3
   8 +# -*- coding: utf-8 -*-
   9 +"""SN-R 批量并行刷机驱动（2026-10-13 固化）
  10 +用法：
  11 +  python flash-batch.py            # 扫描两网段的出厂态设备并全部并行刷机
  12 +  python flash-batch.py --detect   # 只探测不刷机
  13 +  python flash-batch.py --auto     # cron 无人值守：无设备则静默退出
  14 +发现条件：telnet(23) 开放 + root/abc@1234 可登 + MAC 不在现役清单（防误刷现役设备）。
  15 +并行：每台一线程跑 flash-snr.py --host X --num N --rssh R（端口由本驱动预分配防竞争）。
  16 +"""
  17 +import argparse, json, os, re, socket, subprocess, sys, time
  18 +from concurrent.futures import ThreadPoolExecutor
  19 +
  20 +REPO = r"F:\vps"
  21 +LOCK = REPO + r"\backups\.flash-batch.lock"
  22 +SUBNETS = ["192.168.132", "192.168.2"]
  23 +FACTORY_PW = "abc@1234"
  24 +# 现役/已知设备 MAC（含 WiFi 与 pin 段）——扫描命中即排除，绝不误刷
  25 +KNOWN_MAC_PREFIXES = ["a4:d8:ca:14:", "76:a7:c8:e0:4f:"]
  26 +
  27 +def sweep(subnet, port=23, timeout=1):
  28 +    hits = []
  29 +    def probe(ip):
  30 +        try:
  31 +            s = socket.create_connection((ip, port), timeout); s.close(); hits.append(ip)
  32 +        except OSError:
  33 +            pass
  34 +    with ThreadPoolExecutor(max_workers=64) as ex:
  35 +        list(ex.map(probe, [f"{subnet}.{i}" for i in range(2, 255)]))
  36 +    return sorted(hits)
  37 +
  38 +def telnet_fingerprint(ip):
  39 +    """出厂态验证+取指纹；返回 (is_factory, info)"""
  40 +    try:
  41 +        s = socket.socket(); s.settimeout(5)
  42 +        s.connect((ip, 23)); time.sleep(1.2)
  43 +        try: s.recv(4096)
  44 +        except OSError: pass
  45 +        def until(p, t=5):
  46 +            t0 = time.time(); acc = b""
  47 +            while time.time() - t0 < t:
  48 +                try:
  49 +                    d = s.recv(4096)
  50 +                    if d: acc += d
  51 +                except socket.timeout: pass
  52 +                if re.search(p, acc.decode(errors="replace")): return acc.decode(errors="replace")
  53 +            return acc.decode(errors="replace")
  54 +        until(r"login:"); s.sendall(b"root\n"); time.sleep(0.4); until(r"assword:")
  55 +        s.sendall(FACTORY_PW.encode() + b"\n")
  56 +        r = until(r"#", 5)
  57 +        if "#" not in r:
  58 +            s.close(); return False, "telnet登录失败(非出厂口令)"
  59 +        def cmd(c):
  60 +            s.sendall(c.encode() + b"\n"); time.sleep(0.6)
  61 +            return until(r"#", 4)
  62 +        macs = cmd("for I in wan ra0; do [ -d /sys/class/net/$I ] && echo $I $(cat /sys/class/net/$I/address); done")
  63 +        model = cmd("cat /tmp/sysinfo/model 2>/dev/null | head -1")
  64 +        s.close()
  65 +        m = dict(re.findall(r"(wan|ra0): ([0-9a-f:]+)", macs))
  66 +        info = f"model={model.strip().splitlines()[-1] if model.strip() else '?'} wan={m.get('wan','?')} ra0={m.get('ra0','?')}"
  67 +        for pfx in KNOWN_MAC_PREFIXES:
  68 +            if m.get("wan", "").startswith(pfx) or m.get("ra0", "").startswith(pfx):
  69 +                return False, f"现役MAC匹配({pfx})——排除 " + info
  70 +        return True, info
  71 +    except Exception as e:
  72 +        return False, f"探测异常: {e}"
  73 +
  74 +def next_ports(n, start=None):
  75 +    """从 DMIT authorized_keys+监听取当前最大 132xx，预分配 n 个连续端口"""
  76 +    r = subprocess.run(['ssh','-p','28722','-i','C:/Users/Administrator/.ssh/id_rsa_dmit','-o','IdentitiesOnly=yes',
  77 +                        'root@179.255.137.64',
  78 +                        "(grep -oE 'permitlisten=\"127.0.0.1:132[0-9]{2}\"' /root/.ssh/authorized_keys; ss -tln | grep -oE '127.0.0.1:132[0-9]{2}') | grep -oE '132[0-9]{2}' | sort -n | tail -1"],
  79 +                       capture_output=True, text=True, timeout=30)
  80 +    try:
  81 +        mx = int(r.stdout.strip())
  82 +    except ValueError:
  83 +        mx = 13229
  84 +    base = max(mx + 1, int(start) if start else 13230)
  85 +    return [base + i for i in range(n)]
  86 +
  87 +def next_nums(n):
  88 +    """平台现有 SN-R* 最大序号 +1 起取 n 个"""
  89 +    r = subprocess.run(['ssh','-p','28722','-i','C:/Users/Administrator/.ssh/id_rsa_dmit','-o','IdentitiesOnly=yes',
  90 +                        'root@179.255.137.64',
  91 +                        'docker exec routermgmt-db-1 psql -U postgres -d routermgmt -t -c "SELECT name FROM devices WHERE name LIKE \'SN-R%\'"'],
  92 +                       capture_output=True, text=True, timeout=30)
  93 +    nums = [int(m.group(1)) for m in re.finditer(r"SN-R(\d+)", r.stdout)]
  94 +    base = max(nums) + 1 if nums else 8
  95 +    return list(range(base, base + n))
  96 +
  97 +def flash_one(ip, num, rssh, log):
  98 +    p = subprocess.run([sys.executable, "-u", REPO + r"\scripts\flash-snr.py",
  99 +                        "--num", str(num), "--rssh", str(rssh), "--host", ip],
 100 +                       capture_output=True, text=True, timeout=1800, cwd=REPO + r"\scripts")
 101 +    open(log, "w", encoding="utf-8").write(p.stdout + "\n" + p.stderr)
 102 +    ok = p.returncode == 0
 103 +    tail = [l for l in p.stdout.splitlines() if l.strip()][-3:]
 104 +    return ok, num, ip, rssh, " | ".join(tail)
 105 +
 106 +def main():
 107 +    ap = argparse.ArgumentParser()
 108 +    ap.add_argument("--detect", action="store_true")
 109 +    ap.add_argument("--auto", action="store_true", help="无人值守：无设备静默退出")
 110 +    ap.add_argument("--max", type=int, default=4, help="单轮最多刷机台数")
 111 +    args = ap.parse_args()
 112 +
 113 +    # 进程锁：防止 cron 周期与上一轮刷机重叠（锁文件 90 分钟自动失效兜底）
 114 +    if os.path.exists(LOCK):
 115 +        age = time.time() - os.path.getmtime(LOCK)
 116 +        if age < 5400:
 117 +            print(f"上一轮刷机仍在进行（锁 {int(age/60)} 分钟前），本轮退出")
 118 +            return
 119 +        print(f"⚠️ 检测到遗留刷机锁（{int(age/60)} 分钟）——上轮可能挂起，自动解锁续扫（详见 backups/.flash-N*.log）")
 120 +    open(LOCK, "w").write(str(time.time()))
 121 +
 122 +    print(f"[{time.strftime('%F %T')}] 扫描出厂态设备（{', '.join(SUBNETS)}.0/24）...")
 123 +    found = []
 124 +    try:
 125 +        for sn in SUBNETS:
 126 +            for ip in sweep(sn):
 127 +                isf, info = telnet_fingerprint(ip)
 128 +                print(f"  {ip}: {'✓出厂态' if isf else '跳过'} — {info}")
 129 +                if isf: found.append(ip)
 130 +    finally:
 131 +        if not found or args.detect:
 132 +            os.remove(LOCK)
 133 +    if not found:
 134 +        print("未发现出厂态设备" + ("（auto 静默退出）" if args.auto else "——请确认设备已上电且 WAN/LAN 已接入两网段之一"))
 135 +        return
 136 +    if args.detect:
 137 +        print(f"共 {len(found)} 台待刷: {found}")
 138 +        return
 139 +    found = found[:args.max]
 140 +    ports = next_ports(len(found))
 141 +    nums = next_nums(len(found))
 142 +    print(f"刷机分配: {list(zip(found, nums, ports))}（并行）")
 143 +    jobs = [(ip, nums[i], ports[i], REPO + rf"\backups\.flash-N{nums[i]}.log") for i, ip in enumerate(found)]
 144 +    results = []
 145 +    with ThreadPoolExecutor(max_workers=len(jobs)) as ex:
 146 +        futs = [ex.submit(flash_one, *j) for j in jobs]
 147 +        for f in futs:
 148 +            results.append(f.result())
 149 +    print(f"\n===== 批量结果 =====")
 150 +    for ok, num, ip, rssh, tail in results:
 151 +        print(f"  {'✅' if ok else '❌'} SN-R{num} @ {ip} (RSSH {rssh}): {tail}")
 152 +    try: os.remove(LOCK)
 153 +    except OSError: pass
 154 +
 155 +if __name__ == "__main__":
 156 +    main()
