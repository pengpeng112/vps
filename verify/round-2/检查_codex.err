 115 +def push(c, local, remote, mode=None):
 116 +    data = open(local, "rb").read()
 117 +    _, o, e = c.exec_command(f"cat > '{remote}'", timeout=180)
 118 +    o.channel.sendall(data); o.channel.shutdown_write(); o.read()
 119 +    if mode: c.exec_command(f"chmod {mode} '{remote}'")[1].read()
 120 +
 121 +def run(c, script, timeout=240):
 122 +    _, o, e = c.exec_command(script, timeout=timeout)
 123 +    return (o.read()+e.read()).decode(errors="replace")
