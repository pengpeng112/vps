FILE mgmt/backend/internal/clash/template.go
1: // Package clash 黄金模板渲染（任务书 §3.2）。
2: // 只允许动态替换：节点列表、节点组成员、节点直连地址、管理面直连地址。
3: // Session 1 节点 host 仅支持 IPv4 字面量；域名/IPv6 返回明确校验错误。
4: package clash
5: 
6: import (
7: 	"embed"
8: 	"errors"
9: 	"fmt"
10: 	"net"
11: 	"regexp"
12: 	"strings"
13: 
14: 	"routermgmt/internal/crypto"
15: )
16: 
17: //go:embed golden.yaml
18: var goldenFS embed.FS
19: 
20: const markerNodeProxies = "#{{NODE_PROXIES}}"
21: const markerGroupProxy = "#{{GROUP_PROXY_MEMBERS}}"
22: const markerGroupAuto = "#{{GROUP_AUTO_MEMBERS}}"
23: const markerNodeDirect = "#{{NODE_DIRECT_RULES}}"
24: 
25: var reNodeName = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$`)
26: 
27: // hysteria2 密码：限定字母数字与 -_（16~64 位），保证可安全嵌入 YAML 裸标量
28: var reHy2Password = regexp.MustCompile(`^[A-Za-z0-9_-]{16,64}$`)
29: 
30: // 支持的节点协议（nodes.Proto 存量数据为空串，按 vless-reality 处理）
31: const (
32: 	ProtoVLESS = "vless-reality"
33: 	ProtoHy2   = "hysteria2"
34: )
35: 
36: // ValidHy2Password hysteria2 密码校验（节点 API 与渲染共用同一规则）。
37: func ValidHy2Password(pw string) bool { return reHy2Password.MatchString(pw) }
38: 
39: // NodeRender 参与渲染的节点（已从 AES-GCM 信封解出参数）。
40: type NodeRender struct {
41: 	ID       int64
42: 	Name     string
43: 	Proto    string // vless-reality | hysteria2（空串= vless-reality）
44: 	Host     string
45: 	Port     int
46: 	UUID     string
47: 	PBK      string
48: 	SNI      string
49: 	SID      string
50: 	Flow     string
51: 	FP       string
52: 	Password string // hysteria2
53: }
54: 
55: // RenderInput 渲染输入。
56: type RenderInput struct {
57: 	DeviceID       string
58: 	Nodes          []NodeRender // 按优先级排序，第一个为 primary
59: 	MgmtDirectIPs  []string     // 管理面 WG endpoint 等需直连的 IPv4
60: }
61: 
62: // ValidateNodeName 校验节点名可安全嵌入 YAML/任务参数。
63: func ValidateNodeName(name string) bool { return reNodeName.MatchString(name) }
64: 
65: // validateHost Session 1 仅支持 IPv4 字面量（域名/IPv6 在实现解析与直连规则前拒绝）。
66: func validateHost(host string) error {
67: 	ip := net.ParseIP(host)
68: 	if ip == nil || ip.To4() == nil || strings.Contains(host, ":") {
69: 		return fmt.Errorf("节点 host %q 不是 IPv4 字面量：Session 1 仅支持 IPv4，域名/IPv6 需先实现解析与对应直连规则", host)
70: 	}
71: 	return nil
72: }
73: 
74: // Render 生成设备订阅 YAML（原始字节，含凭据；随后必须签名，禁止改动）。
75: func Render(in RenderInput) ([]byte, error) {
76: 	if len(in.Nodes) == 0 {
77: 		return nil, errors.New("没有可用的绑定节点，拒绝生成配置")
78: 	}
79: 	var proxies, groupProxy, groupAuto, directRules []string
80: 	for _, n := range in.Nodes {
81: 		if !ValidateNodeName(n.Name) {
82: 			return nil, fmt.Errorf("节点名 %q 不合法（仅允许字母数字与 - _，长度 2~32）", n.Name)
83: 		}
84: 		if err := validateHost(n.Host); err != nil {
85: 			return nil, err
86: 		}
87: 		if n.Port < 1 || n.Port > 65535 {
88: 			return nil, fmt.Errorf("节点 %s 端口不合法", n.Name)
89: 		}
90: 		switch n.Proto {
91: 		case "", ProtoVLESS:
92: 			if err := renderVLESS(&n, &proxies); err != nil {
93: 				return nil, err
94: 			}
95: 		case ProtoHy2:
96: 			if !ValidHy2Password(n.Password) {
97: 				return nil, fmt.Errorf("节点 %s hysteria2 密码不合法（需 16~64 位字母数字/-_）", n.Name)
98: 			}
99: 			// 服务端自签证书（内部管理面使用），客户端跳过证书校验，接入靠密码鉴权
100: 			proxies = append(proxies, fmt.Sprintf(`  - name: "%s"
101:     type: hysteria2
102:     server: %s
103:     port: %d
104:     password: %s
105:     udp: true
106:     skip-cert-verify: true`, n.Name, n.Host, n.Port, n.Password))
107: 		default:
108: 			return nil, fmt.Errorf("节点 %s 协议 %q 不支持（当前仅 vless-reality / hysteria2）", n.Name, n.Proto)
109: 		}
110: 		groupProxy = append(groupProxy, fmt.Sprintf("      - %s", n.Name))
111: 		groupAuto = append(groupAuto, fmt.Sprintf("      - %s", n.Name))
112: 		// 节点自身公网 IP 直连：不做这条，TUN 会把 SSH 绕回节点（§3.1）
113: 		directRules = append(directRules, fmt.Sprintf("  - IP-CIDR,%s/32,DIRECT,no-resolve", n.Host))
114: 	}
115: 	// 管理面 WG endpoint 直连，避免 WG 套入代理（§3.2 末段）
116: 	for _, ip := range in.MgmtDirectIPs {
117: 		if err := validateHost(ip); err != nil {
118: 			return nil, fmt.Errorf("管理面直连地址 %q 无效: %w", ip, err)
119: 		}
120: 		rule := fmt.Sprintf("  - IP-CIDR,%s/32,DIRECT,no-resolve", ip)
121: 		if !containsStr(directRules, rule) {
122: 			directRules = append(directRules, rule)
123: 		}
124: 	}
125: 
126: 	raw, err := goldenFS.ReadFile("golden.yaml")
127: 	if err != nil {
128: 		return nil, err
129: 	}
130: 	var out []string
131: 	for _, line := range strings.Split(string(raw), "\n") {
132: 		trimmed := strings.TrimSpace(line)
133: 		switch trimmed {
134: 		case markerNodeProxies:
135: 			out = append(out, proxies...)
136: 		case markerGroupProxy:
137: 			out = append(out, groupProxy...)
138: 		case markerGroupAuto:
139: 			out = append(out, groupAuto...)
140: 		case markerNodeDirect:
141: 			out = append(out, directRules...)
142: 		default:
143: 			out = append(out, line)
144: 		}
145: 	}
146: 	// 标记全部被替换，残留说明模板被破坏
147: 	joined := strings.Join(out, "\n")
148: 	for _, m := range []string{markerNodeProxies, markerGroupProxy, markerGroupAuto, markerNodeDirect} {
149: 		if strings.Contains(joined, m) {
150: 			return nil, fmt.Errorf("黄金模板标记 %s 未被替换", m)
151: 		}
152: 	}
153: 	return []byte(joined), nil
154: }
155: 
156: func containsStr(list []string, s string) bool {
157: 	for _, v := range list {
158: 		if v == s {
159: 			return true
160: 		}
161: 	}
162: 	return false
163: }
164: 
165: // renderVLESS vless-reality 节点参数校验与出站段渲染。
166: func renderVLESS(n *NodeRender, proxies *[]string) error {
167: 	if !crypto.ValidUUID(n.UUID) {
168: 		return fmt.Errorf("节点 %s uuid 参数不合法", n.Name)
169: 	}
170: 	if !crypto.ValidPBK(n.PBK) {
171: 		return fmt.Errorf("节点 %s pbk 参数不合法", n.Name)
172: 	}
173: 	if !crypto.ValidSID(n.SID) {
174: 		return fmt.Errorf("节点 %s sid 参数不合法", n.Name)
175: 	}
176: 	sni := n.SNI
177: 	if sni == "" {
178: 		sni = "www.microsoft.com"
179: 	}
180: 	flow := n.Flow
181: 	if flow == "" {
182: 		flow = "xtls-rprx-vision"
183: 	}
184: 	fp := n.FP
185: 	if fp == "" {
186: 		fp = "chrome"
187: 	}
188: 	*proxies = append(*proxies, fmt.Sprintf(`  - name: "%s"
189:     type: vless
190:     server: %s
191:     port: %d
192:     uuid: %s
193:     network: tcp
194:     udp: true
195:     tls: true
196:     flow: %s
197:     servername: %s
198:     client-fingerprint: %s
199:     reality-opts:
200:       public-key: %s
201:       short-id: %s`, n.Name, n.Host, n.Port, n.UUID, flow, sni, fp, n.PBK, n.SID))
202: 	return nil
203: }
204: 
205: var reSecretLine = regexp.MustCompile(`^(\s+(?:uuid|password|public-key|short-id): )(\S+)$`)
206: 
207: // MaskYAML 将渲染结果中的凭据行掩码（uuid/pbk 前后 4 位，sid/password 前后 2 位）。
208: // 仅用于管理端预览/详情展示；原始 YAML 只允许设备经 HMAC/token 下载。
209: func MaskYAML(yamlBytes []byte) string {
210: 	lines := strings.Split(string(yamlBytes), "\n")
211: 	for i, line := range lines {
212: 		m := reSecretLine.FindStringSubmatch(line)
213: 		if m == nil {
214: 			continue
215: 		}
216: 		key := strings.TrimSpace(strings.SplitN(m[1], ":", 2)[0])
217: 		lines[i] = m[1] + crypto.MaskNodeParam(key, m[2])
218: 	}
219: 	return strings.Join(lines, "\n")
220: }

