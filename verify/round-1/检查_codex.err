22: type nodeParams struct {
23: 	UUID     string `json:"uuid"`
24: 	PBK      string `json:"pbk"`
25: 	SNI      string `json:"sni"`
26: 	SID      string `json:"sid"`
27: 	Flow     string `json:"flow"`
28: 	FP       string `json:"fp"`
29: 	Password string `json:"password"` // hysteria2
30: }
31: 
32: // validateForProto 按协议校验必填参数：vless-reality 需要 uuid/pbk/sid；hysteria2 需要 password。
33: func (p nodeParams) validateForProto(proto string) error {
34: 	switch proto {
35: 	case clash.ProtoHy2:
36: 		if !clash.ValidHy2Password(p.Password) {
37: 			return fmt.Errorf("hysteria2 password 不合法（需 16~64 位字母数字/-_）")
38: 		}
39: 		return nil
40: 	case "", clash.ProtoVLESS:
41: 		if !crypto.ValidUUID(p.UUID) {
42: 			return fmt.Errorf("uuid 参数不合法（需标准 UUID）")
43: 		}
44: 		if !crypto.ValidPBK(p.PBK) {
45: 			return fmt.Errorf("pbk 参数不合法（Reality public key，43 字符 base64url）")
46: 		}
47: 		if !crypto.ValidSID(p.SID) {
48: 			return fmt.Errorf("sid 参数不合法（偶数长度 hex，≤16 字符）")
49: 		}
50: 		return nil
51: 	default:
52: 		return fmt.Errorf("proto 仅支持 vless-reality / hysteria2")
53: 	}
54: }
