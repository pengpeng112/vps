81:             </n-form-item>
82:             <n-button type="primary" block :loading="loading" @click="submitCode">缁戝畾骞剁櫥褰?/n-button>
83:           </n-form>
84:         </template>
85: 
86:         <template v-else>
87:           <n-alert type="info">杈撳叆 TOTP 楠岃瘉鐮佸畬鎴愮櫥褰?/n-alert>
88:           <n-form @keyup.enter="submitCode">
89:             <n-form-item label="6 浣嶉獙璇佺爜">
90:               <n-input v-model:value="code" placeholder="TOTP 楠岃瘉鐮? />
91:             </n-form-item>
92:             <n-button type="primary" block :loading="loading" @click="submitCode">鐧诲綍</n-button>
