FILE mgmt/backend/internal/clash/template.go
1: // Package clash 榛勯噾妯℃澘娓叉煋锛堜换鍔′功 搂3.2锛夈€?// 鍙厑璁稿姩鎬佹浛鎹細鑺傜偣鍒楄〃銆佽妭鐐圭粍鎴愬憳銆佽妭鐐圭洿杩炲湴鍧€銆佺鐞嗛潰鐩磋繛鍦板潃銆?// Session 1 鑺傜偣 host 浠呮敮鎸?IPv4 瀛楅潰閲忥紱鍩熷悕/IPv6 杩斿洖鏄庣‘鏍￠獙閿欒銆?package clash
2: 
3: import (
4: 	"embed"
5: 	"errors"
6: 	"fmt"
7: 	"net"
8: 	"regexp"
9: 	"strings"
10: 
11: 	"routermgmt/internal/crypto"
12: )
13: 
14: //go:embed golden.yaml
15: var goldenFS embed.FS
16: 
17: const markerNodeProxies = "#{{NODE_PROXIES}}"
18: const markerGroupProxy = "#{{GROUP_PROXY_MEMBERS}}"
19: const markerGroupAuto = "#{{GROUP_AUTO_MEMBERS}}"
20: const markerNodeDirect = "#{{NODE_DIRECT_RULES}}"
21: 
22: var reNodeName = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$`)
23: 
24: [可能含凭证，整行略去]
25: 
26: // 鏀寔鐨勮妭鐐瑰崗璁紙nodes.Proto 瀛橀噺鏁版嵁涓虹┖涓诧紝鎸?vless-reality 澶勭悊锛?const (
27: 	ProtoVLESS = "vless-reality"
28: 	ProtoHy2   = "hysteria2"
29: )
30: 
31: // ValidHy2Password hysteria2 瀵嗙爜鏍￠獙锛堣妭鐐?API 涓庢覆鏌撳叡鐢ㄥ悓涓€瑙勫垯锛夈€?func ValidHy2Password(pw string) bool { return reHy2Password.MatchString(pw) }
32: 
33: // NodeRender 鍙備笌娓叉煋鐨勮妭鐐癸紙宸蹭粠 AES-GCM 淇″皝瑙ｅ嚭鍙傛暟锛夈€?type NodeRender struct {
34: 	ID       int64
35: 	Name     string
36: 	Proto    string // vless-reality | hysteria2锛堢┖涓? vless-reality锛?	Host     string
37: 	Port     int
38: 	UUID     string
39: 	PBK      string
40: 	SNI      string
41: 	SID      string
42: 	Flow     string
43: 	FP       string
44: 	Password string // hysteria2
45: }
46: 
47: // RenderInput 娓叉煋杈撳叆銆?type RenderInput struct {
48: 	DeviceID       string
49: 	Nodes          []NodeRender // 鎸変紭鍏堢骇鎺掑簭锛岀涓€涓负 primary
50: 	MgmtDirectIPs  []string     // 绠＄悊闈?WG endpoint 绛夐渶鐩磋繛鐨?IPv4
51: }
52: 
53: // ValidateNodeName 鏍￠獙鑺傜偣鍚嶅彲瀹夊叏宓屽叆 YAML/浠诲姟鍙傛暟銆?func ValidateNodeName(name string) bool { return reNodeName.MatchString(name) }
54: 
55: // validateHost Session 1 浠呮敮鎸?IPv4 瀛楅潰閲忥紙鍩熷悕/IPv6 鍦ㄥ疄鐜拌В鏋愪笌鐩磋繛瑙勫垯鍓嶆嫆缁濓級銆?func validateHost(host string) error {
56: 	ip := net.ParseIP(host)
57: 	if ip == nil || ip.To4() == nil || strings.Contains(host, ":") {
58: 		return fmt.Errorf("鑺傜偣 host %q 涓嶆槸 IPv4 瀛楅潰閲忥細Session 1 浠呮敮鎸?IPv4锛屽煙鍚?IPv6 闇€鍏堝疄鐜拌В鏋愪笌瀵瑰簲鐩磋繛瑙勫垯", host)
59: 	}
60: 	return nil
61: }
62: 
63: // Render 鐢熸垚璁惧璁㈤槄 YAML锛堝師濮嬪瓧鑺傦紝鍚嚟鎹紱闅忓悗蹇呴』绛惧悕锛岀姝㈡敼鍔級銆?func Render(in RenderInput) ([]byte, error) {
64: 	if len(in.Nodes) == 0 {
65: 		return nil, errors.New("娌℃湁鍙敤鐨勭粦瀹氳妭鐐癸紝鎷掔粷鐢熸垚閰嶇疆")
66: 	}
67: 	var proxies, groupProxy, groupAuto, directRules []string
68: 	for _, n := range in.Nodes {
69: 		if !ValidateNodeName(n.Name) {
70: 			return nil, fmt.Errorf("鑺傜偣鍚?%q 涓嶅悎娉曪紙浠呭厑璁稿瓧姣嶆暟瀛椾笌 - _锛岄暱搴?2~32锛?, n.Name)
71: 		}
72: 		if err := validateHost(n.Host); err != nil {
73: 			return nil, err
74: 		}
75: 		if n.Port < 1 || n.Port > 65535 {
76: 			return nil, fmt.Errorf("鑺傜偣 %s 绔彛涓嶅悎娉?, n.Name)
77: 		}
78: 		switch n.Proto {
79: 		case "", ProtoVLESS:
80: 			if err := renderVLESS(&n, &proxies); err != nil {
81: 				return nil, err
82: 			}
83: 		case ProtoHy2:
84: 			if !ValidHy2Password(n.Password) {
85: 				return nil, fmt.Errorf("鑺傜偣 %s hysteria2 瀵嗙爜涓嶅悎娉曪紙闇€ 16~64 浣嶅瓧姣嶆暟瀛?-_锛?, n.Name)
86: 			}
87: 			// 鏈嶅姟绔嚜绛捐瘉涔︼紙鍐呴儴绠＄悊闈娇鐢級锛屽鎴风璺宠繃璇佷功鏍￠獙锛屾帴鍏ラ潬瀵嗙爜閴存潈
88: 			proxies = append(proxies, fmt.Sprintf(`  - name: "%s"
89:     type: hysteria2
90:     server: %s
91:     port: %d
92: [可能含凭证，整行略去]
93:     udp: true
94:     skip-cert-verify: true`, n.Name, n.Host, n.Port, n.Password))
95: 		default:
96: 			return nil, fmt.Errorf("鑺傜偣 %s 鍗忚 %q 涓嶆敮鎸侊紙褰撳墠浠?vless-reality / hysteria2锛?, n.Name, n.Proto)
97: 		}
98: 		groupProxy = append(groupProxy, fmt.Sprintf("      - %s", n.Name))
99: 		groupAuto = append(groupAuto, fmt.Sprintf("      - %s", n.Name))
100: 		// 鑺傜偣鑷韩鍏綉 IP 鐩磋繛锛氫笉鍋氳繖鏉★紝TUN 浼氭妸 SSH 缁曞洖鑺傜偣锛埪?.1锛?		directRules = append(directRules, fmt.Sprintf("  - IP-CIDR,%s/32,DIRECT,no-resolve", n.Host))
101: 	}
102: 	// 绠＄悊闈?WG endpoint 鐩磋繛锛岄伩鍏?WG 濂楀叆浠ｇ悊锛埪?.2 鏈锛?	for _, ip := range in.MgmtDirectIPs {
103: 		if err := validateHost(ip); err != nil {
104: 			return nil, fmt.Errorf("绠＄悊闈㈢洿杩炲湴鍧€ %q 鏃犳晥: %w", ip, err)
105: 		}
106: 		rule := fmt.Sprintf("  - IP-CIDR,%s/32,DIRECT,no-resolve", ip)
107: 		if !containsStr(directRules, rule) {
108: 			directRules = append(directRules, rule)
109: 		}
110: 	}
111: 
112: 	raw, err := goldenFS.ReadFile("golden.yaml")
113: 	if err != nil {
114: 		return nil, err
115: 	}
116: 	var out []string
117: 	for _, line := range strings.Split(string(raw), "\n") {
118: 		trimmed := strings.TrimSpace(line)
119: 		switch trimmed {
120: 		case markerNodeProxies:
121: 			out = append(out, proxies...)
122: 		case markerGroupProxy:
123: 			out = append(out, groupProxy...)
124: 		case markerGroupAuto:
125: 			out = append(out, groupAuto...)
126: 		case markerNodeDirect:
127: 			out = append(out, directRules...)
128: 		default:
129: 			out = append(out, line)
130: 		}
131: 	}
132: 	// 鏍囪鍏ㄩ儴琚浛鎹紝娈嬬暀璇存槑妯℃澘琚牬鍧?	joined := strings.Join(out, "\n")
133: 	for _, m := range []string{markerNodeProxies, markerGroupProxy, markerGroupAuto, markerNodeDirect} {
134: 		if strings.Contains(joined, m) {
135: 			return nil, fmt.Errorf("榛勯噾妯℃澘鏍囪 %s 鏈鏇挎崲", m)
136: 		}
137: 	}
138: 	return []byte(joined), nil
139: }
140: 
141: func containsStr(list []string, s string) bool {
142: 	for _, v := range list {
143: 		if v == s {
144: 			return true
145: 		}
146: 	}
147: 	return false
148: }
149: 
150: // renderVLESS vless-reality 鑺傜偣鍙傛暟鏍￠獙涓庡嚭绔欐娓叉煋銆?func renderVLESS(n *NodeRender, proxies *[]string) error {
151: 	if !crypto.ValidUUID(n.UUID) {
152: 		return fmt.Errorf("鑺傜偣 %s uuid 鍙傛暟涓嶅悎娉?, n.Name)
153: 	}
154: 	if !crypto.ValidPBK(n.PBK) {
155: 		return fmt.Errorf("鑺傜偣 %s pbk 鍙傛暟涓嶅悎娉?, n.Name)
156: 	}
157: 	if !crypto.ValidSID(n.SID) {
158: 		return fmt.Errorf("鑺傜偣 %s sid 鍙傛暟涓嶅悎娉?, n.Name)
159: 	}
160: 	sni := n.SNI
161: 	if sni == "" {
162: 		sni = "www.microsoft.com"
163: 	}
164: 	flow := n.Flow
165: 	if flow == "" {
166: 		flow = "xtls-rprx-vision"
167: 	}
168: 	fp := n.FP
169: 	if fp == "" {
170: 		fp = "chrome"
171: 	}
172: 	*proxies = append(*proxies, fmt.Sprintf(`  - name: "%s"
173:     type: vless
174:     server: %s
175:     port: %d
176:     uuid: %s
177:     network: tcp
178:     udp: true
179:     tls: true
180:     flow: %s
181:     servername: %s
182:     client-fingerprint: %s
183:     reality-opts:
184:       public-key: %s
185:       short-id: %s`, n.Name, n.Host, n.Port, n.UUID, flow, sni, fp, n.PBK, n.SID))
186: 	return nil
187: }
188: 
189: var reSecretLine = regexp.MustCompile(`^(\s+(?:uuid|password|public-key|short-id): )(\S+)$`)
190: 
191: // MaskYAML 灏嗘覆鏌撶粨鏋滀腑鐨勫嚟鎹鎺╃爜锛坲uid/pbk 鍓嶅悗 4 浣嶏紝sid/password 鍓嶅悗 2 浣嶏級銆?// 浠呯敤浜庣鐞嗙棰勮/璇︽儏灞曠ず锛涘師濮?YAML 鍙厑璁歌澶囩粡 HMAC/token 涓嬭浇銆?func MaskYAML(yamlBytes []byte) string {
192: 	lines := strings.Split(string(yamlBytes), "\n")
193: 	for i, line := range lines {
194: 		m := reSecretLine.FindStringSubmatch(line)
195: 		if m == nil {
196: 			continue
197: 		}
198: 		key := strings.TrimSpace(strings.SplitN(m[1], ":", 2)[0])
199: 		lines[i] = m[1] + crypto.MaskNodeParam(key, m[2])
200: 	}
201: 	return strings.Join(lines, "\n")
202: }
FILE mgmt/agent/setup-mgmt-tunnel.sh
1: #!/bin/sh
2: # 鍏徃缃?鎷︽埅 UDP 51820 鐨勭幇鍦猴細鐢?SSH TCP 鎶婄鐞嗗績璺崇粫杩囧幓锛堝瀹藉彂璐ц澶囪蛋 WG锛屼笉璺戣繖涓級銆?# 2026-09-24 闃舵1閲嶆瀯锛氱敓鎴?/etc/routermgmt/tunnel.conf锛坕nit 鎸夌櫧鍚嶅崟瑙ｆ瀽锛?# 绠＄悊 -L 涓庢帓闅?-R 鎷嗗弻瀹炰緥锛夛紱pin-hostkey 鍏堟牳瀵规寚绾瑰啀鐢?dbclient 鑷啓鏍煎紡鍥哄寲銆?# 鐢ㄦ硶锛堣矾鐢卞櫒涓婏級锛?#   sh /usr/sbin/setup-mgmt-tunnel.sh [enable] [rssh绔彛] [rssh鐩爣host:port]
3: #   sh /usr/sbin/setup-mgmt-tunnel.sh pin-hostkey SHA256:<鎸囩汗>   # 鎸囩汗缁忓彲淇￠摼璺噰闆嗐€佷汉宸ユ牳瀵瑰悗浼犲叆
4: # 鍙敤鐜鍙橀噺瑕嗙洊榛樿鍊硷細
5: #   TUNNEL_VPS_HOST / TUNNEL_VPS_PORT / TUNNEL_LOCAL_PORT / TUNNEL_MGMT_TARGET
6: #   TUNNEL_RSSH_PORT / TUNNEL_RSSH_TARGET锛堟帓闅?-R锛歏PS 鍥炵幆绔彛涓庤矾鐢卞櫒 SSH 鐩爣锛?# 瀹炴祴娉ㄦ剰锛?026-09-24锛宒ropbear 2025.89/2020.81锛夛細
7: #   - dbclient 鐨?known_hosts 鍥哄畾璇?/root/.ssh/known_hosts锛屼笉鍙?$HOME 褰卞搷
8: #   - 鏉＄洰鏄函涓绘満鍚嶆牸寮忥紙涓嶅甫 [host]:port锛夛紝蹇呴』鐢?dbclient -y 鑷繁鍐欏叆鎵嶅彲闈?set -u
9: KEY=/etc/routermgmt/id_dropbear_mgmt
10: VPS=${TUNNEL_VPS_HOST:-159.223.36.119}
11: PORT=${TUNNEL_VPS_PORT:-28722}
12: LOCAL=${TUNNEL_LOCAL_PORT:-18443}
13: HUB=${TUNNEL_MGMT_TARGET:-10.10.0.1:8443}
14: KH=/root/.ssh/known_hosts
15: 
16: mode="${1:-setup}"
17: mkdir -p /etc/routermgmt
18: 
19: # ---- pin-hostkey SHA256:<鎸囩汗> ----
20: # 娴佺▼锛氭棤 -y 鎺㈡祴涓€娆℃嬁鍒版湇鍔＄鎸囩汗锛坰tdin EOF 鑷姩閫€鍑猴級鈫?涓庝紶鍏ユ寚绾规瘮瀵?鈫?#       涓€鑷存墠娓呯┖閲嶅啓锛坮m + 鍗曟 -y 杩炴帴璁?dbclient 鑷瓨锛夆啋 鏃?-y 澶嶈繛楠岃瘉銆?if [ "$mode" = "pin-hostkey" ]; then
21:     FP="${2:-}"
22:     case "$FP" in SHA256:*) ;; *) echo "鐢ㄦ硶: $0 pin-hostkey SHA256:<鎸囩汗>"; exit 2 ;; esac
23:     _fpv=${FP#SHA256:}
24:     case "$_fpv" in ''|*[!A-Za-z0-9+/=]*) echo "鎸囩汗瀛楃闆嗕笉鍚堟硶"; exit 2 ;; esac
25:     mkdir -p /root/.ssh && chmod 700 /root/.ssh
26:     mv -f "$KH" "$KH.bak-$(date +%Y%m%d%H%M%S)" 2>/dev/null
27:     # 1) 鎺㈡祴鎸囩汗锛堟棤 -y锛宔cho n 鍥炵瓟 y/n 鎻愮ず浣垮叾鎵撳嵃鎸囩汗鍚庨€€鍑猴級
28:     _out=$(echo n | /usr/bin/ssh -i "$KEY" -p "$PORT" -N -T root@"$VPS" 2>&1 | head -4)
29:     _seen=$(echo "$_out" | grep -o 'SHA256:[A-Za-z0-9+/=]*' | head -1)
30:     [ -n "$_seen" ] || { echo "鏈兘鍙栧緱鏈嶅姟绔寚绾癸細$_out"; exit 2; }
31:     if [ "$_seen" != "$FP" ]; then
32:         mv -f "$KH.bak-"* "$KH" 2>/dev/null
33:         echo "鎸囩汗涓嶄竴鑷达紒鏈嶅姟绔?$_seen 浼犲叆=$FP 鈥斺€?鐤戜技涓棿浜猴紝宸蹭腑姝㈠苟杩樺師鏃ф潯鐩?
34:         exit 3
35:     fi
36:     # 2) TOFU 鍐欏叆锛坉bclient 鑷啓绾富鏈哄悕鏍煎紡锛?    /usr/bin/ssh -y -i "$KEY" -p "$PORT" -N -T root@"$VPS" < /dev/null > /dev/null 2>&1 &
37:     _p=$!; sleep 4; kill $_p 2>/dev/null; wait $_p 2>/dev/null
38:     grep -q "^$VPS " "$KH" 2>/dev/null || { echo "TOFU 鍐欏叆澶辫触"; exit 2; }
39:     chmod 600 "$KH"
40:     # 3) 鏃?-y 澶嶈繛楠岃瘉
