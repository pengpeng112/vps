86: func validateNodeBase(name, host string, port int) error {
87: 	if !clash.ValidateNodeName(name) {
88: 		return fmt.Errorf("节点名不合法（字母数字与 - _，长度 2~32）")
89: 	}
90: 	// Session 1 节点 host 限 IPv4 字面量（§3.2）
91: 	if ip := net.ParseIP(host); ip == nil || ip.To4() == nil {
92: 		return fmt.Errorf("节点 host 必须是 IPv4 字面量（Session 1 限制；域名/IPv6 待解析与直连规则实现）")
93: 	}
94: 	if port < 1 || port > 65535 {
95: 		return fmt.Errorf("端口不合法")
96: 	}
97: 	return nil
98: }
