exec
"C:\\Users\\Administrator\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe" -Command '$files=@('"'scripts/vps-backup.sh','mgmt/agent/setup-mgmt-tunnel.sh','mgmt/agent/init/mgmt-tunnel-v3','mgmt/agent/mgmt-port-discovery.sh','mgmt/agent/tunnel-watchdog.sh','mgmt/deploy/docker-compose.yml','mgmt/deploy/docker-compose.prod.yml'); foreach("'$f in $files){Write-Output ('"'FILE '+"'$f); $n=0; Get-Content -Encoding UTF8 -LiteralPath $f | ForEach-Object {$n++; $s=$_; if ($s -match '"'(?i)(postgres_password|master_key|database_url|DSN=)' -and "'$s -notmatch '"'\\"'$'"\\{|getenv|environment|env_file') {"'$s='"'[敏感配置行略去]'}; Write-Output ('{0}: {1}' -f "'$n,$s)}}; rg -n '"'MGMT_URL|active_port|discovery|curl.*-["'^ ]*k|curl.*insecure'"' mgmt/agent/routermgmt-agent.sh; rg -n 'restore-latest|socat|8443|latest-backup|backup.sh|dump.sql' 'docs/plans/温备部署执行记录-20261001.md'" in F:\vps
