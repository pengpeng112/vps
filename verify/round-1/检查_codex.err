5: #       WG 接口建立后再启动。API/DB 均不发布端口。
6: # 首次生成自签证书（含 IP SAN，仅内网管理面使用）：
7: #   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
8: #     -keyout prod-certs/privkey.pem -out prod-certs/fullchain.pem -days 825 \
9: #     -subj "/CN=10.10.0.1" -addext "subjectAltName=IP:10.10.0.1"
10: services:
