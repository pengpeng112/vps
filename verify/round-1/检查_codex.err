100: func (s *Server) handleNodeList(c *gin.Context) {
101: 	page, size, offset := pageArgs(c)
102: 	var total int64
103: 	s.DB.Model(&models.Node{}).Count(&total)
104: 	var ns []models.Node
105: 	s.DB.Order("priority DESC, id").Offset(offset).Limit(size).Find(&ns)
106: 	items := make([]gin.H, 0, len(ns))
107: 	for i := range ns {
108: 		var bound int64
109: 		s.DB.Model(&models.NodeAssignment{}).Where("node_id=?", ns[i].ID).Count(&bound)
110: 		dto := s.nodeToDTO(&ns[i])
111: 		dto["bound_devices"] = bound
112: 		items = append(items, dto)
113: 	}
114: 	c.JSON(http.StatusOK, pageResp(items, total, page, size))
115: }
