44:     const r = await api.post(path, { ticket: ticket.value, code: code.value })
45:     setToken(r.token)
46:     message.success('鐧诲綍鎴愬姛')
47:     router.push('/')
48:   } catch (e: any) {
49:     message.error(e.message)
50:   } finally {
51:     loading.value = false
52:   }
53: }
54: </script>
55: 
56: <template>
57:   <div style="display: flex; align-items: center; justify-content: center; height: 100vh; background: #101014">
58:     <n-card title="璺敱鍣ㄧ鐞嗗彴 路 鐧诲綍" style="width: 400px" embedded>
59:       <n-space vertical size="large">
60:         <template v-if="stage === 'pwd'">
61:           <!-- 2026-10-02锛歛utocomplete + form submit锛堟祻瑙堝櫒淇濆瓨瀵嗙爜鎻愮ず锛涗笌 R3 LuCI 鍚屾柟妗堬級 -->
62:           <n-form @submit.prevent="login" @keyup.enter="login">
63:             <n-form-item label="鐢ㄦ埛鍚?>
64:               <n-input v-model:value="username" :input-props="{ autocomplete: 'username', name: 'username' }" placeholder="绠＄悊鍛樼敤鎴峰悕" />
65:             </n-form-item>
66:             <n-form-item label="瀵嗙爜">
