FILE scripts/vps-backup.sh
1: #!/bin/bash
2: # 管理台每日备份 v2（2026-09-23）：v1 基础上补齐 DR 全量件
3: # 新增：sing-box 配置(全队列代理出口，丢了=所有路由器代理断)、root/jump 的
4: #       authorized_keys(路由器隧道+Claude跳板的入口)、sshd 配置、ufw 规则、
5: #       /opt/mgmt 全量源码(排除 backups)。
6: # 恢复步骤见《docs/服务器访问通道总览-20260923.md》DR 章节。
7: # VPS 落位：/opt/mgmt/backup.sh；cron: 30 3 * * *
8: set -u
9: DIR=/opt/mgmt/backups
10: TS=$(date +%Y%m%d-%H%M)
11: LOG=$DIR/backup.log
12: mkdir -p "$DIR"
13: ok()   { echo "$(date "+%F %T") ok  mgmt-backup-$TS.tar.gz $1" >> "$LOG"; }
14: fail() { echo "$(date "+%F %T") FAIL ($2)" >> "$LOG"; exit 1; }
15: 
16: STAGE=$(mktemp -d) || fail "" stage
17: trap "rm -rf $STAGE" EXIT
18: 
19: # --- v1 原有：数据库 + 部署密钥 ---
20: docker exec routermgmt-db-1 pg_dump -U postgres routermgmt > "$STAGE/db.sql" 2>>"$LOG" || fail "" pg_dump
21: cp -a /opt/mgmt/deploy/.env "$STAGE/" 2>>"$LOG" || fail "" env
22: cp -a /opt/mgmt/deploy/prod-certs "$STAGE/" 2>/dev/null
23: cp -a /opt/mgmt/deploy/pkg-athena.json "$STAGE/" 2>/dev/null
24: cp -a /opt/mgmt/deploy/docker-compose.yml /opt/mgmt/deploy/docker-compose.prod.yml "$STAGE/" 2>/dev/null
25: cp -a /etc/wireguard/wg0.conf "$STAGE/" 2>/dev/null
26: 
27: # --- v2 新增 ---
28: mkdir -p "$STAGE/singbox" "$STAGE/ssh" "$STAGE/ufw"
29: cp -a /usr/local/etc/sing-box/config.json "$STAGE/singbox/" 2>>"$LOG" || fail "" singbox-config
30: cp -a /etc/systemd/system/sing-box.service "$STAGE/singbox/" 2>/dev/null
31: cp -a /root/.ssh/authorized_keys "$STAGE/ssh/root.authorized_keys" 2>/dev/null
32: cp -a /home/jump/.ssh/authorized_keys "$STAGE/ssh/jump.authorized_keys" 2>/dev/null
33: cp -a /etc/ssh/sshd_config "$STAGE/ssh/" 2>/dev/null
34: cp -a /etc/ssh/sshd_config.d "$STAGE/ssh/" 2>/dev/null
35: tar -czf "$STAGE/ufw/etc-ufw.tar.gz" -C /etc ufw 2>/dev/null
36: tar -czf "$STAGE/mgmt-src.tar.gz" -C /opt --exclude='mgmt/backups' mgmt 2>>"$LOG" || fail "" mgmt-src
37: 
38: # --- v3 新增：腾讯第二节点配置（VPS 拉取；节点不可达时告警不中断主备份） ---
39: mkdir -p "$STAGE/tx-node"
40: scp -i /root/.ssh/id_ed25519_txbackup -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=10 ubuntu@43.134.46.44:.tx-singbox-config "$STAGE/tx-node/singbox-config.json" 2>>"$LOG" || echo "$(date '+%F %T') WARN tx-node-config pull failed" >> "$LOG"
41: 
42: tar -czf "$DIR/mgmt-backup-$TS.tar.gz" -C "$STAGE" . || fail "" tar
43: chmod 600 "$DIR/mgmt-backup-$TS.tar.gz"
44: # 保留最近 14 份
45: ls -1t "$DIR"/mgmt-backup-*.tar.gz 2>/dev/null | tail -n +15 | xargs -r rm -f
46: ok "$(du -h "$DIR/mgmt-backup-$TS.tar.gz" | cut -f1)"
FILE mgmt/agent/setup-mgmt-tunnel.sh
1: #!/bin/sh
2: # 公司网/拦截 UDP 51820 的现场：用 SSH TCP 把管理心跳绕过去（家宽发货设备走 WG，不跑这个）。
3: # 2026-09-24 阶段1重构：生成 /etc/routermgmt/tunnel.conf（init 按白名单解析，
4: # 管理 -L 与排障 -R 拆双实例）；pin-hostkey 先核对指纹再用 dbclient 自写格式固化。
5: # 用法（路由器上）：
6: #   sh /usr/sbin/setup-mgmt-tunnel.sh [enable] [rssh端口] [rssh目标host:port]
7: #   sh /usr/sbin/setup-mgmt-tunnel.sh pin-hostkey SHA256:<指纹>   # 指纹经可信链路采集、人工核对后传入
8: # 可用环境变量覆盖默认值：
9: #   TUNNEL_VPS_HOST / TUNNEL_VPS_PORT / TUNNEL_LOCAL_PORT / TUNNEL_MGMT_TARGET
10: #   TUNNEL_RSSH_PORT / TUNNEL_RSSH_TARGET（排障 -R：VPS 回环端口与路由器 SSH 目标）
11: # 实测注意（2026-09-24，dropbear 2025.89/2020.81）：
12: #   - dbclient 的 known_hosts 固定读 /root/.ssh/known_hosts，不受 $HOME 影响
13: #   - 条目是纯主机名格式（不带 [host]:port），必须由 dbclient -y 自己写入才可靠
14: set -u
15: KEY=/etc/routermgmt/id_dropbear_mgmt
16: VPS=${TUNNEL_VPS_HOST:-159.223.36.119}
17: PORT=${TUNNEL_VPS_PORT:-28722}
18: LOCAL=${TUNNEL_LOCAL_PORT:-18443}
19: HUB=${TUNNEL_MGMT_TARGET:-10.10.0.1:8443}
20: KH=/root/.ssh/known_hosts
21: 
22: mode="${1:-setup}"
23: mkdir -p /etc/routermgmt
24: 
25: # ---- pin-hostkey SHA256:<指纹> ----
26: # 流程：无 -y 探测一次拿到服务端指纹（stdin EOF 自动退出）→ 与传入指纹比对 →
27: #       一致才清空重写（rm + 单次 -y 连接让 dbclient 自存）→ 无 -y 复连验证。
28: if [ "$mode" = "pin-hostkey" ]; then
29:     FP="${2:-}"
30:     case "$FP" in SHA256:*) ;; *) echo "用法: $0 pin-hostkey SHA256:<指纹>"; exit 2 ;; esac
31:     _fpv=${FP#SHA256:}
32:     case "$_fpv" in ''|*[!A-Za-z0-9+/=]*) echo "指纹字符集不合法"; exit 2 ;; esac
33:     mkdir -p /root/.ssh && chmod 700 /root/.ssh
34:     mv -f "$KH" "$KH.bak-$(date +%Y%m%d%H%M%S)" 2>/dev/null
35:     # 1) 探测指纹（无 -y，echo n 回答 y/n 提示使其打印指纹后退出）
36:     _out=$(echo n | /usr/bin/ssh -i "$KEY" -p "$PORT" -N -T root@"$VPS" 2>&1 | head -4)
37:     _seen=$(echo "$_out" | grep -o 'SHA256:[A-Za-z0-9+/=]*' | head -1)
38:     [ -n "$_seen" ] || { echo "未能取得服务端指纹：$_out"; exit 2; }
39:     if [ "$_seen" != "$FP" ]; then
40:         mv -f "$KH.bak-"* "$KH" 2>/dev/null
41:         echo "指纹不一致！服务端=$_seen 传入=$FP —— 疑似中间人，已中止并还原旧条目"
42:         exit 3
43:     fi
44:     # 2) TOFU 写入（dbclient 自写纯主机名格式）
45:     /usr/bin/ssh -y -i "$KEY" -p "$PORT" -N -T root@"$VPS" < /dev/null > /dev/null 2>&1 &
46:     _p=$!; sleep 4; kill $_p 2>/dev/null; wait $_p 2>/dev/null
47:     grep -q "^$VPS " "$KH" 2>/dev/null || { echo "TOFU 写入失败"; exit 2; }
48:     chmod 600 "$KH"
49:     # 3) 无 -y 复连验证
50:     /usr/bin/ssh -i "$KEY" -p "$PORT" -N -T root@"$VPS" < /dev/null > /dev/null 2>&1 &
51:     _p=$!; sleep 4; kill -0 $_p 2>/dev/null && _ok=1 || _ok=0; kill $_p 2>/dev/null; wait $_p 2>/dev/null
52:     [ "$_ok" = "1" ] || { echo "pin 后无 -y 验证失败"; exit 2; }
53:     echo "已固化 VPS host key（指纹 $_seen，无 -y 复连验证通过）。变更指纹将导致隧道拒连（fail-closed）"
54:     exit 0
55: fi
56: 
57: if [ ! -f "$KEY" ]; then
58:     # SN-R1 等老 dropbear 只能生成 RSA；先生成 ed25519 失败再退 RSA
59:     dropbearkey -t ed25519 -f "$KEY" >/dev/null 2>&1 || dropbearkey -t rsa -s 2048 -f "$KEY" >/dev/null
60:     chmod 600 "$KEY"
61: fi
62: PUB=$(dropbearkey -y -f "$KEY" | grep -E '^ssh-(ed25519|rsa) ')
63: 
64: # 排障 -R 参数（enable 模式也可从位置参数取）
65: RSSH_PORT="${TUNNEL_RSSH_PORT:-${2:-}}"
66: RSSH_TARGET="${TUNNEL_RSSH_TARGET:-${3:-}}"
67: 
68: # 写 tunnel.conf（600，仅白名单键；init 逐行解析）
69: cat > /etc/routermgmt/tunnel.conf <<EOF
70: # mgmt-tunnel 配置（严格 key=value 白名单，未知键忽略；改动后 /etc/init.d/mgmt-tunnel restart）
71: VPS_HOST=$VPS
72: VPS_SSH_PORT=$PORT
73: MGMT_LOCAL_PORT=$LOCAL
74: MGMT_TARGET=$HUB
75: EOF
76: if [ -n "$RSSH_PORT" ] && [ -n "$RSSH_TARGET" ]; then
77:     printf 'RSSH_REMOTE_PORT=%s\nRSSH_TARGET=%s\n' "$RSSH_PORT" "$RSSH_TARGET" >> /etc/routermgmt/tunnel.conf
78: fi
79: chmod 600 /etc/routermgmt/tunnel.conf
80: 
81: echo "== tunnel.conf 已写入（RSSH: ${RSSH_PORT:-未配置} -> ${RSSH_TARGET:-} ）=="
82: if [ -n "$RSSH_PORT" ]; then
83:     echo "把下面这一行追加到 VPS /root/.ssh/authorized_keys ："
84:     echo "no-agent-forwarding,no-X11-forwarding,no-pty,permitopen=\"$HUB\",permitlisten=\"127.0.0.1:$RSSH_PORT\" $PUB rtr-mgmt-tunnel"
85: else
86:     echo "把下面这一行追加到 VPS /root/.ssh/authorized_keys ："
87:     echo "no-agent-forwarding,no-X11-forwarding,no-pty,permitopen=\"$HUB\" $PUB rtr-mgmt-tunnel"
88: fi
89: echo
90: echo "VPS sshd 需允许 root 转发（99-hardening.conf Match User root AllowTcpForwarding yes）"
91: echo "建议固化主机钥（指纹经可信链路采集人工核对后）："
92: echo "  sh /usr/sbin/setup-mgmt-tunnel.sh pin-hostkey SHA256:<指纹>"
93: echo "  （VPS 侧采集：ssh-keyscan -p $PORT $VPS 2>/dev/null | ssh-keygen -lf - 对应 ed25519 行）"
94: 
95: [ "$mode" = "enable" ] || exit 0
96: 
97: if [ ! -x /etc/init.d/mgmt-tunnel ]; then
98:     echo "缺少 /etc/init.d/mgmt-tunnel"
99:     exit 1
100: fi
101: /etc/init.d/mgmt-tunnel enable
102: /etc/init.d/mgmt-tunnel restart
103: sleep 3
104: code=$(curl -sk -m 5 -o /dev/null -w '%{http_code}' "https://127.0.0.1:$LOCAL/api/v1/health" || echo 000)
105: if [ "$code" != "200" ]; then
106:     echo "隧道健康检查失败 http=$code，未改 Agent URL"
107:     exit 2
108: fi
109: sed -i "s|^MGMT_URL=.*|MGMT_URL=https://127.0.0.1:$LOCAL|" /etc/routermgmt/agent.conf
110: /etc/init.d/routermgmt restart
111: echo "已启用 TCP 管理通道 MGMT_URL=https://127.0.0.1:$LOCAL （WG 仍保留，不接管上网）"
112: exit 0
FILE mgmt/agent/init/mgmt-tunnel-v3
1: #!/bin/sh /etc/rc.common
2: # mgmt-tunnel v3 — 四端点并行管理隧道（2026-10-02 管理面迁 DMIT 主台改造）
3: # v3 变化：新增 VPS4 第四端点（本地口 = MGMT_LOCAL_PORT+3）；主端点语义不变
4: #
5: # 改造目标：路由器同时与 DO/TX/BWG 三台 VPS 建立 SSH 隧道（并行，非主备切换）。
6: #   - 主端点（DO）：-L 管理 API + -R 反向排障口（原有功能不变）
7: #   - 备用端点 2-4（TX/BWG/DO 或其他）：仅 -L 管理 API
8: #   - 任一路径可达即可管理路由器；agent 按 18443→18444→18445→18446 顺序自动选路
9: #
10: # tunnel.conf 格式（v2 向后兼容 v1）：
11: #   # 主端点（必须，有 -R）
12: #   VPS_HOST=159.223.36.119
13: #   VPS_PORT=28722
14: #   MGMT_LOCAL_PORT=18443
15: #   MGMT_TARGET=10.10.0.1:8443
16: #   RSSH_REMOTE_PORT=13224
17: #   RSSH_TARGET=192.168.132.1:22
18: #   # 备用端点（可选，仅 -L，端口自动分配 18444/18445）
19: #   VPS2_HOST=43.134.46.44
20: #   VPS2_PORT=28722
21: #   VPS3_HOST=74.82.203.175
22: #   VPS3_PORT=28722
23: #   VPS4_HOST=<第四端点>
24: #   VPS4_PORT=28722
25: #
26: # 安全设计：
27: #   - 所有端点最终都连到 DO 的 sshd（socat 只是 TCP 直通管，不解密不落地）
28: #   - SSH 加密端到端（路由器↔DO sshd），中继站只能看到加密流量
29: #   - 密钥/认证/PermitOpen 均在 DO 侧，与单路完全相同
30: #   - 备用端点首次连接用 -y 接受 DO 的主机密钥（socat 直通所以密钥相同）
31: #
32: # shellcheck disable=SC2034
33: USE_PROCD=1
34: START=98
35: STOP=12
36: 
37: CONF=/etc/routermgmt/tunnel.conf
38: KEY=/etc/routermgmt/id_dropbear_mgmt
39: KH=/root/.ssh/known_hosts
40: 
41: # 降级默认（无 tunnel.conf 时仅保心跳通道）
42: DEF_VPS=159.223.36.119
43: DEF_PORT=28722
44: DEF_LOCAL=18443
45: DEF_HUB=10.10.0.1:8443
46: 
47: _valid_host() { case "$1" in ''|*[!A-Za-z0-9.\-]*) return 1 ;; esac; return 0; }
48: _valid_port() {
49:     case "$1" in ''|*[!0-9]*) return 1 ;; esac
50:     [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
51: }
52: _valid_target() {
53:     case "$1" in *:*) ;; *) return 1 ;; esac
54:     _h=${1%:*}; _p=${1##*:}
55:     _valid_host "$_h" && _valid_port "$_p"
56: }
57: 
58: load_tunnel_conf() {
59:     [ -f "$CONF" ] || return 1
60:     # 清空所有变量（含 v2 扩展）
61:     unset TC_VPS_HOST TC_VPS_PORT TC_MGMT_LOCAL_PORT TC_MGMT_TARGET \
62:           TC_RSSH_REMOTE_PORT TC_RSSH_TARGET \
63:           TC_VPS2_HOST TC_VPS2_PORT TC_VPS3_HOST TC_VPS3_PORT \
64:           TC_VPS4_HOST TC_VPS4_PORT
65:     while IFS='=' read -r _k _v; do
66:         case "$_k" in
67:             ''|\#*) continue ;;
68:             VPS_HOST)         _valid_host "$_v"   && TC_VPS_HOST="$_v" ;;
69:             VPS_PORT)         _valid_port "$_v"   && TC_VPS_PORT="$_v" ;;
70:             MGMT_LOCAL_PORT)  _valid_port "$_v"   && TC_MGMT_LOCAL_PORT="$_v" ;;
71:             MGMT_TARGET)      _valid_target "$_v" && TC_MGMT_TARGET="$_v" ;;
72:             RSSH_REMOTE_PORT) _valid_port "$_v"   && TC_RSSH_REMOTE_PORT="$_v" ;;
73:             RSSH_TARGET)      _valid_target "$_v" && TC_RSSH_TARGET="$_v" ;;
74:             # v2: 备用端点
75:             VPS2_HOST)        _valid_host "$_v"   && TC_VPS2_HOST="$_v" ;;
76:             VPS2_PORT)        _valid_port "$_v"   && TC_VPS2_PORT="$_v" || TC_VPS2_PORT=28722 ;;
77:             VPS3_HOST)        _valid_host "$_v"   && TC_VPS3_HOST="$_v" ;;
78:             VPS3_PORT)        _valid_port "$_v"   && TC_VPS3_PORT="$_v" || TC_VPS3_PORT=28722 ;;
79:             # v3: 第四端点
80:             VPS4_HOST)        _valid_host "$_v"   && TC_VPS4_HOST="$_v" ;;
81:             VPS4_PORT)        _valid_port "$_v"   && TC_VPS4_PORT="$_v" || TC_VPS4_PORT=28722 ;;
82:         esac
83:     done < "$CONF"
84:     [ -n "$TC_VPS_HOST" ] && [ -n "$TC_VPS_PORT" ] && \
85:     [ -n "$TC_MGMT_LOCAL_PORT" ] && [ -n "$TC_MGMT_TARGET" ]
86: }
87: 
88: _open_instance() {
89:     _inst="$1"; _vps="$2"; _port="$3"; _fwd="$4"
90:     _y="-y"
91:     if [ -f "$KH" ] && grep -q "^$_vps " "$KH" 2>/dev/null; then
92:         _y=""
93:     else
94:         logger -t mgmt-tunnel "WARN: $KH 无 ${_vps} 条目，使用 -y 接受（备用端点直通 DO，密钥相同）"
95:     fi
96:     procd_open_instance "$_inst"
97:     # ExitOnForwardFailure: -R 端口被占时 ssh 必须退出（10-01 R3 实锤：静默苟活进程
98:     # 让 procd 以为健康、端口释放后无人再申请转发=永久半开），配合 retry=0 无限重生必自愈
99:     procd_set_param command /usr/bin/ssh -i "$KEY" -p "$_port" -N -K 30 -T -o ExitOnForwardFailure=yes $_y $_fwd "root@$_vps"
100:     # retry=0 无限重试：2026-10-01 实锤 5 次上限会在服务端故障期耗尽后永不自愈
101:     # （R3 TX/BWG 路径服务端修复后仍死）；退避仍防风暴，慢失败最终必回
102:     procd_set_param respawn 3600 0 0
103:     procd_set_param stdout 1
104:     procd_set_param stderr 1
105:     procd_close_instance
106: }
107: 
108: start_service() {
109:     if ! load_tunnel_conf; then
110:         logger -t mgmt-tunnel "WARN: $CONF 缺失或核心字段无效，降级为仅管理通道(-L)默认配置"
111:         _open_instance mgmt "$DEF_VPS" "$DEF_PORT" \
112:             "-L 127.0.0.1:$DEF_LOCAL:$DEF_HUB"
113:         return
114:     fi
115: 
116:     # === 主端点（DO 直连，-L + -R）===
117:     _open_instance mgmt "$TC_VPS_HOST" "$TC_VPS_PORT" \
118:         "-L 127.0.0.1:$TC_MGMT_LOCAL_PORT:$TC_MGMT_TARGET"
119:     if [ -n "$TC_RSSH_REMOTE_PORT" ] && [ -n "$TC_RSSH_TARGET" ]; then
120:         _open_instance rssh "$TC_VPS_HOST" "$TC_VPS_PORT" \
121:             "-R 127.0.0.1:$TC_RSSH_REMOTE_PORT:$TC_RSSH_TARGET"
122:     else
123:         logger -t mgmt-tunnel "WARN: RSSH 未配置，排障通道未启动"
124:     fi
125: 
126:     # === 备用端点 2（TX socat 中继，仅 -L，本地端口 18444）===
127:     if [ -n "$TC_VPS2_HOST" ]; then
128:         _p2=$((TC_MGMT_LOCAL_PORT + 1))
129:         _open_instance mgmt2 "$TC_VPS2_HOST" "$TC_VPS2_PORT" \
130:             "-L 127.0.0.1:$_p2:$TC_MGMT_TARGET"
131:         logger -t mgmt-tunnel "INFO: 备用隧道2 已启动 → $TC_VPS2_HOST:$TC_VPS2_PORT (本地 :$_p2)"
132:     fi
133: 
134:     # === 备用端点 3（BWG socat 中继，仅 -L，本地端口 18445）===
135:     if [ -n "$TC_VPS3_HOST" ]; then
136:         _p3=$((TC_MGMT_LOCAL_PORT + 2))
137:         _open_instance mgmt3 "$TC_VPS3_HOST" "$TC_VPS3_PORT" \
138:             "-L 127.0.0.1:$_p3:$TC_MGMT_TARGET"
139:         logger -t mgmt-tunnel "INFO: 备用隧道3 已启动 → $TC_VPS3_HOST:$TC_VPS3_PORT (本地 :$_p3)"
140:     fi
141: 
142:     # === 备用端点 4（v3，仅 -L，本地端口 MGMT_LOCAL_PORT+3）===
143:     if [ -n "$TC_VPS4_HOST" ]; then
144:         _p4=$((TC_MGMT_LOCAL_PORT + 3))
145:         _open_instance mgmt4 "$TC_VPS4_HOST" "$TC_VPS4_PORT"             "-L 127.0.0.1:$_p4:$TC_MGMT_TARGET"
146:         logger -t mgmt-tunnel "INFO: 备用隧道4 已启动 → $TC_VPS4_HOST:$TC_VPS4_PORT (本地 :$_p4)"
147:     fi
148: 
149:     # 日志：活动实例数
150:     _cnt=1
151:     [ -n "$TC_RSSH_REMOTE_PORT" ] && _cnt=$((_cnt + 1))
152:     [ -n "$TC_VPS2_HOST" ] && _cnt=$((_cnt + 1))
153:     [ -n "$TC_VPS3_HOST" ] && _cnt=$((_cnt + 1))
154:     [ -n "$TC_VPS4_HOST" ] && _cnt=$((_cnt + 1))
155:     logger -t mgmt-tunnel "INFO: mgmt-tunnel v3 已启动，共 $_cnt 个实例"
156: }
FILE mgmt/agent/mgmt-port-discovery.sh
1: #!/bin/sh
2: # mgmt-port-discovery.sh — agent 多端口自动选路补丁（2026-10-01 三方冗余）
3: #
4: # 用途：mgmt-tunnel v2 部署后，主/备隧道分别在 18443/18444/18445 监听。
5: #       此脚本探测哪个端口活着，写入 /tmp/mgmt_active_port 供 agent 读取。
6: #       agent 脚本在 API 调用前 source 此文件即可自动选路。
7: #
8: # 部署：/etc/routermgmt/mgmt-port-discovery.sh，由 agent 启动时和 cron 每分钟调用。
9: # 输出：设置 MGMT_ACTIVE_PORT 和 MGMT_URL 环境变量（source 用法），
10: #       或写 /tmp/mgmt_active_port 文件（agent 读取用法）。
11: 
12: # 尝试顺序：18443 → 18444 → 18445 → 18446（v3 四端点，2026-10-02）
13: # 超时 2 秒/端口（本地回环，不需要长超时）
14: _discover() {
15:     for _port in 18443 18444 18445 18446; do
16:         if curl -sk -m 2 -o /dev/null \
17:            "https://127.0.0.1:${_port}/api/v1/health" 2>/dev/null; then
18:             echo "$_port"
19:             return 0
20:         fi
21:     done
22:     return 1
23: }
24: 
25: # 主入口
26: ACTIVE=$(_discover)
27: if [ -n "$ACTIVE" ]; then
28:     # 写文件供 agent 读取
29:     echo "$ACTIVE" > /tmp/mgmt_active_port
30:     # 直接输出（source 用法）
31:     MGMT_ACTIVE_PORT="$ACTIVE"
32:     MGMT_URL="https://127.0.0.1:${ACTIVE}"
33:     export MGMT_ACTIVE_PORT MGMT_URL
34: else
35:     # 全部不通：清除缓存，agent 会报心跳失败
36:     rm -f /tmp/mgmt_active_port 2>/dev/null
37:     logger -t mgmt-port "WARN: 三端口均不可达（18443-18446）"
38:     return 1 2>/dev/null || exit 1
39: fi
FILE mgmt/agent/tunnel-watchdog.sh
1: #!/bin/sh
2: # tunnel-watchdog.sh — 管理隧道本地自愈（2026-09-30）
3: # 动机：dropbear 2020.81 检测不出死连接（半开黑洞要 ~15 分钟 TCP 超时才退出），
4: #       国际链路抖动/NAT 回收让空闲的隧道实例反复假死。本脚本每分钟由 cron 调起：
5: #       本地经隧道探测管理台健康，失败即重启 mgmt-tunnel（两个实例一起重启）。
6: #       与 VPS 侧探针互补：VPS 探针修「-R 半开但心跳活着」，本脚本修「心跳通道也死了」。
7: LOG=/etc/routermgmt/logs/tunnelwd.log
8: mkdir -p /etc/routermgmt/logs
9: if curl -sk -m 6 -o /dev/null https://127.0.0.1:18443/api/v1/health 2>/dev/null; then
10:     exit 0
11: fi
12: sleep 3
13: if curl -sk -m 6 -o /dev/null https://127.0.0.1:18443/api/v1/health 2>/dev/null; then
14:     exit 0  # 二次确认，防瞬时抖动误杀
15: fi
16: echo "$(date '+%F %T') health failed x2, restarting mgmt-tunnel" >> "$LOG"
17: [ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt 500 ] && tail -n 400 "$LOG" > "$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"
18: logger -t tunnel-wd "mgmt tunnel health failed, restarted"
19: /etc/init.d/mgmt-tunnel restart >/dev/null 2>&1
20: exit 0
