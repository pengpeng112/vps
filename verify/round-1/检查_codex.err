56: func (s *Server) nodeToDTO(n *models.Node) gin.H {
57: 	params := s.decryptNodeParams(n)
58: 	return gin.H{
59: 		"id": n.ID, "name": n.Name, "host": n.Host, "port": n.Port, "proto": n.Proto,
60: 		"params": gin.H{
61: 			"uuid":     crypto.MaskNodeParam("uuid", params.UUID),
62: 			"pbk":      crypto.MaskNodeParam("pbk", params.PBK),
63: 			"sid":      crypto.MaskNodeParam("sid", params.SID),
64: 			"sni":      params.SNI, "flow": params.Flow, "fp": params.FP,
65: 			"password": crypto.MaskNodeParam("password", params.Password),
66: 		},
67: 		"priority": n.Priority, "enabled": n.Enabled,
68: 		"health_status": n.HealthStatus, "last_check_at": n.LastCheckAt, "last_latency_ms": n.LastLatencyMs,
69: 		"created_at": n.CreatedAt,
70: 	}
71: }
72: 
73: func (s *Server) decryptNodeParams(n *models.Node) nodeParams {
74: 	var p nodeParams
75: 	if n.ProtoParamsEnc == "" {
76: 		return p
77: 	}
78: 	raw, err := crypto.Decrypt(s.MasterKey, n.ProtoParamsEnc, fmt.Sprintf("nodes:%d:proto_params", n.ID))
79: 	if err != nil {
80: 		return p
81: 	}
82: 	json.Unmarshal(raw, &p)
83: 	return p
84: }
