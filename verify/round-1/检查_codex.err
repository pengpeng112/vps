71:             -H "X-Device-Id: $DEVICE_ID" -H "X-Timestamp: $_ts" -H "X-Nonce: $_nonce" \
72:             -H "Authorization: HMAC-SHA256 $_sig" \
73:             "$MGMT_URL$_rpath" 2>/dev/null
74:     else
75:         curl $CURL_OPTS -X "$_method" -o "$_out" -w '%{http_code}' \
