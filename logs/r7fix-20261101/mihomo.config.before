  - name: "GIA-HY2-US-01"
    type: hysteria2
    server: 154.36.139.155
    port: 34568
    password: 9e82c9cd0bf9001a49ac8f697298186c
    udp: true
    skip-cert-verify: true
  - name: "BWG-VLESS-JPTY-01"
    type: vless
    server: 74.82.193.113
    port: 443
    uuid: 97ff051d-878b-4b86-a862-8ab4e4287212
    network: tcp
    udp: true
    tls: true
    flow: xtls-rprx-vision
    servername: www.microsoft.com
    client-fingerprint: chrome
    reality-opts:
      public-key: 3LERrU-fx3dsrtuA2suzuRu-3vLeXxdPf2ngXH-pam4
      short-id: 7f5f01569c5fbb91
  - name: "CF-CDN-GIA-01"
    type: vless
    server: 104.18.32.7
    port: 2053
    uuid: 38ca542a-eb36-4c45-adb4-d8493b0ea011
    network: ws
    udp: false
    tls: true
    servername: cf.k3x9m2.top
