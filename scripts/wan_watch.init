#!/bin/sh /etc/rc.common
# WAN 探活守护：每 60s 写一条分层快照到 /etc/routermgmt/logs/wan-watch.log
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/wan-watch.sh loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
