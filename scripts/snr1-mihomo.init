#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=15

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/mihomo -d /etc/mihomo -f /etc/mihomo/config.yaml
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    (
        i=0
        while [ "$i" -lt 45 ]; do
            wget -T 2 -q -O /dev/null http://127.0.0.1:9090/version 2>/dev/null && break
            sleep 1
            i=$((i + 1))
        done
        /etc/mihomo-ipt.sh
    ) &
}

stop_service() {
    /etc/mihomo-ipt.sh stop
}

reload_service() {
    stop
    start
}
