# 复制为 .env 后填写；全部必填项无默认弱密码（§13）。禁止把真实 .env 提交版本控制。
# 生成随机密钥（PowerShell）：
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# 生成随机密钥（POSIX）：openssl rand -hex 32

APP_ENV=dev

# 数据库（db-init.sql 会用 MIGRATE_PASSWORD/APP_DB_PASSWORD 创建账号；两个密码不要相同）
POSTGRES_PASSWORD=please-change-postgres-superuser-password
MIGRATE_PASSWORD=please-change-migrate-password
APP_DB_PASSWORD=please-change-app-password

# 管理台（首次启动创建管理员；之后修改无效，仅 bootstrap 用）
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_PASSWORD=please-change-at-least-12-chars

# 密钥：JWT_SECRET 任意 >=32 字节随机串；MASTER_KEY 必须 64 个 hex 字符（32 字节）
JWT_SECRET=please-fill-64-hex-chars-or-long-random-string
MASTER_KEY=please-fill-exactly-64-hex-chars-0123456789abcdef

# 地址与外部配置
MGMT_PUBLIC_URL=https://10.10.0.1:8443
# Session 1 留空 = transport_mode=mock（无真 WG）；Session 2 填 Hub 公钥/endpoint
WG_HUB_PUBLIC_KEY=
WG_HUB_ENDPOINT=

# 告警与流量阈值（默认 80 GB/设备/月，十进制 GB）
ALERT_WEBHOOK_URL=
TRAFFIC_ALERT_GB=80

# VPS 本机探测器（mgmt-rssh-probe）→ /api/v1/internal/* 共享密钥；openssl rand -hex 32
INTERNAL_TOKEN=please-fill-64-hex-chars
