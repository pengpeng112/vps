#!/bin/sh /etc/rc.common
# routermgmt agent procd service (repo ships no init script; deployed alongside install-agent.sh)
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/routermgmt-agent
    procd_set_param env RM_CURL_OPTS="-sS -m 10 -k"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
